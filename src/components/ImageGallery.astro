---
const {
  images = [],
  caption = "",
} = Astro.props;
---

<figure class="gallery-block">
  <div class="gallery">
    {images.map((image) => (
      <img src={image.src} alt={image.alt || ""} loading="lazy" />
    ))}
  </div>

  {caption && (
    <figcaption>{caption}</figcaption>
  )}
</figure>

<style>
  .gallery-block {
    margin: 48px 0;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 18px;
    border: 1px solid var(--card-border);
  }

  figcaption {
    margin-top: 12px;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    text-align: center;
  }
</style>