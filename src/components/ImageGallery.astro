---
const {
  images = [],
  caption = "",
} = Astro.props;

const credits = images.filter((image) => image.credit);
---

<figure class="gallery-block">
  <div class="gallery">
    {images.map((image) => (
      <img src={image.src} alt={image.alt || ""} loading="lazy" />
    ))}
  </div>

  {(caption || credits.length > 0) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credits.length > 0 && (
        <span class="credits">
          Images: {credits.map((image, index) => (
            <>
              {index > 0 && " · "}
              {image.creditUrl ? (
                <a href={image.creditUrl} target="_blank" rel="noopener noreferrer">{image.credit}</a>
              ) : (
                image.credit
              )}
            </>
          ))}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  .gallery-block {
    margin: 48px 0;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    border: 1px solid var(--card-border);
  }

  figcaption {
    display: grid;
    gap: 4px;
    margin-top: 12px;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    text-align: center;
  }

  .credits {
    font-size: 0.82rem;
  }

  .credits a {
    color: inherit;
    text-underline-offset: 3px;
  }
</style>
