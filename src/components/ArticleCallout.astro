---
const {
  type = "note",
  title = "Note",
} = Astro.props;

const labels = {
  note: "Note",
  idea: "Idea",
  warning: "Warning",
  question: "Question",
  quote: "Quote",
};

const displayTitle = title || labels[type] || "Note";
---

<aside class:list={["callout", type]}>
  <p class="label">{displayTitle}</p>
  <div class="content">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 40px 0;
    padding: 24px;
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--card-border);
  }

  .callout.idea {
    border-color: var(--accent-soft);
  }

  .callout.warning {
    border-color: rgba(251, 191, 36, 0.55);
  }

  .callout.question {
    border-color: rgba(167, 139, 250, 0.55);
  }

  .callout.quote {
    border-color: rgba(255, 255, 255, 0.22);
  }

  .label {
    margin: 0 0 12px;
    color: var(--accent);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .content {
    color: var(--text-muted);
    line-height: 1.7;
  }

  .content :global(p) {
    margin: 0;
  }

  .content :global(p + p) {
    margin-top: 1rem;
  }
</style>