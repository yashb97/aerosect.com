---
const {
  title = "Chart title",
  description = "",
  data = [],
  caption = "",
  valueSuffix = "",
} = Astro.props;

const maxValue = Math.max(...data.map((item) => item.value), 1);
---

<figure class="chart-block">
  <div class="chart-header">
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </div>

  <div class="bars">
    {data.map((item) => {
      const width = `${(item.value / maxValue) * 100}%`;

      return (
        <div class="bar-row">
          <div class="bar-meta">
            <span>{item.label}</span>
            <strong>{item.value}{valueSuffix}</strong>
          </div>

          <div class="bar-track">
            <div class="bar-fill" style={`width: ${width}`}></div>
          </div>
        </div>
      );
    })}
  </div>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart-block {
    margin: 48px 0;
    padding: 28px;
    border-radius: 8px;
    background: var(--card);
    border: 1px solid var(--card-border);
  }

  .chart-header h3 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--text);
  }

  .chart-header p {
    margin: 10px 0 0;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .bars {
    display: grid;
    gap: 20px;
    margin-top: 28px;
  }

  .bar-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .bar-meta strong {
    color: var(--accent);
  }

  .bar-track {
    height: 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), #38bdf8);
  }

  figcaption {
    margin-top: 18px;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    text-align: center;
  }
</style>
