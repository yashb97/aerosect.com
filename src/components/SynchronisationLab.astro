<section class="sync-lab" data-sync-lab>
  <div class="canvas-wrap">
    <canvas
      class="sync-canvas"
      data-sync-canvas
      aria-label="Interactive Kuramoto oscillator synchronisation visualisation"
    ></canvas>

    <div class="canvas-label">
      Drag through the swarm to disturb phases
    </div>

    <div class="coherence-badge" aria-live="polite">
      <span>Coherence</span>
      <strong data-r-badge>r = 0.00</strong>
    </div>
  </div>

  <div class="controls">
    <div class="section-title">Kuramoto population</div>

    <label class="control-row">
      <span>Coupling strength</span>
      <output data-coupling-output>0.00</output>

      <input
        data-coupling
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0"
      />
    </label>

    <label class="control-row">
      <span>Frequency spread σω</span>
      <output data-spread-output>0.55 rad/s</output>

      <input
        data-spread
        type="range"
        min="0.10"
        max="1.20"
        step="0.05"
        value="0.55"
      />
    </label>

    <label class="control-row">
      <span>Simulation speed</span>
      <output data-timescale-output>1.0×</output>

      <input
        data-timescale
        type="range"
        min="0.25"
        max="2.5"
        step="0.05"
        value="1"
      />
    </label>

    <div class="derived-values">
      <div>
        <span>Order parameter r</span>
        <strong data-r-output>—</strong>
      </div>

      <div>
        <span>Mean phase ψ</span>
        <strong data-psi-output>—</strong>
      </div>

      <div>
        <span>Effective coupling K</span>
        <strong data-k-output>—</strong>
      </div>

      <div>
        <span>Predicted threshold Kc</span>
        <strong data-kc-output>—</strong>
      </div>
    </div>

    <div class="preset-section">
      <div class="section-title">Explore the transition</div>

      <div class="preset-grid">
        <button data-preset="independent" type="button">Independent</button>
        <button data-preset="near" type="button">Near threshold</button>
        <button data-preset="strong" type="button">Strong coupling</button>
        <button data-kick type="button">Disturb all phases</button>
      </div>
    </div>

    <div class="visual-section">
      <div class="section-title">Visual layers</div>

      <div class="toggle-grid">
        <label class="toggle">
          <input data-phase-hands-toggle type="checkbox" />
          <span>Phase hands</span>
        </label>

        <label class="toggle">
          <input data-mean-field-toggle type="checkbox" checked />
          <span>Mean field</span>
        </label>

        <label class="toggle">
          <input data-phase-colour-toggle type="checkbox" />
          <span>Phase colour</span>
        </label>
      </div>
    </div>

    <div class="history-section">
      <div class="history-heading">
        <div>
          <div class="section-title">Collective coherence</div>
          <div class="history-subtitle">
            Kuramoto order parameter through time
          </div>
        </div>

        <div class="history-legend">
          <span class="r-dot"></span>
          r(t)
        </div>
      </div>

      <canvas
        class="history-canvas"
        data-history-canvas
        aria-label="History of the Kuramoto order parameter"
      ></canvas>
    </div>

    <details class="model-details">
      <summary>Model assumptions and equations</summary>

      <div class="model-content">
        <p>
          Each oscillator has a phase θᵢ and its own natural angular frequency ωᵢ.
          Every oscillator feels the same mean field generated by the full population.
        </p>

        <div class="equation">
          dθᵢ/dt = ωᵢ + K r sin(ψ − θᵢ)
        </div>

        <p>
          The collective state is compressed into the complex Kuramoto order
          parameter. Its magnitude r measures phase coherence: r ≈ 0 is an
          incoherent population, while r → 1 means the phases are nearly aligned.
        </p>

        <div class="equation">
          r e^(iψ) = (1/N) Σⱼ e^(iθⱼ)
        </div>

        <p>
          Natural frequencies are sampled from a zero-mean Gaussian distribution
          with standard deviation σω. For an ideal infinite population with a
          Gaussian frequency distribution, the onset of collective synchronisation
          is approximately:
        </p>

        <div class="equation">
          Kc = 2 / [π g(0)] = 2√(2π) σω / π
        </div>

        <ul>
          <li>N = 300 globally coupled oscillators</li>
          <li>First-order phase dynamics</li>
          <li>Static natural frequencies</li>
          <li>No explicit delay or network topology</li>
          <li>No stochastic forcing after initialisation</li>
          <li>Finite-N fluctuations remain visible even below Kc</li>
        </ul>

        <p class="model-note">
          The uncoupled state is best described as incoherent rather than
          mathematically chaotic. The visual “flashing” is a phase marker: each
          oscillator brightens whenever θᵢ passes through zero.
        </p>
      </div>
    </details>

    <div class="bottom-row">
      <div class="model-info">
        <strong>Model:</strong>
        globally coupled Kuramoto oscillators
      </div>

      <div class="buttons">
        <button data-pause type="button">Pause</button>
        <button data-randomise type="button">Randomise phases</button>
        <button data-reset type="button">Reset</button>
      </div>
    </div>
  </div>
</section>

<script>
  type OscillatorPoint = {
    x: number;
    y: number;
    radius: number;
  };

  const labs =
    document.querySelectorAll<HTMLElement>(
      "[data-sync-lab]"
    );

  for (const root of labs) {
    // ==================================================
    // DOM
    // ==================================================

    const canvas =
      root.querySelector<HTMLCanvasElement>(
        "[data-sync-canvas]"
      );

    const historyCanvas =
      root.querySelector<HTMLCanvasElement>(
        "[data-history-canvas]"
      );

    const couplingSlider =
      root.querySelector<HTMLInputElement>(
        "[data-coupling]"
      );

    const spreadSlider =
      root.querySelector<HTMLInputElement>(
        "[data-spread]"
      );

    const timescaleSlider =
      root.querySelector<HTMLInputElement>(
        "[data-timescale]"
      );

    const couplingOutput =
      root.querySelector<HTMLOutputElement>(
        "[data-coupling-output]"
      );

    const spreadOutput =
      root.querySelector<HTMLOutputElement>(
        "[data-spread-output]"
      );

    const timescaleOutput =
      root.querySelector<HTMLOutputElement>(
        "[data-timescale-output]"
      );

    const rOutput =
      root.querySelector<HTMLElement>(
        "[data-r-output]"
      );

    const psiOutput =
      root.querySelector<HTMLElement>(
        "[data-psi-output]"
      );

    const kOutput =
      root.querySelector<HTMLElement>(
        "[data-k-output]"
      );

    const kcOutput =
      root.querySelector<HTMLElement>(
        "[data-kc-output]"
      );

    const rBadge =
      root.querySelector<HTMLElement>(
        "[data-r-badge]"
      );

    const phaseHandsToggle =
      root.querySelector<HTMLInputElement>(
        "[data-phase-hands-toggle]"
      );

    const meanFieldToggle =
      root.querySelector<HTMLInputElement>(
        "[data-mean-field-toggle]"
      );

    const phaseColourToggle =
      root.querySelector<HTMLInputElement>(
        "[data-phase-colour-toggle]"
      );

    const pauseButton =
      root.querySelector<HTMLButtonElement>(
        "[data-pause]"
      );

    const randomiseButton =
      root.querySelector<HTMLButtonElement>(
        "[data-randomise]"
      );

    const resetButton =
      root.querySelector<HTMLButtonElement>(
        "[data-reset]"
      );

    const kickButton =
      root.querySelector<HTMLButtonElement>(
        "[data-kick]"
      );

    const presetButtons =
      root.querySelectorAll<HTMLButtonElement>(
        "[data-preset]"
      );

    if (
      !canvas ||
      !historyCanvas ||
      !couplingSlider ||
      !spreadSlider ||
      !timescaleSlider ||
      !couplingOutput ||
      !spreadOutput ||
      !timescaleOutput ||
      !rOutput ||
      !psiOutput ||
      !kOutput ||
      !kcOutput ||
      !rBadge ||
      !phaseHandsToggle ||
      !meanFieldToggle ||
      !phaseColourToggle ||
      !pauseButton ||
      !randomiseButton ||
      !resetButton ||
      !kickButton
    ) {
      continue;
    }

    const ctx =
      canvas.getContext("2d");

    const historyCtx =
      historyCanvas.getContext("2d");

    if (!ctx || !historyCtx) {
      continue;
    }

    // ==================================================
    // MODEL CONSTANTS / STATE
    // ==================================================

    const oscillatorCount = 300;
    const maxCoupling = 2.5;
    const twoPi = 2 * Math.PI;

    const phases =
      new Float64Array(
        oscillatorCount
      );

    const frequencySeeds =
      new Float64Array(
        oscillatorCount
      );

    const naturalFrequencies =
      new Float64Array(
        oscillatorCount
      );

    const phaseRates =
      new Float64Array(
        oscillatorCount
      );

    const points:
      OscillatorPoint[] =
      [];

    let couplingControl = 0;
    let frequencySpread = 0.55;
    let timeScale = 1;

    let orderParameter = 0;
    let meanPhase = 0;

    let running = true;
    let showPhaseHands = false;
    let showMeanField = true;
    let showPhaseColour = false;

    let previousTime =
      performance.now();

    let simulationTime = 0;
    let historyAccumulator = 0;

    const history:
      number[] =
      [];

    const maxHistoryPoints = 360;

    let pointerDown = false;
    let lastDisturbX = -9999;
    let lastDisturbY = -9999;

    // ==================================================
    // RANDOM HELPERS
    // ==================================================

    function gaussianRandom() {
      let u = 0;
      let v = 0;

      while (u === 0) {
        u = Math.random();
      }

      while (v === 0) {
        v = Math.random();
      }

      return (
        Math.sqrt(
          -2 *
          Math.log(u)
        ) *
        Math.cos(
          twoPi * v
        )
      );
    }

    function wrapAngle(
      angle: number
    ) {
      let wrapped =
        angle % twoPi;

      if (wrapped < 0) {
        wrapped += twoPi;
      }

      return wrapped;
    }

    function signedAngle(
      angle: number
    ) {
      return Math.atan2(
        Math.sin(angle),
        Math.cos(angle)
      );
    }

    // ==================================================
    // POPULATION INITIALISATION
    // ==================================================

    function applyFrequencySpread() {
      for (
        let i = 0;
        i < oscillatorCount;
        i++
      ) {
        naturalFrequencies[i] =
          frequencySeeds[i] *
          frequencySpread;
      }
    }

    function buildNaturalFrequencies() {
      let mean = 0;

      for (
        let i = 0;
        i < oscillatorCount;
        i++
      ) {
        frequencySeeds[i] =
          gaussianRandom();

        mean +=
          frequencySeeds[i];
      }

      mean /= oscillatorCount;

      let variance = 0;

      for (
        let i = 0;
        i < oscillatorCount;
        i++
      ) {
        frequencySeeds[i] -=
          mean;

        variance +=
          frequencySeeds[i] *
          frequencySeeds[i];
      }

      const sampleSpread =
        Math.sqrt(
          variance /
          oscillatorCount
        ) || 1;

      for (
        let i = 0;
        i < oscillatorCount;
        i++
      ) {
        frequencySeeds[i] /=
          sampleSpread;
      }

      applyFrequencySpread();
    }

    function randomisePhases() {
      for (
        let i = 0;
        i < oscillatorCount;
        i++
      ) {
        phases[i] =
          Math.random() *
          twoPi;
      }

      history.length = 0;
      historyAccumulator = 0;
      simulationTime = 0;

      computeMeanField();
      pushHistoryPoint();
    }

    // ==================================================
    // STATIC OSCILLATOR LAYOUT
    // ==================================================

    function rebuildPoints() {
      points.length = 0;

      const width =
        canvas.clientWidth;

      const height =
        canvas.clientHeight;

      if (
        width <= 0 ||
        height <= 0
      ) {
        return;
      }

      const edgeX = 34;
      const edgeY = 40;

      const usableWidth =
        Math.max(
          1,
          width -
          2 * edgeX
        );

      const usableHeight =
        Math.max(
          1,
          height -
          2 * edgeY
        );

      const aspect =
        usableWidth /
        usableHeight;

      const columns =
        Math.ceil(
          Math.sqrt(
            oscillatorCount *
            aspect
          )
        );

      const rows =
        Math.ceil(
          oscillatorCount /
          columns
        );

      const cellWidth =
        usableWidth /
        columns;

      const cellHeight =
        usableHeight /
        rows;

      for (
        let i = 0;
        i < oscillatorCount;
        i++
      ) {
        const col =
          i % columns;

        const row =
          Math.floor(
            i / columns
          );

        const jitterSeedA =
          Math.sin(
            (i + 1) *
            91.713
          ) *
          43758.5453;

        const jitterSeedB =
          Math.sin(
            (i + 1) *
            47.291
          ) *
          24634.6345;

        const jitterA =
          jitterSeedA -
          Math.floor(jitterSeedA);

        const jitterB =
          jitterSeedB -
          Math.floor(jitterSeedB);

        const x =
          edgeX +
          (col + 0.5) *
          cellWidth +
          (jitterA - 0.5) *
          cellWidth *
          0.52;

        const y =
          edgeY +
          (row + 0.5) *
          cellHeight +
          (jitterB - 0.5) *
          cellHeight *
          0.52;

        const radius =
          Math.max(
            2.8,
            Math.min(
              5.2,
              Math.min(
                cellWidth,
                cellHeight
              ) *
              0.22
            )
          );

        points.push({
          x,
          y,
          radius
        });
      }
    }

    // ==================================================
    // KURAMOTO MEAN FIELD
    // ==================================================

    function computeMeanField() {
      let sumCos = 0;
      let sumSin = 0;

      for (
        let i = 0;
        i < oscillatorCount;
        i++
      ) {
        sumCos +=
          Math.cos(
            phases[i]
          );

        sumSin +=
          Math.sin(
            phases[i]
          );
      }

      const meanCos =
        sumCos /
        oscillatorCount;

      const meanSin =
        sumSin /
        oscillatorCount;

      orderParameter =
        Math.hypot(
          meanCos,
          meanSin
        );

      meanPhase =
        Math.atan2(
          meanSin,
          meanCos
        );
    }

    function effectiveCoupling() {
      return (
        couplingControl *
        maxCoupling
      );
    }

    function predictedCriticalCoupling() {
      return (
        2 *
        Math.sqrt(
          2 * Math.PI
        ) *
        frequencySpread /
        Math.PI
      );
    }

    // ==================================================
    // TIME INTEGRATION
    // ==================================================

    function updateModel(
      dt: number
    ) {
      const scaledDt =
        dt *
        timeScale;

      const maxStep = 0.012;

      const substeps =
        Math.max(
          1,
          Math.ceil(
            scaledDt /
            maxStep
          )
        );

      const subDt =
        scaledDt /
        substeps;

      const K =
        effectiveCoupling();

      for (
        let step = 0;
        step < substeps;
        step++
      ) {
        computeMeanField();

        for (
          let i = 0;
          i < oscillatorCount;
          i++
        ) {
          phaseRates[i] =
            naturalFrequencies[i] +
            K *
            orderParameter *
            Math.sin(
              meanPhase -
              phases[i]
            );
        }

        for (
          let i = 0;
          i < oscillatorCount;
          i++
        ) {
          phases[i] =
            wrapAngle(
              phases[i] +
              phaseRates[i] *
              subDt
            );
        }

        simulationTime +=
          subDt;

        historyAccumulator +=
          subDt;

        if (
          historyAccumulator >=
          0.08
        ) {
          historyAccumulator -=
            0.08;

          computeMeanField();
          pushHistoryPoint();
        }
      }

      computeMeanField();
    }

    // ==================================================
    // HISTORY
    // ==================================================

    function pushHistoryPoint() {
      history.push(
        orderParameter
      );

      if (
        history.length >
        maxHistoryPoints
      ) {
        history.shift();
      }
    }

    // ==================================================
    // LOCAL DISTURBANCE INTERACTION
    // ==================================================

    function disturbAt(
      x: number,
      y: number,
      strength = 1
    ) {
      const radius =
        Math.max(
          46,
          Math.min(
            78,
            canvas.clientWidth *
            0.085
          )
        );

      const radiusSquared =
        radius * radius;

      for (
        let i = 0;
        i < points.length;
        i++
      ) {
        const dx =
          points[i].x - x;

        const dy =
          points[i].y - y;

        const distanceSquared =
          dx * dx +
          dy * dy;

        if (
          distanceSquared <=
          radiusSquared
        ) {
          const falloff =
            1 -
            Math.sqrt(
              distanceSquared
            ) /
            radius;

          const randomPhase =
            Math.random() *
            twoPi;

          const blend =
            Math.min(
              1,
              strength *
              (0.35 +
              0.65 * falloff)
            );

          const delta =
            signedAngle(
              randomPhase -
              phases[i]
            );

          phases[i] =
            wrapAngle(
              phases[i] +
              delta * blend
            );
        }
      }

      computeMeanField();
    }

    function disturbAll() {
      for (
        let i = 0;
        i < oscillatorCount;
        i++
      ) {
        const randomPhase =
          Math.random() *
          twoPi;

        const delta =
          signedAngle(
            randomPhase -
            phases[i]
          );

        phases[i] =
          wrapAngle(
            phases[i] +
            0.62 * delta
          );
      }

      computeMeanField();
    }

    // ==================================================
    // MAIN CANVAS DRAWING
    // ==================================================

    function drawBackground() {
      const width =
        canvas.clientWidth;

      const height =
        canvas.clientHeight;

      const gradient =
        ctx.createLinearGradient(
          0,
          0,
          0,
          height
        );

      gradient.addColorStop(
        0,
        "#091018"
      );

      gradient.addColorStop(
        1,
        "#06090d"
      );

      ctx.fillStyle =
        gradient;

      ctx.fillRect(
        0,
        0,
        width,
        height
      );

      ctx.strokeStyle =
        "rgba(255,255,255,0.026)";

      ctx.lineWidth = 1;

      const spacing = 48;

      for (
        let x = 0;
        x <= width;
        x += spacing
      ) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }

      for (
        let y = 0;
        y <= height;
        y += spacing
      ) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }

      const radial =
        ctx.createRadialGradient(
          width * 0.5,
          height * 0.45,
          20,
          width * 0.5,
          height * 0.45,
          Math.max(
            width,
            height
          ) *
          0.7
        );

      radial.addColorStop(
        0,
        "rgba(75,145,190,0.055)"
      );

      radial.addColorStop(
        1,
        "rgba(0,0,0,0)"
      );

      ctx.fillStyle = radial;
      ctx.fillRect(
        0,
        0,
        width,
        height
      );
    }

    function pulseIntensity(
      phase: number
    ) {
      const distance =
        signedAngle(
          phase
        );

      const pulseWidth = 0.34;

      return Math.exp(
        -0.5 *
        distance *
        distance /
        (
          pulseWidth *
          pulseWidth
        )
      );
    }

    function oscillatorColour(
      phase: number,
      pulse: number
    ) {
      if (showPhaseColour) {
        const hue =
          195 +
          78 *
          (
            wrapAngle(phase) /
            twoPi
          );

        const lightness =
          50 +
          24 * pulse;

        return `hsla(${hue.toFixed(1)}, 78%, ${lightness.toFixed(1)}%, ${(
          0.55 +
          0.42 * pulse
        ).toFixed(3)})`;
      }

      const red =
        Math.round(
          95 +
          150 * pulse
        );

      const green =
        Math.round(
          174 +
          72 * pulse
        );

      const blue =
        Math.round(
          218 +
          37 * pulse
        );

      const alpha =
        0.35 +
        0.62 * pulse;

      return `rgba(${red},${green},${blue},${alpha.toFixed(3)})`;
    }

    function drawOscillators() {
      for (
        let i = 0;
        i < points.length;
        i++
      ) {
        const point =
          points[i];

        const phase =
          phases[i];

        const pulse =
          pulseIntensity(
            phase
          );

        const radius =
          point.radius *
          (
            0.84 +
            0.46 * pulse
          );

        if (pulse > 0.08) {
          const glowRadius =
            radius *
            (
              2.5 +
              3.8 * pulse
            );

          const glow =
            ctx.createRadialGradient(
              point.x,
              point.y,
              0,
              point.x,
              point.y,
              glowRadius
            );

          glow.addColorStop(
            0,
            `rgba(137,226,251,${(
              0.22 * pulse
            ).toFixed(3)})`
          );

          glow.addColorStop(
            1,
            "rgba(137,226,251,0)"
          );

          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(
            point.x,
            point.y,
            glowRadius,
            0,
            twoPi
          );
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(
          point.x,
          point.y,
          radius,
          0,
          twoPi
        );

        ctx.fillStyle =
          oscillatorColour(
            phase,
            pulse
          );

        ctx.fill();

        ctx.strokeStyle =
          `rgba(225,243,252,${(
            0.12 +
            0.36 * pulse
          ).toFixed(3)})`;

        ctx.lineWidth = 0.8;
        ctx.stroke();

        if (showPhaseHands) {
          const handLength =
            point.radius * 1.75;

          ctx.beginPath();
          ctx.moveTo(
            point.x,
            point.y
          );

          ctx.lineTo(
            point.x +
            Math.cos(phase) *
            handLength,
            point.y -
            Math.sin(phase) *
            handLength
          );

          ctx.strokeStyle =
            "rgba(238,247,252,0.48)";

          ctx.lineWidth = 0.8;
          ctx.stroke();
        }
      }
    }

    function drawMeanField() {
      if (!showMeanField) {
        return;
      }

      const x = 52;
      const y = 53;
      const radius = 22;

      ctx.save();

      ctx.fillStyle =
        "rgba(3,7,11,0.64)";

      ctx.strokeStyle =
        "rgba(255,255,255,0.11)";

      ctx.lineWidth = 1;

      ctx.beginPath();
      ctx.arc(
        x,
        y,
        radius + 10,
        0,
        twoPi
      );
      ctx.fill();
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(
        x,
        y,
        radius,
        0,
        twoPi
      );

      ctx.strokeStyle =
        "rgba(255,255,255,0.18)";

      ctx.stroke();

      const handLength =
        radius *
        orderParameter;

      const endX =
        x +
        Math.cos(meanPhase) *
        handLength;

      const endY =
        y -
        Math.sin(meanPhase) *
        handLength;

      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(
        endX,
        endY
      );

      ctx.strokeStyle =
        "rgba(126,216,255,0.92)";

      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(
        endX,
        endY,
        2.6,
        0,
        twoPi
      );

      ctx.fillStyle =
        "rgba(200,240,255,0.95)";

      ctx.fill();

      ctx.fillStyle =
        "rgba(255,255,255,0.52)";

      ctx.font =
        "10px system-ui, sans-serif";

      ctx.textAlign =
        "center";

      ctx.fillText(
        "mean field",
        x,
        y +
        radius +
        25
      );

      ctx.restore();
    }

    function drawDisturbanceCursor() {
      if (!pointerDown) {
        return;
      }

      if (
        lastDisturbX < -1000 ||
        lastDisturbY < -1000
      ) {
        return;
      }

      const radius =
        Math.max(
          46,
          Math.min(
            78,
            canvas.clientWidth *
            0.085
          )
        );

      ctx.save();
      ctx.beginPath();
      ctx.arc(
        lastDisturbX,
        lastDisturbY,
        radius,
        0,
        twoPi
      );

      ctx.strokeStyle =
        "rgba(255,255,255,0.16)";

      ctx.lineWidth = 1;
      ctx.setLineDash([4, 5]);
      ctx.stroke();
      ctx.restore();
    }

    function drawMainCanvas() {
      drawBackground();
      drawOscillators();
      drawMeanField();
      drawDisturbanceCursor();
    }

    // ==================================================
    // HISTORY PLOT
    // ==================================================

    function drawHistory() {
      const width =
        historyCanvas.clientWidth;

      const height =
        historyCanvas.clientHeight;

      historyCtx.fillStyle =
        "#090e14";

      historyCtx.fillRect(
        0,
        0,
        width,
        height
      );

      const left = 50;
      const right = 18;
      const top = 18;
      const bottom = 34;

      const plotWidth =
        Math.max(
          1,
          width -
          left -
          right
        );

      const plotHeight =
        Math.max(
          1,
          height -
          top -
          bottom
        );

      historyCtx.strokeStyle =
        "rgba(255,255,255,0.075)";

      historyCtx.lineWidth = 1;

      for (
        let i = 0;
        i <= 4;
        i++
      ) {
        const y =
          top +
          i / 4 *
          plotHeight;

        historyCtx.beginPath();
        historyCtx.moveTo(
          left,
          y
        );
        historyCtx.lineTo(
          left +
          plotWidth,
          y
        );
        historyCtx.stroke();
      }

      for (
        let i = 0;
        i <= 6;
        i++
      ) {
        const x =
          left +
          i / 6 *
          plotWidth;

        historyCtx.beginPath();
        historyCtx.moveTo(
          x,
          top
        );
        historyCtx.lineTo(
          x,
          top +
          plotHeight
        );
        historyCtx.stroke();
      }

      historyCtx.fillStyle =
        "rgba(255,255,255,0.45)";

      historyCtx.font =
        "11px system-ui, sans-serif";

      historyCtx.textAlign =
        "right";

      historyCtx.textBaseline =
        "middle";

      historyCtx.fillText(
        "1.0",
        left - 8,
        top
      );

      historyCtx.fillText(
        "0.5",
        left - 8,
        top +
        0.5 * plotHeight
      );

      historyCtx.fillText(
        "0.0",
        left - 8,
        top +
        plotHeight
      );

      historyCtx.save();
      historyCtx.translate(
        14,
        top +
        0.5 * plotHeight
      );
      historyCtx.rotate(
        -Math.PI / 2
      );
      historyCtx.textAlign =
        "center";
      historyCtx.fillText(
        "coherence r",
        0,
        0
      );
      historyCtx.restore();

      historyCtx.textAlign =
        "center";
      historyCtx.textBaseline =
        "alphabetic";
      historyCtx.fillText(
        "recent simulation time →",
        left +
        0.5 * plotWidth,
        height - 8
      );

      if (
        history.length < 2
      ) {
        return;
      }

      historyCtx.beginPath();

      for (
        let i = 0;
        i < history.length;
        i++
      ) {
        const x =
          left +
          i /
          Math.max(
            1,
            maxHistoryPoints - 1
          ) *
          plotWidth;

        const y =
          top +
          (
            1 -
            history[i]
          ) *
          plotHeight;

        if (i === 0) {
          historyCtx.moveTo(
            x,
            y
          );
        } else {
          historyCtx.lineTo(
            x,
            y
          );
        }
      }

      historyCtx.strokeStyle =
        "#67cfff";

      historyCtx.lineWidth = 1.8;
      historyCtx.stroke();

      const last =
        history[
          history.length - 1
        ];

      const lastX =
        left +
        (
          history.length - 1
        ) /
        Math.max(
          1,
          maxHistoryPoints - 1
        ) *
        plotWidth;

      const lastY =
        top +
        (1 - last) *
        plotHeight;

      historyCtx.beginPath();
      historyCtx.arc(
        lastX,
        lastY,
        2.8,
        0,
        twoPi
      );
      historyCtx.fillStyle =
        "#bcecff";
      historyCtx.fill();
    }

    // ==================================================
    // OUTPUTS
    // ==================================================

    function updateOutputs() {
      couplingOutput.value =
        couplingControl.toFixed(2);

      spreadOutput.value =
        `${frequencySpread.toFixed(2)} rad/s`;

      timescaleOutput.value =
        `${timeScale.toFixed(2).replace(/0$/, "")}×`;

      rOutput.textContent =
        orderParameter.toFixed(3);

      rBadge.textContent =
        `r = ${orderParameter.toFixed(2)}`;

      const psiDegrees =
        (
          wrapAngle(
            meanPhase
          ) *
          180 /
          Math.PI
        );

      psiOutput.textContent =
        `${psiDegrees.toFixed(1)}°`;

      kOutput.textContent =
        `${effectiveCoupling().toFixed(3)} rad/s`;

      kcOutput.textContent =
        `${predictedCriticalCoupling().toFixed(3)} rad/s`;

      const thresholdControl =
        Math.min(
          1,
          predictedCriticalCoupling() /
          maxCoupling
        );

      couplingSlider.style.setProperty(
        "--threshold",
        `${(
          thresholdControl * 100
        ).toFixed(1)}%`
      );
    }

    // ==================================================
    // ANIMATION
    // ==================================================

    function animate(
      now: number
    ) {
      const rawDt =
        (
          now -
          previousTime
        ) /
        1000;

      previousTime = now;

      const dt =
        Math.min(
          rawDt,
          0.04
        );

      if (running) {
        updateModel(dt);
      }

      updateOutputs();
      drawMainCanvas();
      drawHistory();

      requestAnimationFrame(
        animate
      );
    }

    // ==================================================
    // CONTROLS
    // ==================================================

    function readControls() {
      couplingControl =
        Number(
          couplingSlider.value
        );

      timeScale =
        Number(
          timescaleSlider.value
        );

      showPhaseHands =
        phaseHandsToggle.checked;

      showMeanField =
        meanFieldToggle.checked;

      showPhaseColour =
        phaseColourToggle.checked;
    }

    function spreadChanged() {
      frequencySpread =
        Number(
          spreadSlider.value
        );

      applyFrequencySpread();
      updateOutputs();
    }

    couplingSlider.addEventListener(
      "input",
      () => {
        couplingControl =
          Number(
            couplingSlider.value
          );

        updateOutputs();
      }
    );

    spreadSlider.addEventListener(
      "input",
      spreadChanged
    );

    timescaleSlider.addEventListener(
      "input",
      () => {
        timeScale =
          Number(
            timescaleSlider.value
          );

        updateOutputs();
      }
    );

    phaseHandsToggle.addEventListener(
      "change",
      () => {
        showPhaseHands =
          phaseHandsToggle.checked;
      }
    );

    meanFieldToggle.addEventListener(
      "change",
      () => {
        showMeanField =
          meanFieldToggle.checked;
      }
    );

    phaseColourToggle.addEventListener(
      "change",
      () => {
        showPhaseColour =
          phaseColourToggle.checked;
      }
    );

    for (
      const button
      of presetButtons
    ) {
      button.addEventListener(
        "click",
        () => {
          const preset =
            button.dataset.preset;

          if (
            preset ===
            "independent"
          ) {
            couplingSlider.value =
              "0";
          }

          if (
            preset ===
            "near"
          ) {
            const threshold =
              predictedCriticalCoupling() /
              maxCoupling;

            couplingSlider.value =
              Math.max(
                0,
                Math.min(
                  1,
                  threshold * 1.03
                )
              ).toFixed(2);
          }

          if (
            preset ===
            "strong"
          ) {
            couplingSlider.value =
              "0.82";
          }

          couplingControl =
            Number(
              couplingSlider.value
            );

          updateOutputs();
        }
      );
    }

    // ==================================================
    // BUTTONS
    // ==================================================

    pauseButton.addEventListener(
      "click",
      () => {
        running = !running;

        pauseButton.textContent =
          running
            ? "Pause"
            : "Play";
      }
    );

    randomiseButton.addEventListener(
      "click",
      () => {
        randomisePhases();
      }
    );

    kickButton.addEventListener(
      "click",
      () => {
        disturbAll();
      }
    );

    resetButton.addEventListener(
      "click",
      () => {
        couplingSlider.value =
          "0";

        spreadSlider.value =
          "0.55";

        timescaleSlider.value =
          "1";

        phaseHandsToggle.checked =
          false;

        meanFieldToggle.checked =
          true;

        phaseColourToggle.checked =
          false;

        couplingControl = 0;
        frequencySpread = 0.55;
        timeScale = 1;
        showPhaseHands = false;
        showMeanField = true;
        showPhaseColour = false;
        running = true;

        pauseButton.textContent =
          "Pause";

        buildNaturalFrequencies();
        randomisePhases();
        updateOutputs();
      }
    );

    // ==================================================
    // POINTER DISTURBANCE
    // ==================================================

    function pointerPosition(
      event: PointerEvent
    ) {
      const rect =
        canvas.getBoundingClientRect();

      return {
        x:
          Math.max(
            0,
            Math.min(
              rect.width,
              event.clientX -
              rect.left
            )
          ),

        y:
          Math.max(
            0,
            Math.min(
              rect.height,
              event.clientY -
              rect.top
            )
          )
      };
    }

    canvas.addEventListener(
      "pointerdown",
      event => {
        pointerDown = true;

        canvas.setPointerCapture(
          event.pointerId
        );

        const point =
          pointerPosition(
            event
          );

        lastDisturbX = point.x;
        lastDisturbY = point.y;

        disturbAt(
          point.x,
          point.y,
          1
        );
      }
    );

    canvas.addEventListener(
      "pointermove",
      event => {
        if (!pointerDown) {
          return;
        }

        const point =
          pointerPosition(
            event
          );

        const dx =
          point.x -
          lastDisturbX;

        const dy =
          point.y -
          lastDisturbY;

        if (
          dx * dx +
          dy * dy <
          64
        ) {
          return;
        }

        lastDisturbX = point.x;
        lastDisturbY = point.y;

        disturbAt(
          point.x,
          point.y,
          0.74
        );
      }
    );

    function endPointer(
      event: PointerEvent
    ) {
      pointerDown = false;

      lastDisturbX = -9999;
      lastDisturbY = -9999;

      if (
        canvas.hasPointerCapture(
          event.pointerId
        )
      ) {
        canvas.releasePointerCapture(
          event.pointerId
        );
      }
    }

    canvas.addEventListener(
      "pointerup",
      endPointer
    );

    canvas.addEventListener(
      "pointercancel",
      endPointer
    );

    // ==================================================
    // RESIZE
    // ==================================================

    function resizeCanvasElement(
      targetCanvas:
        HTMLCanvasElement,
      targetContext:
        CanvasRenderingContext2D
    ) {
      const rect =
        targetCanvas.getBoundingClientRect();

      const dpr =
        Math.min(
          window.devicePixelRatio ||
          1,
          2
        );

      const width =
        Math.max(
          1,
          Math.round(
            rect.width *
            dpr
          )
        );

      const height =
        Math.max(
          1,
          Math.round(
            rect.height *
            dpr
          )
        );

      if (
        targetCanvas.width ===
        width &&
        targetCanvas.height ===
        height
      ) {
        return false;
      }

      targetCanvas.width = width;
      targetCanvas.height = height;

      targetContext.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
      );

      return true;
    }

    function resizeAll() {
      const mainChanged =
        resizeCanvasElement(
          canvas,
          ctx
        );

      resizeCanvasElement(
        historyCanvas,
        historyCtx
      );

      if (mainChanged) {
        rebuildPoints();
      }
    }

    const ResizeObserverCtor =
      (
        window as unknown as {
          ResizeObserver?:
            typeof ResizeObserver;
        }
      ).ResizeObserver;

    if (ResizeObserverCtor) {
      const observer =
        new ResizeObserverCtor(
          resizeAll
        );

      observer.observe(canvas);
      observer.observe(historyCanvas);
    } else {
      window.addEventListener(
        "resize",
        resizeAll
      );
    }

    // ==================================================
    // START
    // ==================================================

    resizeAll();
    readControls();
    buildNaturalFrequencies();
    randomisePhases();
    updateOutputs();

    requestAnimationFrame(
      animate
    );
  }
</script>

