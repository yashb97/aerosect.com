---
const { article } = Astro.props;

const formattedDate = article.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<article class="card">
  <a class="image-link" href={`/articles/${article.id}`} aria-label={article.data.title}>
    <img class="image" src={article.data.image} alt="" />
  </a>

  <div class="meta">
    <a class="topic" href={`/topics/${article.data.topicSlug}`}>
      {article.data.topic}
    </a>
    <p class="date">{formattedDate}</p>
  </div>

  <h2>
    <a href={`/articles/${article.id}`}>{article.data.title}</a>
  </h2>

  <p>{article.data.description}</p>
</article>

<style>
  .card {
    display: block;
    padding: 28px;
    border-radius: 24px;
    background: var(--card);
    border: 1px solid var(--card-border);
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-soft);
    background: rgba(255, 255, 255, 0.08);
  }

  .image-link {
    display: block;
  }

  .image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 18px;
    margin-bottom: 22px;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }

  .topic,
  .date {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
  }

  .topic {
    color: var(--accent);
    text-decoration: none;
  }

  .topic:hover {
    text-decoration: underline;
  }

  .date {
    color: var(--text-soft);
  }

  h2 {
    margin-top: 18px;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  p {
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>