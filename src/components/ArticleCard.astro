---
const { article } = Astro.props;

const formattedDate = article.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<a class="card" href={`/articles/${article.id}`}>
<img class="image" src={article.data.image} alt="" />

  <div class="meta">
    <p class="topic">{article.data.topic}</p>
    <p class="date">{formattedDate}</p>
  </div>

  <h2>{article.data.title}</h2>
  <p>{article.data.description}</p>
</a>

<style>
  .card {
    display: block;
    padding: 28px;
    border-radius: 24px;
    background: var(--card);
    border: 1px solid var(--card-border);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-soft);
    background: rgba(255, 255, 255, 0.08);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }

  .topic,
  .date {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
  }

  .topic {
    color: var(--accent);
  }

  .date {
    color: var(--text-soft);
  }

  h2 {
    margin-top: 18px;
  }

  p {
    color: var(--text-muted);
    line-height: 1.6;
  }

  .image {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 18px;
  margin-bottom: 22px;
}
</style>