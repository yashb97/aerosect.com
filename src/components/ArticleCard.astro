---
import { Image } from "astro:assets";

const { article } = Astro.props;
const topics = article.data.topics;
const isLocalDraft = import.meta.env.DEV && article.data.draft;

const formattedDate = article.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<article class="card">
  <a class="image-link" href={`/articles/${article.id}`} aria-label={article.data.title}>
    <Image
      class="image"
      src={article.data.image}
      alt=""
      loading="lazy"
      decoding="async"
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="(max-width: 900px) calc(100vw - 84px), calc((100vw - 92px) / 2)"
    />
  </a>

  <div class="meta">
    <div class="topics" aria-label="Article topics">
      {topics.map((topic) => (
        <a class="topic" href={`/topics/${topic.slug}`}>
          {topic.name}
        </a>
      ))}
    </div>
    <div class="card-status">
      {isLocalDraft && <span class="draft-label">Draft</span>}
      <p class="date">{formattedDate}</p>
    </div>
  </div>

  <h2>
    <a href={`/articles/${article.id}`}>{article.data.title}</a>
  </h2>

  <p>{article.data.description}</p>
</article>

<style>
  .card {
    display: block;
    padding: 18px;
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.018)),
      var(--card);
    border: 1px solid var(--card-border);
    color: inherit;
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-soft);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
  }

  .image-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 22px;
  }

  .image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    padding: 0 10px;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .card-status {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .topic,
  .date {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
  }

  .topic {
    color: var(--accent);
    text-decoration: none;
  }

  .topic:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .date {
    color: var(--text-soft);
  }

  .draft-label {
    padding: 4px 7px;
    border: 1px solid rgba(125, 211, 252, 0.35);
    border-radius: 4px;
    color: var(--accent);
    background: rgba(125, 211, 252, 0.08);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin: 18px 10px 0;
    font-size: 1.35rem;
    line-height: 1.18;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  p {
    margin: 14px 10px 4px;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
