<section class="morphogenesis-lab" data-morphogenesis-lab>
  <div class="canvas-wrap">
    <canvas
      aria-label="Interactive Gray-Scott reaction-diffusion morphogenesis simulation"
    ></canvas>

    <div class="mode-badge">Gray–Scott morphogenesis</div>

    <div class="canvas-label" data-canvas-label>
      Paint chemical V directly onto the field
    </div>

    <div class="chemical-legend">
      <span>Concentration field</span>
      <div class="legend-ramp" aria-hidden="true"></div>
      <div class="legend-labels">
        <span>U-rich</span>
        <span>Interface</span>
        <span>V-rich</span>
      </div>
    </div>

    <div class="brush-indicator" data-brush-indicator hidden>
      <strong data-brush-name>Inject V</strong>
      <span data-brush-size>14 px brush</span>
    </div>

    <div class="probe-panel" data-probe-panel hidden>
      <div class="probe-title">Local chemistry</div>
      <div class="probe-grid">
        <span>u</span>
        <strong data-probe-u>—</strong>
        <span>v</span>
        <strong data-probe-v>—</strong>
        <span>uv²</span>
        <strong data-probe-reaction>—</strong>
      </div>
    </div>
  </div>

  <div class="controls">
    <div class="preset-panel">
      <div class="preset-copy">
        <strong>Pattern world</strong>
        <span>Small changes in feed and kill rates can reorganise the entire field.</span>
      </div>

      <div class="preset-grid" data-preset-grid>
        <button type="button" data-preset="spots">Spots</button>
        <button type="button" data-preset="stripes">Stripes</button>
        <button type="button" data-preset="mitosis">Mitosis</button>
        <button type="button" data-preset="worms">Worms</button>
        <button type="button" data-preset="coral">Coral</button>
        <button type="button" data-preset="maze">Maze</button>
      </div>
    </div>

    <label class="control-row">
      <span>Feed rate F</span>
      <output data-feed-output>0.0367</output>
      <input
        data-feed
        type="range"
        min="0.0100"
        max="0.0900"
        step="0.0001"
        value="0.0367"
      />
    </label>

    <label class="control-row">
      <span>Kill rate k</span>
      <output data-kill-output>0.0649</output>
      <input
        data-kill
        type="range"
        min="0.0400"
        max="0.0750"
        step="0.0001"
        value="0.0649"
      />
    </label>

    <label class="control-row">
      <span>Diffusion Dᵤ</span>
      <output data-du-output>0.160</output>
      <input
        data-du
        type="range"
        min="0.080"
        max="0.240"
        step="0.002"
        value="0.160"
      />
    </label>

    <label class="control-row">
      <span>Diffusion Dᵥ</span>
      <output data-dv-output>0.080</output>
      <input
        data-dv
        type="range"
        min="0.030"
        max="0.140"
        step="0.002"
        value="0.080"
      />
    </label>

    <label class="control-row">
      <span>Simulation speed</span>
      <output data-speed-output>8 steps/frame</output>
      <input
        data-speed
        type="range"
        min="1"
        max="20"
        step="1"
        value="8"
      />
    </label>

    <label class="control-row">
      <span>Brush radius</span>
      <output data-brush-output>14 px</output>
      <input
        data-brush
        type="range"
        min="3"
        max="42"
        step="1"
        value="14"
      />
    </label>

    <div class="interaction-panel">
      <div class="interaction-copy">
        <strong>Disturb the chemistry</strong>
        <span>Click or drag on the field. The simulation evolves from the state you create.</span>
      </div>

      <div class="brush-buttons" data-brush-buttons>
        <button type="button" data-brush-mode="inject-v" class="active">Inject V</button>
        <button type="button" data-brush-mode="inject-u">Inject U</button>
        <button type="button" data-brush-mode="erase">Restore</button>
      </div>
    </div>

    <div class="derived-values">
      <div>
        <span>Mean v</span>
        <strong data-mean-v>0.000</strong>
      </div>
      <div>
        <span>Peak reaction</span>
        <strong data-peak-reaction>0.000</strong>
      </div>
      <div>
        <span>Elapsed steps</span>
        <strong data-step-count>0</strong>
      </div>
      <div>
        <span>Grid</span>
        <strong data-grid-output>240 × 140</strong>
      </div>
    </div>

    <div class="seed-actions">
      <button class="primary-button" data-seed type="button">
        Add random seeds
      </button>
      <button data-central-seed type="button">
        Central seed
      </button>
      <button data-clear type="button">
        Clear field
      </button>
    </div>

    <div class="visual-controls">
      <div class="visual-title">Visualisation</div>
      <div class="toggle-grid">
        <label class="toggle">
          <input data-smoothing-toggle type="checkbox" checked />
          <span>Smooth display</span>
        </label>
        <label class="toggle">
          <input data-contour-toggle type="checkbox" />
          <span>Reaction contours</span>
        </label>
        <label class="toggle">
          <input data-probe-toggle type="checkbox" checked />
          <span>Chemistry probe</span>
        </label>
        <label class="toggle">
          <input data-auto-seed-toggle type="checkbox" checked />
          <span>Seed on preset change</span>
        </label>
      </div>
    </div>

    <details class="model-details">
      <summary>Model assumptions</summary>
      <div class="model-content">
        <p>
          Two dimensionless chemicals, u and v, diffuse across a two-dimensional surface
          and react locally. Chemical V consumes U autocatalytically through the nonlinear
          term uv², while U is continuously replenished and V is removed.
        </p>

        <div class="equation">
          ∂u/∂t = Dᵤ∇²u − uv² + F(1 − u)
        </div>
        <div class="equation">
          ∂v/∂t = Dᵥ∇²v + uv² − (F + k)v
        </div>

        <p>
          The canvas uses a regular finite-difference grid with a nine-point Laplacian and
          periodic boundaries. Each animation frame advances the same concentration fields
          that you paint into, so user disturbances are part of the dynamics rather than a
          visual overlay.
        </p>

        <ul>
          <li>Dimensionless Gray–Scott reaction–diffusion model</li>
          <li>Explicit time stepping with a fixed numerical timestep</li>
          <li>Nine-point isotropic Laplacian stencil</li>
          <li>Periodic boundary conditions at the canvas edges</li>
          <li>Uniform scalar diffusion coefficients Dᵤ and Dᵥ</li>
          <li>No fluid advection, mechanical growth or three-dimensional geometry</li>
          <li>Preset names describe visual regimes, not unique biological mechanisms</li>
        </ul>

        <p class="model-note">
          Reaction–diffusion systems are widely used as minimal models of spontaneous pattern
          formation. This interactive demonstrates the mathematics of self-organisation; it is
          not a literal simulation of any one organism.
        </p>
      </div>
    </details>

    <div class="bottom-row">
      <div class="model-info">
        <strong>Model:</strong>
        Gray–Scott reaction–diffusion · two coupled scalar fields
      </div>

      <div class="buttons">
        <button data-pause type="button">Pause</button>
        <button data-reset type="button">Reset</button>
      </div>
    </div>
  </div>
</section>

<script>
  const morphogenesisLabs =
    document.querySelectorAll<HTMLElement>(
      "[data-morphogenesis-lab]"
    );

  for (const root of morphogenesisLabs) {
    // ==================================================
    // ELEMENTS
    // ==================================================

    const canvas =
      root.querySelector<HTMLCanvasElement>("canvas");

    const feedSlider =
      root.querySelector<HTMLInputElement>("[data-feed]");

    const killSlider =
      root.querySelector<HTMLInputElement>("[data-kill]");

    const duSlider =
      root.querySelector<HTMLInputElement>("[data-du]");

    const dvSlider =
      root.querySelector<HTMLInputElement>("[data-dv]");

    const speedSlider =
      root.querySelector<HTMLInputElement>("[data-speed]");

    const brushSlider =
      root.querySelector<HTMLInputElement>("[data-brush]");

    const feedOutput =
      root.querySelector<HTMLOutputElement>("[data-feed-output]");

    const killOutput =
      root.querySelector<HTMLOutputElement>("[data-kill-output]");

    const duOutput =
      root.querySelector<HTMLOutputElement>("[data-du-output]");

    const dvOutput =
      root.querySelector<HTMLOutputElement>("[data-dv-output]");

    const speedOutput =
      root.querySelector<HTMLOutputElement>("[data-speed-output]");

    const brushOutput =
      root.querySelector<HTMLOutputElement>("[data-brush-output]");

    const meanVOutput =
      root.querySelector<HTMLElement>("[data-mean-v]");

    const peakReactionOutput =
      root.querySelector<HTMLElement>("[data-peak-reaction]");

    const stepCountOutput =
      root.querySelector<HTMLElement>("[data-step-count]");

    const gridOutput =
      root.querySelector<HTMLElement>("[data-grid-output]");

    const canvasLabel =
      root.querySelector<HTMLElement>("[data-canvas-label]");

    const brushIndicator =
      root.querySelector<HTMLElement>("[data-brush-indicator]");

    const brushName =
      root.querySelector<HTMLElement>("[data-brush-name]");

    const brushSize =
      root.querySelector<HTMLElement>("[data-brush-size]");

    const probePanel =
      root.querySelector<HTMLElement>("[data-probe-panel]");

    const probeUOutput =
      root.querySelector<HTMLElement>("[data-probe-u]");

    const probeVOutput =
      root.querySelector<HTMLElement>("[data-probe-v]");

    const probeReactionOutput =
      root.querySelector<HTMLElement>("[data-probe-reaction]");

    const presetGrid =
      root.querySelector<HTMLElement>("[data-preset-grid]");

    const brushButtons =
      root.querySelector<HTMLElement>("[data-brush-buttons]");

    const seedButton =
      root.querySelector<HTMLButtonElement>("[data-seed]");

    const centralSeedButton =
      root.querySelector<HTMLButtonElement>("[data-central-seed]");

    const clearButton =
      root.querySelector<HTMLButtonElement>("[data-clear]");

    const pauseButton =
      root.querySelector<HTMLButtonElement>("[data-pause]");

    const resetButton =
      root.querySelector<HTMLButtonElement>("[data-reset]");

    const smoothingToggle =
      root.querySelector<HTMLInputElement>("[data-smoothing-toggle]");

    const contourToggle =
      root.querySelector<HTMLInputElement>("[data-contour-toggle]");

    const probeToggle =
      root.querySelector<HTMLInputElement>("[data-probe-toggle]");

    const autoSeedToggle =
      root.querySelector<HTMLInputElement>("[data-auto-seed-toggle]");

    if (
      !canvas ||
      !feedSlider ||
      !killSlider ||
      !duSlider ||
      !dvSlider ||
      !speedSlider ||
      !brushSlider ||
      !feedOutput ||
      !killOutput ||
      !duOutput ||
      !dvOutput ||
      !speedOutput ||
      !brushOutput ||
      !meanVOutput ||
      !peakReactionOutput ||
      !stepCountOutput ||
      !gridOutput ||
      !canvasLabel ||
      !brushIndicator ||
      !brushName ||
      !brushSize ||
      !probePanel ||
      !probeUOutput ||
      !probeVOutput ||
      !probeReactionOutput ||
      !presetGrid ||
      !brushButtons ||
      !seedButton ||
      !centralSeedButton ||
      !clearButton ||
      !pauseButton ||
      !resetButton ||
      !smoothingToggle ||
      !contourToggle ||
      !probeToggle ||
      !autoSeedToggle
    ) {
      continue;
    }

    const ctx = canvas.getContext("2d");

    if (!ctx) {
      continue;
    }

    // ==================================================
    // MODEL / RENDER CONSTANTS
    // ==================================================

    const gridWidth = 240;
    const gridHeight = 140;
    const cellCount = gridWidth * gridHeight;
    const simulationDt = 1.0;

    const fieldCanvas = document.createElement("canvas");
    fieldCanvas.width = gridWidth;
    fieldCanvas.height = gridHeight;

    const fieldCtx = fieldCanvas.getContext("2d");

    if (!fieldCtx) {
      continue;
    }

    const fieldImage = fieldCtx.createImageData(
      gridWidth,
      gridHeight
    );

    let u = new Float32Array(cellCount);
    let v = new Float32Array(cellCount);
    let nextU = new Float32Array(cellCount);
    let nextV = new Float32Array(cellCount);

    let feed = 0.0367;
    let kill = 0.0649;
    let diffusionU = 0.160;
    let diffusionV = 0.080;
    let iterationsPerFrame = 8;
    let brushRadius = 14;

    let running = true;
    let elapsedSteps = 0;
    let selectedPreset = "mitosis";
    type BrushMode = "inject-v" | "inject-u" | "erase";
    let brushMode: BrushMode = "inject-v";

    let showSmoothing = true;
    let showContours = false;
    let showProbe = true;
    let autoSeedPreset = true;

    let isPainting = false;
    let pointerInside = false;
    let pointerGridX = 0;
    let pointerGridY = 0;

    let displayedMeanV = 0;
    let displayedPeakReaction = 0;
    let statisticsFrame = 0;

    // ==================================================
    // PRESETS
    // ==================================================

    const presets: Record<
      string,
      {
        feed: number;
        kill: number;
        seed: "centre" | "random" | "line" | "ring";
      }
    > = {
      spots: {
        feed: 0.0350,
        kill: 0.0650,
        seed: "random"
      },
      stripes: {
        feed: 0.0220,
        kill: 0.0510,
        seed: "line"
      },
      mitosis: {
        feed: 0.0367,
        kill: 0.0649,
        seed: "centre"
      },
      worms: {
        feed: 0.0780,
        kill: 0.0610,
        seed: "random"
      },
      coral: {
        feed: 0.0545,
        kill: 0.0620,
        seed: "ring"
      },
      maze: {
        feed: 0.0290,
        kill: 0.0570,
        seed: "random"
      }
    };

    const brushLabels: Record<BrushMode, string> = {
      "inject-v": "Inject V",
      "inject-u": "Inject U",
      erase: "Restore"
    };

    // ==================================================
    // FIELD INITIALISATION
    // ==================================================

    function clearField() {
      u.fill(1);
      v.fill(0);
      nextU.fill(1);
      nextV.fill(0);
      elapsedSteps = 0;
    }

    function indexAt(x: number, y: number) {
      return y * gridWidth + x;
    }

    function paintDisc(
      centreX: number,
      centreY: number,
      radius: number,
      mode: BrushMode,
      strength = 1
    ) {
      const radiusSquared = radius * radius;
      const minX = Math.floor(centreX - radius);
      const maxX = Math.ceil(centreX + radius);
      const minY = Math.floor(centreY - radius);
      const maxY = Math.ceil(centreY + radius);

      for (let rawY = minY; rawY <= maxY; rawY++) {
        let y = rawY % gridHeight;
        if (y < 0) y += gridHeight;

        for (let rawX = minX; rawX <= maxX; rawX++) {
          let x = rawX % gridWidth;
          if (x < 0) x += gridWidth;

          const dx = rawX - centreX;
          const dy = rawY - centreY;
          const distanceSquared = dx * dx + dy * dy;

          if (distanceSquared > radiusSquared) {
            continue;
          }

          const distance = Math.sqrt(distanceSquared);
          const feather =
            Math.max(0, 1 - distance / Math.max(1, radius));

          const amount =
            Math.min(1, feather * 1.6) * strength;

          const index = indexAt(x, y);

          if (mode === "inject-v") {
            v[index] = Math.min(
              1,
              v[index] + 0.82 * amount
            );
            u[index] = Math.max(
              0,
              u[index] - 0.48 * amount
            );
          } else if (mode === "inject-u") {
            u[index] = Math.min(
              1,
              u[index] + 0.84 * amount
            );
            v[index] = Math.max(
              0,
              v[index] - 0.22 * amount
            );
          } else {
            u[index] += (1 - u[index]) * amount;
            v[index] *= 1 - amount;
          }
        }
      }
    }

    function addCentralSeed() {
      const cx = gridWidth * 0.5;
      const cy = gridHeight * 0.5;

      paintDisc(cx, cy, 8, "inject-v", 1);
      paintDisc(cx - 15, cy + 7, 4, "inject-v", 0.7);
      paintDisc(cx + 13, cy - 8, 5, "inject-v", 0.65);
    }

    function addRandomSeeds(count = 15) {
      for (let i = 0; i < count; i++) {
        const x =
          gridWidth * (0.08 + 0.84 * Math.random());
        const y =
          gridHeight * (0.08 + 0.84 * Math.random());
        const radius = 3 + Math.random() * 6;

        paintDisc(
          x,
          y,
          radius,
          "inject-v",
          0.65 + Math.random() * 0.35
        );
      }
    }

    function addLineSeed() {
      const centreY = gridHeight * 0.5;

      for (let x = 28; x < gridWidth - 28; x += 5) {
        const wave =
          9 * Math.sin(x * 0.095) +
          4 * Math.sin(x * 0.23);

        paintDisc(
          x,
          centreY + wave,
          3.5,
          "inject-v",
          0.82
        );
      }
    }

    function addRingSeed() {
      const cx = gridWidth * 0.5;
      const cy = gridHeight * 0.5;
      const radius = 25;

      for (let angle = 0; angle < Math.PI * 2; angle += 0.16) {
        paintDisc(
          cx + Math.cos(angle) * radius,
          cy + Math.sin(angle) * radius,
          3.4,
          "inject-v",
          0.86
        );
      }

      paintDisc(cx, cy, 5, "inject-v", 0.75);
    }

    function seedForPreset(
      seed: "centre" | "random" | "line" | "ring"
    ) {
      if (seed === "centre") {
        addCentralSeed();
      } else if (seed === "random") {
        addRandomSeeds(18);
      } else if (seed === "line") {
        addLineSeed();
      } else {
        addRingSeed();
      }
    }

    // ==================================================
    // SOLVER
    // ==================================================

    function stepSimulation() {
      for (let y = 0; y < gridHeight; y++) {
        const yN = y === 0 ? gridHeight - 1 : y - 1;
        const yS = y === gridHeight - 1 ? 0 : y + 1;

        const row = y * gridWidth;
        const rowN = yN * gridWidth;
        const rowS = yS * gridWidth;

        for (let x = 0; x < gridWidth; x++) {
          const xW = x === 0 ? gridWidth - 1 : x - 1;
          const xE = x === gridWidth - 1 ? 0 : x + 1;

          const i = row + x;

          const north = rowN + x;
          const south = rowS + x;
          const west = row + xW;
          const east = row + xE;
          const northwest = rowN + xW;
          const northeast = rowN + xE;
          const southwest = rowS + xW;
          const southeast = rowS + xE;

          const currentU = u[i];
          const currentV = v[i];

          const lapU =
            -currentU +
            0.20 * (
              u[north] +
              u[south] +
              u[west] +
              u[east]
            ) +
            0.05 * (
              u[northwest] +
              u[northeast] +
              u[southwest] +
              u[southeast]
            );

          const lapV =
            -currentV +
            0.20 * (
              v[north] +
              v[south] +
              v[west] +
              v[east]
            ) +
            0.05 * (
              v[northwest] +
              v[northeast] +
              v[southwest] +
              v[southeast]
            );

          const reaction =
            currentU * currentV * currentV;

          const updatedU =
            currentU +
            (
              diffusionU * lapU -
              reaction +
              feed * (1 - currentU)
            ) * simulationDt;

          const updatedV =
            currentV +
            (
              diffusionV * lapV +
              reaction -
              (feed + kill) * currentV
            ) * simulationDt;

          nextU[i] = Math.max(
            0,
            Math.min(1, updatedU)
          );

          nextV[i] = Math.max(
            0,
            Math.min(1, updatedV)
          );
        }
      }

      const oldU = u;
      const oldV = v;

      u = nextU;
      v = nextV;
      nextU = oldU;
      nextV = oldV;

      elapsedSteps++;
    }

    // ==================================================
    // COLOUR MAPPING
    // ==================================================

    function smoothstep(
      edge0: number,
      edge1: number,
      value: number
    ) {
      const t = Math.max(
        0,
        Math.min(
          1,
          (value - edge0) / (edge1 - edge0)
        )
      );

      return t * t * (3 - 2 * t);
    }

    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    const paletteStops = [
      [7, 11, 16],
      [16, 40, 54],
      [45, 121, 136],
      [119, 214, 182],
      [231, 238, 201],
      [255, 168, 112]
    ];

    const paletteLut = new Uint8Array(256 * 3);

    for (let sample = 0; sample < 256; sample++) {
      const t = sample / 255;
      const scaled = t * (paletteStops.length - 1);
      const stopIndex = Math.min(
        paletteStops.length - 2,
        Math.floor(scaled)
      );
      const localT = scaled - stopIndex;
      const a = paletteStops[stopIndex];
      const b = paletteStops[stopIndex + 1];
      const offset = sample * 3;

      paletteLut[offset] = Math.round(
        lerp(a[0], b[0], localT)
      );
      paletteLut[offset + 1] = Math.round(
        lerp(a[1], b[1], localT)
      );
      paletteLut[offset + 2] = Math.round(
        lerp(a[2], b[2], localT)
      );
    }

    function updateFieldImage() {
      const pixels = fieldImage.data;
      let meanV = 0;
      let peakReaction = 0;

      for (let i = 0; i < cellCount; i++) {
        const currentU = u[i];
        const currentV = v[i];
        const reaction =
          currentU * currentV * currentV;

        if (statisticsFrame % 5 === 0) {
          meanV += currentV;
          if (reaction > peakReaction) {
            peakReaction = reaction;
          }
        }

        const paletteT = smoothstep(
          0.00,
          0.62,
          currentV
        );
        const paletteIndex =
          Math.min(255, Math.round(paletteT * 255)) * 3;
        const reactionGlow = Math.min(
          1,
          reaction * 22
        );

        const offset = i * 4;
        pixels[offset] = Math.min(
          255,
          paletteLut[paletteIndex] +
            Math.round(28 * reactionGlow)
        );
        pixels[offset + 1] = Math.min(
          255,
          paletteLut[paletteIndex + 1] +
            Math.round(12 * reactionGlow)
        );
        pixels[offset + 2] =
          paletteLut[paletteIndex + 2];
        pixels[offset + 3] = 255;
      }

      fieldCtx.putImageData(fieldImage, 0, 0);

      if (statisticsFrame % 5 === 0) {
        displayedMeanV = meanV / cellCount;
        displayedPeakReaction = peakReaction;
      }

      statisticsFrame++;
    }

    // ==================================================
    // CANVAS DRAWING
    // ==================================================

    function drawBackground() {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;

      const gradient = ctx.createLinearGradient(
        0,
        0,
        0,
        height
      );

      gradient.addColorStop(0, "#091018");
      gradient.addColorStop(1, "#06090d");

      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, width, height);
    }

    function fieldRect() {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const fieldAspect = gridWidth / gridHeight;
      const canvasAspect = width / Math.max(1, height);

      if (canvasAspect > fieldAspect) {
        const drawHeight = height;
        const drawWidth = drawHeight * fieldAspect;

        return {
          x: (width - drawWidth) * 0.5,
          y: 0,
          width: drawWidth,
          height: drawHeight
        };
      }

      const drawWidth = width;
      const drawHeight = drawWidth / fieldAspect;

      return {
        x: 0,
        y: (height - drawHeight) * 0.5,
        width: drawWidth,
        height: drawHeight
      };
    }

    function drawField() {
      const rect = fieldRect();

      ctx.save();
      ctx.imageSmoothingEnabled = showSmoothing;
      ctx.drawImage(
        fieldCanvas,
        rect.x,
        rect.y,
        rect.width,
        rect.height
      );
      ctx.restore();

      const vignette = ctx.createRadialGradient(
        canvas.clientWidth * 0.5,
        canvas.clientHeight * 0.45,
        canvas.clientHeight * 0.10,
        canvas.clientWidth * 0.5,
        canvas.clientHeight * 0.5,
        canvas.clientWidth * 0.72
      );

      vignette.addColorStop(0, "rgba(0,0,0,0)");
      vignette.addColorStop(1, "rgba(0,0,0,0.22)");

      ctx.fillStyle = vignette;
      ctx.fillRect(
        rect.x,
        rect.y,
        rect.width,
        rect.height
      );
    }

    function drawContours() {
      if (!showContours) {
        return;
      }

      const rect = fieldRect();
      const step = 4;
      const cellWidth = rect.width / gridWidth;
      const cellHeight = rect.height / gridHeight;

      ctx.save();
      ctx.lineWidth = 0.65;
      ctx.strokeStyle = "rgba(240,249,244,0.16)";

      for (let y = 0; y < gridHeight - step; y += step) {
        for (let x = 0; x < gridWidth - step; x += step) {
          const i = indexAt(x, y);
          const east = indexAt(x + step, y);
          const south = indexAt(x, y + step);

          const reaction = u[i] * v[i] * v[i];
          const reactionEast =
            u[east] * v[east] * v[east];
          const reactionSouth =
            u[south] * v[south] * v[south];

          const threshold = 0.012;

          if (
            (reaction - threshold) *
              (reactionEast - threshold) < 0 ||
            (reaction - threshold) *
              (reactionSouth - threshold) < 0
          ) {
            const sx = rect.x + x * cellWidth;
            const sy = rect.y + y * cellHeight;

            ctx.beginPath();
            ctx.arc(
              sx,
              sy,
              1.25,
              0,
              Math.PI * 2
            );
            ctx.stroke();
          }
        }
      }

      ctx.restore();
    }

    function drawBrushCursor() {
      if (!pointerInside) {
        return;
      }

      const rect = fieldRect();
      const x =
        rect.x +
        (pointerGridX / gridWidth) * rect.width;
      const y =
        rect.y +
        (pointerGridY / gridHeight) * rect.height;

      const radius =
        brushRadius *
        0.5 *
        (
          rect.width / gridWidth +
          rect.height / gridHeight
        );

      ctx.save();
      ctx.setLineDash([5, 5]);
      ctx.strokeStyle =
        brushMode === "inject-v"
          ? "rgba(255,183,122,0.84)"
          : brushMode === "inject-u"
            ? "rgba(111,216,196,0.84)"
            : "rgba(235,242,247,0.70)";
      ctx.lineWidth = 1.1;
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }

    function draw() {
      drawBackground();
      drawField();
      drawContours();
      drawBrushCursor();
    }

    // ==================================================
    // POINTER MAPPING / PROBE
    // ==================================================

    function pointerToGrid(
      event: { clientX: number; clientY: number }
    ) {
      const canvasRect = canvas.getBoundingClientRect();
      const rect = fieldRect();

      const px = event.clientX - canvasRect.left;
      const py = event.clientY - canvasRect.top;

      const inside =
        px >= rect.x &&
        px <= rect.x + rect.width &&
        py >= rect.y &&
        py <= rect.y + rect.height;

      const x =
        (px - rect.x) / rect.width * gridWidth;
      const y =
        (py - rect.y) / rect.height * gridHeight;

      return {
        inside,
        x: Math.max(0, Math.min(gridWidth - 1, x)),
        y: Math.max(0, Math.min(gridHeight - 1, y))
      };
    }

    function updateProbe() {
      if (!showProbe || !pointerInside) {
        probePanel.hidden = true;
        return;
      }

      const x = Math.max(
        0,
        Math.min(
          gridWidth - 1,
          Math.floor(pointerGridX)
        )
      );

      const y = Math.max(
        0,
        Math.min(
          gridHeight - 1,
          Math.floor(pointerGridY)
        )
      );

      const i = indexAt(x, y);
      const reaction = u[i] * v[i] * v[i];

      probeUOutput.textContent = u[i].toFixed(3);
      probeVOutput.textContent = v[i].toFixed(3);
      probeReactionOutput.textContent = reaction.toFixed(4);
      probePanel.hidden = false;
    }

    function paintAtPointer() {
      paintDisc(
        pointerGridX,
        pointerGridY,
        brushRadius,
        brushMode,
        0.82
      );
    }

    canvas.addEventListener(
      "pointerdown",
      event => {
        const position = pointerToGrid(event);

        if (!position.inside) {
          return;
        }

        canvas.setPointerCapture(event.pointerId);
        isPainting = true;
        pointerInside = true;
        pointerGridX = position.x;
        pointerGridY = position.y;
        paintAtPointer();
        updateProbe();
      }
    );

    canvas.addEventListener(
      "pointermove",
      event => {
        const position = pointerToGrid(event);
        pointerInside = position.inside;
        pointerGridX = position.x;
        pointerGridY = position.y;

        if (isPainting && position.inside) {
          paintAtPointer();
        }

        updateProbe();
      }
    );

    canvas.addEventListener(
      "pointerup",
      event => {
        isPainting = false;

        if (canvas.hasPointerCapture(event.pointerId)) {
          canvas.releasePointerCapture(event.pointerId);
        }
      }
    );

    canvas.addEventListener(
      "pointercancel",
      () => {
        isPainting = false;
      }
    );

    canvas.addEventListener(
      "pointerenter",
      event => {
        const position = pointerToGrid(event);
        pointerInside = position.inside;
        pointerGridX = position.x;
        pointerGridY = position.y;
        brushIndicator.hidden = false;
        updateProbe();
      }
    );

    canvas.addEventListener(
      "pointerleave",
      () => {
        pointerInside = false;
        brushIndicator.hidden = true;
        probePanel.hidden = true;
      }
    );

    canvas.addEventListener(
      "contextmenu",
      event => {
        event.preventDefault();
      }
    );

    // ==================================================
    // UI STATE
    // ==================================================

    function updateControlOutputs() {
      feed = Number(feedSlider.value);
      kill = Number(killSlider.value);
      diffusionU = Number(duSlider.value);
      diffusionV = Number(dvSlider.value);
      iterationsPerFrame = Math.round(
        Number(speedSlider.value)
      );
      brushRadius = Math.round(
        Number(brushSlider.value)
      );

      showSmoothing = smoothingToggle.checked;
      showContours = contourToggle.checked;
      showProbe = probeToggle.checked;
      autoSeedPreset = autoSeedToggle.checked;

      feedOutput.value = feed.toFixed(4);
      killOutput.value = kill.toFixed(4);
      duOutput.value = diffusionU.toFixed(3);
      dvOutput.value = diffusionV.toFixed(3);
      speedOutput.value =
        `${iterationsPerFrame} steps/frame`;
      brushOutput.value = `${brushRadius} px`;

      brushName.textContent = brushLabels[brushMode];
      brushSize.textContent = `${brushRadius} px brush`;

      gridOutput.textContent =
        `${gridWidth} × ${gridHeight}`;

      if (!showProbe) {
        probePanel.hidden = true;
      }
    }

    function updateDerivedOutputs() {
      meanVOutput.textContent =
        displayedMeanV.toFixed(3);

      peakReactionOutput.textContent =
        displayedPeakReaction.toFixed(4);

      stepCountOutput.textContent =
        elapsedSteps.toLocaleString();
    }

    function updatePresetButtons() {
      const buttons =
        presetGrid.querySelectorAll<HTMLButtonElement>(
          "[data-preset]"
        );

      for (const button of buttons) {
        button.classList.toggle(
          "active",
          button.dataset.preset === selectedPreset
        );
      }
    }

    function updateBrushButtons() {
      const buttons =
        brushButtons.querySelectorAll<HTMLButtonElement>(
          "[data-brush-mode]"
        );

      for (const button of buttons) {
        button.classList.toggle(
          "active",
          button.dataset.brushMode === brushMode
        );
      }

      canvasLabel.textContent =
        brushMode === "inject-v"
          ? "Paint chemical V directly onto the field"
          : brushMode === "inject-u"
            ? "Paint chemical U to disrupt or split structures"
            : "Restore the field toward u = 1, v = 0";
    }

    function applyPreset(name: string) {
      const preset = presets[name];

      if (!preset) {
        return;
      }

      selectedPreset = name;
      feedSlider.value = preset.feed.toFixed(4);
      killSlider.value = preset.kill.toFixed(4);

      updateControlOutputs();
      updatePresetButtons();

      if (autoSeedPreset) {
        clearField();
        seedForPreset(preset.seed);
      }
    }

    presetGrid.addEventListener(
      "click",
      event => {
        const target = event.target;

        if (!(target instanceof HTMLButtonElement)) {
          return;
        }

        const presetName = target.dataset.preset;

        if (presetName) {
          applyPreset(presetName);
        }
      }
    );

    brushButtons.addEventListener(
      "click",
      event => {
        const target = event.target;

        if (!(target instanceof HTMLButtonElement)) {
          return;
        }

        const mode = target.dataset.brushMode;

        if (
          mode === "inject-v" ||
          mode === "inject-u" ||
          mode === "erase"
        ) {
          brushMode = mode;
          updateBrushButtons();
          updateControlOutputs();
        }
      }
    );

    for (const slider of [
      feedSlider,
      killSlider,
      duSlider,
      dvSlider,
      speedSlider,
      brushSlider
    ]) {
      slider.addEventListener(
        "input",
        () => {
          selectedPreset = "custom";
          updatePresetButtons();
          updateControlOutputs();
        }
      );
    }

    for (const toggle of [
      smoothingToggle,
      contourToggle,
      probeToggle,
      autoSeedToggle
    ]) {
      toggle.addEventListener(
        "change",
        updateControlOutputs
      );
    }

    seedButton.addEventListener(
      "click",
      () => {
        addRandomSeeds(14);
      }
    );

    centralSeedButton.addEventListener(
      "click",
      addCentralSeed
    );

    clearButton.addEventListener(
      "click",
      clearField
    );

    pauseButton.addEventListener(
      "click",
      () => {
        running = !running;
        pauseButton.textContent = running ? "Pause" : "Play";
      }
    );

    resetButton.addEventListener(
      "click",
      () => {
        feedSlider.value = "0.0367";
        killSlider.value = "0.0649";
        duSlider.value = "0.160";
        dvSlider.value = "0.080";
        speedSlider.value = "8";
        brushSlider.value = "14";

        smoothingToggle.checked = true;
        contourToggle.checked = false;
        probeToggle.checked = true;
        autoSeedToggle.checked = true;

        brushMode = "inject-v";
        selectedPreset = "mitosis";
        running = true;
        pauseButton.textContent = "Pause";

        clearField();
        addCentralSeed();
        updateControlOutputs();
        updatePresetButtons();
        updateBrushButtons();
      }
    );

    // ==================================================
    // RESIZE
    // ==================================================

    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(
        window.devicePixelRatio || 1,
        2
      );

      const width = Math.max(
        1,
        Math.round(rect.width * dpr)
      );

      const height = Math.max(
        1,
        Math.round(rect.height * dpr)
      );

      if (
        canvas.width === width &&
        canvas.height === height
      ) {
        return;
      }

      canvas.width = width;
      canvas.height = height;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    const resizeObserver = new ResizeObserver(
      resizeCanvas
    );

    resizeObserver.observe(canvas);

    // ==================================================
    // ANIMATION LOOP
    // ==================================================

    function animate() {
      if (running) {
        for (
          let iteration = 0;
          iteration < iterationsPerFrame;
          iteration++
        ) {
          stepSimulation();
        }
      }

      updateFieldImage();
      updateDerivedOutputs();
      updateProbe();
      draw();

      requestAnimationFrame(animate);
    }

    // ==================================================
    // START
    // ==================================================

    resizeCanvas();
    clearField();
    addCentralSeed();
    updateControlOutputs();
    updatePresetButtons();
    updateBrushButtons();
    updateFieldImage();
    requestAnimationFrame(animate);
  }
</script>

