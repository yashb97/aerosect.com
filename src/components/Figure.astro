---
const {
  src,
  alt = "",
  caption = "",
  wide = false,
} = Astro.props;
---

<figure class:list={["figure", { wide }]}>
  <img src={src} alt={alt} loading="lazy" />

  {caption && (
    <figcaption>{caption}</figcaption>
  )}
</figure>

<style>
  .figure {
    margin: 48px 0;
  }

  .figure.wide {
    width: min(100%, 1080px);
    margin-left: 50%;
    transform: translateX(-50%);
  }

  img {
    width: 100%;
    display: block;
    border-radius: 24px;
    border: 1px solid var(--card-border);
  }

  figcaption {
    margin-top: 12px;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    text-align: center;
  }
</style>