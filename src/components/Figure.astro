---
const {
  src,
  alt = "",
  caption = "",
  credit = "",
  creditUrl = "",
  wide = false,
} = Astro.props;
---

<figure class:list={["figure", { wide }]}>
  <img src={src} alt={alt} loading="lazy" />

  {(caption || credit) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credit && (
        <span class="credit">
          Image: {creditUrl ? (
            <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a>
          ) : (
            credit
          )}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  .figure {
    margin: 48px 0;
  }

  .figure.wide {
    width: min(100%, 1080px);
    margin-left: 50%;
    transform: translateX(-50%);
  }

  img {
    width: 100%;
    display: block;
    border-radius: 6px;
    border: 1px solid var(--card-border);
  }

  figcaption {
    display: grid;
    gap: 4px;
    margin-top: 12px;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    text-align: center;
  }

  .credit {
    font-size: 0.82rem;
  }

  .credit a {
    color: inherit;
    text-underline-offset: 3px;
  }
</style>
