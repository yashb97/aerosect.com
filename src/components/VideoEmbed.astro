---
const {
  src,
  title = "Embedded video",
  caption = "",
} = Astro.props;
---

<figure class="video-block">
  <div class="video-frame">
    <iframe
      src={src}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>

  {caption && (
    <figcaption>{caption}</figcaption>
  )}
</figure>

<style>
  .video-block {
    margin: 48px 0;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid var(--card-border);
    background: var(--bg-soft);
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    margin-top: 12px;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    text-align: center;
  }
</style>
