---
const {
  quote = "",
  attribution = "",
} = Astro.props;
---

<figure class="pull-quote">
  <blockquote>
    “{quote}”
  </blockquote>

  {attribution && (
    <figcaption>— {attribution}</figcaption>
  )}
</figure>

<style>
  .pull-quote {
    margin: 56px 0;
    padding: 32px;
    border-left: 3px solid var(--accent);
    background: linear-gradient(
      90deg,
      rgba(125, 211, 252, 0.08),
      rgba(255, 255, 255, 0.018)
    );
    border-radius: 0 8px 8px 0;
  }

  blockquote {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    line-height: 1.25;
    font-weight: 700;
  }

  figcaption {
    margin-top: 18px;
    color: var(--text-soft);
    font-size: 0.95rem;
  }
</style>
