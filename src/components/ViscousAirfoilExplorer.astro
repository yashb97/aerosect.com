    // ==================================================
    // PROBE
    // ==================================================

    function updateProbe() {
      if (!probeActive) {
        probePanel.hidden = true;
        return;
      }

      probePanel.hidden = false;

      probeXOutput.textContent = `${probeX.toFixed(3)} m`;
      probeYOutput.textContent = `${probeY.toFixed(3)} m`;

      const velocity = instantaneousVelocityAt(probeX, probeY);

      if (!velocity) {
        probeUOutput.textContent = "—";
        probeVOutput.textContent = "—";
        probeSpeedOutput.textContent = "airfoil";
        return;
      }

      probeUOutput.textContent = `${velocity.u.toFixed(2)} m/s`;
      probeVOutput.textContent = `${velocity.v.toFixed(2)} m/s`;
      probeSpeedOutput.textContent = `${Math.hypot(velocity.u, velocity.v).toFixed(2)} m/s`;
    }

    function drawProbeMarker() {
      if (!probeActive) {
        return;
      }

      const x = physicalToScreenX(probeX);
      const y = physicalToScreenY(probeY);

      ctx.save();
      ctx.strokeStyle = "rgba(255,255,255,0.48)";
      ctx.lineWidth = 1;

      ctx.beginPath();
      ctx.arc(x, y, 4, 0, 2 * Math.PI);
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(x - 7, y);
      ctx.lineTo(x + 7, y);
      ctx.moveTo(x, y - 7);
      ctx.lineTo(x, y + 7);
      ctx.stroke();

      ctx.restore();
    }

    // ==================================================
    // CP PLOT
    // ==================================================

    function drawCpPlot() {
      const width = cpCanvas.clientWidth;
      const height = cpCanvas.clientHeight;

      cpCtx.fillStyle = "#090e14";
      cpCtx.fillRect(0, 0, width, height);

      const allCp = [
        ...upperSurface.map(point => point.cp),
        ...lowerSurface.map(point => point.cp)
      ].filter(Number.isFinite);

      if (allCp.length === 0) {
        return;
      }

      let cpMin = Math.max(-8, Math.min(...allCp));
      let cpMax = Math.min(2, Math.max(1.1, ...allCp));

      cpMin = Math.min(cpMin, -0.5);

      const left = 54;
      const right = 18;
      const top = 20;
      const bottom = 48;

      const plotWidth = width - left - right;
      const plotHeight = height - top - bottom;

      function plotX(xOverC: number) {
        return left + xOverC * plotWidth;
      }

      function plotY(cp: number) {
        return (
          top +
          (cp - cpMin) /
          (cpMax - cpMin) *
          plotHeight
        );
      }

      cpCtx.strokeStyle = "rgba(255,255,255,0.08)";
      cpCtx.lineWidth = 1;

      for (let i = 0; i <= 4; i++) {
        const x = left + i / 4 * plotWidth;

        cpCtx.beginPath();
        cpCtx.moveTo(x, top);
        cpCtx.lineTo(x, top + plotHeight);
        cpCtx.stroke();
      }

      for (let i = 0; i <= 4; i++) {
        const y = top + i / 4 * plotHeight;

        cpCtx.beginPath();
        cpCtx.moveTo(left, y);
        cpCtx.lineTo(left + plotWidth, y);
        cpCtx.stroke();
      }

      if (cpMin <= 0 && cpMax >= 0) {
        cpCtx.strokeStyle = "rgba(255,255,255,0.22)";

        cpCtx.beginPath();
        cpCtx.moveTo(left, plotY(0));
        cpCtx.lineTo(left + plotWidth, plotY(0));
        cpCtx.stroke();
      }

      function drawSurfaceCurve(surface: SurfacePoint[], colour: string) {
        if (surface.length < 2) {
          return;
        }

        cpCtx.beginPath();
        let started = false;

        for (const point of surface) {
          if (!Number.isFinite(point.cp)) {
            continue;
          }

          const clampedCp = Math.max(
            cpMin,
            Math.min(cpMax, point.cp)
          );

          const x = plotX(point.x);
          const y = plotY(clampedCp);

          if (!started) {
            cpCtx.moveTo(x, y);
            started = true;
          } else {
            cpCtx.lineTo(x, y);
          }
        }

        cpCtx.strokeStyle = colour;
        cpCtx.lineWidth = 1.7;
        cpCtx.stroke();
      }

      drawSurfaceCurve(upperSurface, "#67cfff");
      drawSurfaceCurve(lowerSurface, "#f1b86a");

      function drawSeparationLine(
        separation: BoundaryLayerPoint | null,
        colour: string
      ) {
        if (!separation) {
          return;
        }

        const x = plotX(separation.xOverC);

        cpCtx.save();
        cpCtx.setLineDash([5, 4]);
        cpCtx.strokeStyle = colour;
        cpCtx.lineWidth = 1;

        cpCtx.beginPath();
        cpCtx.moveTo(x, top);
        cpCtx.lineTo(x, top + plotHeight);
        cpCtx.stroke();

        cpCtx.restore();
      }

      drawSeparationLine(
        upperBoundaryLayer.separation,
        "rgba(103,207,255,0.72)"
      );

      drawSeparationLine(
        lowerBoundaryLayer.separation,
        "rgba(241,184,106,0.68)"
      );

      cpCtx.fillStyle = "rgba(255,255,255,0.48)";
      cpCtx.font = "11px system-ui, sans-serif";
      cpCtx.textAlign = "center";
      cpCtx.textBaseline = "alphabetic";

      for (let i = 0; i <= 4; i++) {
        const value = i / 4;

        cpCtx.fillText(
          value.toFixed(2),
          plotX(value),
          top + plotHeight + 17
        );
      }

      cpCtx.textAlign = "right";

      cpCtx.fillText(
        cpMin.toFixed(1),
        left - 8,
        top + 4
      );

      cpCtx.fillText(
        cpMax.toFixed(1),
        left - 8,
        top + plotHeight
      );

      cpCtx.save();
      cpCtx.translate(15, top + plotHeight / 2);
      cpCtx.rotate(-Math.PI / 2);
      cpCtx.textAlign = "center";
      cpCtx.textBaseline = "middle";
      cpCtx.fillText("Cp", 0, 0);
      cpCtx.restore();

      cpCtx.textAlign = "center";
      cpCtx.textBaseline = "alphabetic";

      cpCtx.fillText(
        "x/c",
        left + plotWidth / 2,
        height - 7
      );
    }

    // ==================================================
    // OUTPUTS
    // ==================================================

    function superscriptExponent(exponent: number) {
      const map: Record<string, string> = {
        "-": "⁻",
        "0": "⁰",
        "1": "¹",
        "2": "²",
        "3": "³",
        "4": "⁴",
        "5": "⁵",
        "6": "⁶",
        "7": "⁷",
        "8": "⁸",
        "9": "⁹"
      };

      return String(exponent)
        .split("")
        .map(character => map[character] ?? character)
        .join("");
    }

    function formatScientific(value: number) {
      if (!Number.isFinite(value) || value === 0) {
        return "0";
      }

      const exponent = Math.floor(Math.log10(Math.abs(value)));
      const mantissa = value / Math.pow(10, exponent);

      return `${mantissa.toFixed(2)}×10${superscriptExponent(exponent)}`;
    }

    function separationText(result: BoundaryLayerResult) {
      if (!result.separation) {
        return "Attached to TE";
      }

      return `x/c = ${result.separation.xOverC.toFixed(3)}`;
    }

    function updateOutputs() {
      speedOutput.value = `${U.toFixed(1)} m/s`;

      alphaOutput.value = `${(
        alpha * 180 / Math.PI
      ).toFixed(1)}°`;

      thicknessOutput.value = epsilon.toFixed(3);
      camberOutput.value = eta.toFixed(3);
      viscosityOutput.value = `${formatScientific(nu)} m²/s`;
      particleDensityOutput.value = `${activeParticleCount.toLocaleString()} tracers`;

      const reynolds = U * targetChord / nu;

      reOutput.textContent = formatScientific(reynolds);
      gammaOutput.textContent = `${physicalCirculation.toFixed(3)} m²/s`;
      clOutput.textContent = liftCoefficient.toFixed(3);
      chordOutput.textContent = `${targetChord.toFixed(3)} m`;

      upperSeparationOutput.textContent = separationText(upperBoundaryLayer);
      lowerSeparationOutput.textContent = separationText(lowerBoundaryLayer);
    }

    // ==================================================
    // FULL FRAME
    // ==================================================

    function draw() {
      drawBackground();
      drawStreamlines();
      drawVectorField();
      drawTrailCanvas();
      drawWakeVortices();
      drawParticles();
      drawAirfoil();
      drawSeparationMarkers();
      drawFreestreamArrow();
      drawProbeMarker();
    }

    // ==================================================
    // ANIMATION
    // ==================================================

    function animate(now: number) {
      const rawDt = (now - previousTime) / 1000;
      previousTime = now;

      const dt = Math.min(rawDt, 0.03);

      if (running) {
        updateWake(dt);
        updateParticles(dt);

        if (showTrails) {
          fadeTrails();
          drawNewTrailSegments();
        } else {
          clearTrails();
        }
      }

      updateProbe();
      draw();

      requestAnimationFrame(animate);
    }

    // ==================================================
    // CONTROLS
    // ==================================================

    function readControls() {
      U = Number(speedSlider.value);
      alpha = Number(alphaSlider.value) * Math.PI / 180;
      epsilon = Number(thicknessSlider.value);
      eta = Number(camberSlider.value);
      nu = Math.pow(10, Number(viscositySlider.value));
      activeParticleCount = Math.min(
        maxParticleCount,
        Math.max(200, Number(particleDensitySlider.value))
      );

      showParticles = particlesToggle.checked;
      showTrails = trailsToggle.checked;
      showStreamlines = streamlinesToggle.checked;
      showVectors = vectorsToggle.checked;
      showWake = wakeToggle.checked;
      showWakeMarkers = wakeMarkersToggle.checked;
    }

    function modelChanged() {
      readControls();
      clearWake();
      rebuildGeometry();
      seedAllParticles();
    }

    speedSlider.addEventListener("input", modelChanged);
    alphaSlider.addEventListener("input", modelChanged);
    thicknessSlider.addEventListener("input", modelChanged);
    camberSlider.addEventListener("input", modelChanged);
    viscositySlider.addEventListener("input", modelChanged);

    particleDensitySlider.addEventListener("input", () => {
      activeParticleCount = Math.min(
        maxParticleCount,
        Math.max(200, Number(particleDensitySlider.value))
      );

      particleDensityOutput.value =
        `${activeParticleCount.toLocaleString()} tracers`;

      seedAllParticles();
    });

    particlesToggle.addEventListener("change", () => {
      showParticles = particlesToggle.checked;
    });

    trailsToggle.addEventListener("change", () => {
      showTrails = trailsToggle.checked;

      if (!showTrails) {
        clearTrails();
      }
    });

    streamlinesToggle.addEventListener("change", () => {
      showStreamlines = streamlinesToggle.checked;
    });

    vectorsToggle.addEventListener("change", () => {
      showVectors = vectorsToggle.checked;
    });

    wakeToggle.addEventListener("change", () => {
      showWake = wakeToggle.checked;
      clearWake();
      clearTrails();
      seedAllParticles();
    });

    wakeMarkersToggle.addEventListener("change", () => {
      showWakeMarkers = wakeMarkersToggle.checked;
    });

    // ==================================================
    // PAUSE / RESET
    // ==================================================

    pauseButton.addEventListener("click", () => {
      running = !running;
      pauseButton.textContent = running ? "Pause" : "Play";
    });

    resetButton.addEventListener("click", () => {
      speedSlider.value = "1.5";
      alphaSlider.value = "4";
      thicknessSlider.value = "0.12";
      camberSlider.value = "0.06";
      viscositySlider.value = "-4.8239";
      particleDensitySlider.value = "1400";

      particlesToggle.checked = true;
      trailsToggle.checked = true;
      streamlinesToggle.checked = true;
      vectorsToggle.checked = false;
      wakeToggle.checked = true;
      wakeMarkersToggle.checked = true;

      running = true;
      pauseButton.textContent = "Pause";
      probeActive = false;

      readControls();
      clearWake();
      rebuildGeometry();
      seedAllParticles();
    });

    // ==================================================
    // POINTER PROBE
    // ==================================================

    function updateProbeFromPointer(event: PointerEvent) {
      const rect = canvas.getBoundingClientRect();

      const px = Math.max(
        0,
        Math.min(
          rect.width,
          event.clientX - rect.left
        )
      );

      const py = Math.max(
        0,
        Math.min(
          rect.height,
          event.clientY - rect.top
        )
      );

      probeX = screenToPhysicalX(px);
      probeY = screenToPhysicalY(py);
    }

    canvas.addEventListener("pointerenter", event => {
      probeActive = true;
      updateProbeFromPointer(event);
    });

    canvas.addEventListener("pointermove", event => {
      probeActive = true;
      updateProbeFromPointer(event);
    });

    canvas.addEventListener("pointerleave", () => {
      probeActive = false;
    });

    // ==================================================
    // RESIZE
    // ==================================================

    function resizeCanvasElement(
      targetCanvas: HTMLCanvasElement,
      targetContext: CanvasRenderingContext2D
    ) {
      const rect = targetCanvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      const width = Math.max(
        1,
        Math.round(rect.width * dpr)
      );

      const height = Math.max(
        1,
        Math.round(rect.height * dpr)
      );

      if (
        targetCanvas.width === width &&
        targetCanvas.height === height
      ) {
        return false;
      }

      targetCanvas.width = width;
      targetCanvas.height = height;

      targetContext.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
      );

      return true;
    }

    function resizeAll() {
      const mainChanged = resizeCanvasElement(canvas, ctx);
      const cpChanged = resizeCanvasElement(cpCanvas, cpCtx);

      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      const trailWidth = Math.max(
        1,
        Math.round(rect.width * dpr)
      );

      const trailHeight = Math.max(
        1,
        Math.round(rect.height * dpr)
      );

      if (
        trailCanvas.width !== trailWidth ||
        trailCanvas.height !== trailHeight
      ) {
        trailCanvas.width = trailWidth;
        trailCanvas.height = trailHeight;

        trailCtx.setTransform(
          dpr,
          0,
          0,
          dpr,
          0,
          0
        );

        clearTrails();
      }

      if (mainChanged) {
        streamlinesDirty = true;
      }

      if (cpChanged) {
        drawCpPlot();
      }
    }

    if (typeof ResizeObserver !== "undefined") {
      const observer = new ResizeObserver(resizeAll);
      observer.observe(canvas);
      observer.observe(cpCanvas);
    } else {
      window.addEventListener("resize", resizeAll);
    }

    // ==================================================
    // START
    // ==================================================

    resizeAll();
    readControls();
    clearWake();
    rebuildGeometry();
    seedAllParticles();

    requestAnimationFrame(animate);
  }
</script>

