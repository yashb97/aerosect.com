<section class="viscous-airfoil-explorer" data-viscous-airfoil-explorer>
  <div class="canvas-wrap">
    <canvas
      class="flow-canvas"
      data-flow-canvas
      aria-label="Interactive viscous airfoil separated-wake visualisation"
    ></canvas>

    <div class="canvas-label">
      Joukowski outer flow + Thwaites separation + discrete vortex wake
    </div>

    <div class="probe-panel" data-probe-panel hidden>
      <div class="probe-title">Local instantaneous flow</div>
      <div class="probe-grid">
        <span>x</span><strong data-probe-x>—</strong>
        <span>y</span><strong data-probe-y>—</strong>
        <span>u</span><strong data-probe-u>—</strong>
        <span>v</span><strong data-probe-v>—</strong>
        <span>|V|</span><strong data-probe-speed>—</strong>
      </div>
    </div>
  </div>

  <div class="controls">
    <div class="section-title">Airfoil & flow</div>

    <label class="control-row">
      <span>Freestream U∞</span>
      <output data-speed-output>1.5 m/s</output>
      <input data-speed type="range" min="0.2" max="5" step="0.1" value="1.5" />
    </label>

    <label class="control-row">
      <span>Angle of attack α</span>
      <output data-alpha-output>4.0°</output>
      <input data-alpha type="range" min="-12" max="16" step="0.5" value="4" />
    </label>

    <label class="control-row">
      <span>Thickness control ε</span>
      <output data-thickness-output>0.120</output>
      <input data-thickness type="range" min="0.02" max="0.25" step="0.005" value="0.12" />
    </label>

    <label class="control-row">
      <span>Camber control η</span>
      <output data-camber-output>0.060</output>
      <input data-camber type="range" min="-0.18" max="0.18" step="0.005" value="0.06" />
    </label>

    <label class="control-row">
      <span>Kinematic viscosity ν</span>
      <output data-viscosity-output>1.50×10⁻⁵ m²/s</output>
      <input data-viscosity type="range" min="-6" max="-4" step="0.02" value="-4.8239" />
    </label>

    <label class="control-row">
      <span>Particle density</span>
      <output data-particle-density-output>1,400 tracers</output>
      <input data-particle-density type="range" min="600" max="3000" step="200" value="1400" />
    </label>

    <div class="derived-values">
      <div>
        <span>Chord Reynolds number</span>
        <strong data-re-output>—</strong>
      </div>

      <div>
        <span>Kutta circulation Γ</span>
        <strong data-gamma-output>—</strong>
      </div>

      <div>
        <span>Ideal C<sub>L</sub></span>
        <strong data-cl-output>—</strong>
      </div>

      <div>
        <span>Chord c</span>
        <strong data-chord-output>1.000 m</strong>
      </div>
    </div>

    <div class="separation-panel">
      <div class="section-title">Laminar separation estimate</div>

      <div class="separation-grid">
        <div>
          <span class="side-name upper-name">Upper surface</span>
          <strong data-upper-separation>—</strong>
        </div>

        <div>
          <span class="side-name lower-name">Lower surface</span>
          <strong data-lower-separation>—</strong>
        </div>
      </div>

      <div class="wake-status">
        <span>Active wake vortices</span>
        <strong data-wake-count>0</strong>
      </div>

      <p class="separation-note">
        Separation is predicted when the Thwaites pressure-gradient parameter reaches λ ≤ −0.09.
        In v0.2, separated surfaces release regularised vortex blobs that convect in the outer flow
        and interact with one another. The surface C<sub>p</sub> and separation calculation remain one-way coupled.
      </p>
    </div>

    <div class="visual-section">
      <div class="section-title">Visual layers</div>

      <div class="toggle-grid">
        <label class="toggle">
          <input data-particles-toggle type="checkbox" checked />
          <span>Particles</span>
        </label>

        <label class="toggle">
          <input data-trails-toggle type="checkbox" checked />
          <span>Trails</span>
        </label>

        <label class="toggle">
          <input data-streamlines-toggle type="checkbox" checked />
          <span>Outer streamlines</span>
        </label>

        <label class="toggle">
          <input data-vectors-toggle type="checkbox" />
          <span>Velocity vectors</span>
        </label>

        <label class="toggle">
          <input data-wake-toggle type="checkbox" checked />
          <span>Separated wake</span>
        </label>

        <label class="toggle">
          <input data-wake-markers-toggle type="checkbox" checked />
          <span>Wake vortex markers</span>
        </label>
      </div>
    </div>

    <div class="cp-section">
      <div class="cp-heading">
        <div>
          <div class="section-title">Surface pressure</div>
          <div class="cp-subtitle">
            Ideal incompressible C<sub>p</sub>; dashed lines show predicted laminar separation
          </div>
        </div>

        <div class="cp-legend">
          <span class="upper-dot"></span> Upper
          <span class="lower-dot"></span> Lower
        </div>
      </div>

      <canvas
        class="cp-canvas"
        data-cp-canvas
        aria-label="Surface pressure coefficient distribution"
      ></canvas>
    </div>

    <details class="model-details">
      <summary>Model assumptions and equations</summary>

      <div class="model-content">
        <p>
          The inviscid outer velocity Ue(s) is obtained from the Kutta-conditioned Joukowski solution.
          A laminar Thwaites integral boundary-layer calculation is then marched independently from the
          leading-edge stagnation region towards the trailing edge on the upper and lower surfaces.
        </p>

        <div class="equation">
          θ² = 0.45 ν Ue⁻⁶ ∫ Ue⁵ ds
        </div>

        <div class="equation">
          λ = (θ²/ν) dUe/ds
        </div>

        <div class="equation">
          separation estimate: λ ≤ −0.09
        </div>

        <div class="equation">
          δ* = H(λ) θ
        </div>

        <p>
          The Thwaites boundary-layer solution is used to locate separation; the boundary-layer envelope
          itself is not drawn. An internal estimate δ99 ≈ 8.5θ is retained only to place newly released
          wake vortices and tracers just outside the surface. From the predicted separation point, the
          v0.2 wake model releases discrete regularised vortices with the sign of the local surface vorticity.
        </p>

        <div class="equation">
          ΔΓ ≈ ± Ue Uc Δtshed
        </div>

        <div class="equation">
          ublob = Γ/(2π) [−Δy, Δx] / (r² + σ²)
        </div>

        <div class="equation">
          σ²(t) = σ₀² + 4νt
        </div>

        <p>
          Wake vortices are convected by the Joukowski outer flow plus the velocity induced by every other
          wake vortex. Because v0.2 does not yet solve unsteady bound circulation self-consistently, an
          equal-and-opposite regularised bound reaction removes the spurious domain-scale circulation that
          would otherwise accumulate as same-sign wake vortices are released. Particle tracers use this
          instantaneous combined field, while the outer-flow streamlines remain the steady inviscid reference.
        </p>

        <ul>
          <li>Two-dimensional and incompressible</li>
          <li>Potential-flow outer solution</li>
          <li>Laminar Thwaites separation estimate</li>
          <li>Regularised discrete-vortex separated wake</li>
          <li>Viscously growing vortex cores</li>
          <li>Particle density affects visual tracer sampling only</li>
          <li>No transition model yet</li>
          <li>No turbulent boundary-layer closure yet</li>
          <li>No wake-to-surface pressure or bound-circulation feedback yet</li>
        </ul>
      </div>
    </details>

    <div class="bottom-row">
      <div class="model-info">
        <strong>Model:</strong>
        Joukowski + Thwaites separation + discrete vortex wake
      </div>

      <div class="buttons">
        <button data-pause type="button">Pause</button>
        <button data-reset type="button">Reset</button>
      </div>
    </div>
  </div>
</section>

<script>
  type Complex = {
    re: number;
    im: number;
  };

  type Point = {
    x: number;
    y: number;
  };

  type SurfacePoint = {
    x: number;
    y: number;
    cp: number;
  };

  type SurfaceSample = {
    body: Point;
    lab: Point;
    xOverC: number;
    speed: number;
  };

  type BoundaryLayerPoint = {
    x: number;
    y: number;
    xOverC: number;
    s: number;
    ue: number;
    theta: number;
    deltaStar: number;
    delta99: number;
    shapeFactor: number;
    lambda: number;
    cf: number;
  };

  type BoundaryLayerResult = {
    points: BoundaryLayerPoint[];
    separation: BoundaryLayerPoint | null;
  };

  type WakeSource = "upper" | "lower";

  type WakeVortex = {
    x: number;
    y: number;
    gamma: number;
    age: number;
    source: WakeSource;
  };

  const explorers = document.querySelectorAll<HTMLElement>(
    "[data-viscous-airfoil-explorer]"
  );

  for (const root of explorers) {
    const canvas = root.querySelector<HTMLCanvasElement>("[data-flow-canvas]");
    const cpCanvas = root.querySelector<HTMLCanvasElement>("[data-cp-canvas]");

    const speedSlider = root.querySelector<HTMLInputElement>("[data-speed]");
    const alphaSlider = root.querySelector<HTMLInputElement>("[data-alpha]");
    const thicknessSlider = root.querySelector<HTMLInputElement>("[data-thickness]");
    const camberSlider = root.querySelector<HTMLInputElement>("[data-camber]");
    const viscositySlider = root.querySelector<HTMLInputElement>("[data-viscosity]");
    const particleDensitySlider = root.querySelector<HTMLInputElement>("[data-particle-density]");

    const speedOutput = root.querySelector<HTMLOutputElement>("[data-speed-output]");
    const alphaOutput = root.querySelector<HTMLOutputElement>("[data-alpha-output]");
    const thicknessOutput = root.querySelector<HTMLOutputElement>("[data-thickness-output]");
    const camberOutput = root.querySelector<HTMLOutputElement>("[data-camber-output]");
    const viscosityOutput = root.querySelector<HTMLOutputElement>("[data-viscosity-output]");
    const particleDensityOutput = root.querySelector<HTMLOutputElement>("[data-particle-density-output]");

    const reOutput = root.querySelector<HTMLElement>("[data-re-output]");
    const gammaOutput = root.querySelector<HTMLElement>("[data-gamma-output]");
    const clOutput = root.querySelector<HTMLElement>("[data-cl-output]");
    const chordOutput = root.querySelector<HTMLElement>("[data-chord-output]");

    const upperSeparationOutput = root.querySelector<HTMLElement>("[data-upper-separation]");
    const lowerSeparationOutput = root.querySelector<HTMLElement>("[data-lower-separation]");

    const particlesToggle = root.querySelector<HTMLInputElement>("[data-particles-toggle]");
    const trailsToggle = root.querySelector<HTMLInputElement>("[data-trails-toggle]");
    const streamlinesToggle = root.querySelector<HTMLInputElement>("[data-streamlines-toggle]");
    const vectorsToggle = root.querySelector<HTMLInputElement>("[data-vectors-toggle]");
    const wakeToggle = root.querySelector<HTMLInputElement>("[data-wake-toggle]");
    const wakeMarkersToggle = root.querySelector<HTMLInputElement>("[data-wake-markers-toggle]");
    const wakeCountOutput = root.querySelector<HTMLElement>("[data-wake-count]");

    const pauseButton = root.querySelector<HTMLButtonElement>("[data-pause]");
    const resetButton = root.querySelector<HTMLButtonElement>("[data-reset]");

    const probePanel = root.querySelector<HTMLElement>("[data-probe-panel]");
    const probeXOutput = root.querySelector<HTMLElement>("[data-probe-x]");
    const probeYOutput = root.querySelector<HTMLElement>("[data-probe-y]");
    const probeUOutput = root.querySelector<HTMLElement>("[data-probe-u]");
    const probeVOutput = root.querySelector<HTMLElement>("[data-probe-v]");
    const probeSpeedOutput = root.querySelector<HTMLElement>("[data-probe-speed]");

    if (
      !canvas ||
      !cpCanvas ||
      !speedSlider ||
      !alphaSlider ||
      !thicknessSlider ||
      !camberSlider ||
      !viscositySlider ||
      !particleDensitySlider ||
      !speedOutput ||
      !alphaOutput ||
      !thicknessOutput ||
      !camberOutput ||
      !viscosityOutput ||
      !particleDensityOutput ||
      !reOutput ||
      !gammaOutput ||
      !clOutput ||
      !chordOutput ||
      !upperSeparationOutput ||
      !lowerSeparationOutput ||
      !particlesToggle ||
      !trailsToggle ||
      !streamlinesToggle ||
      !vectorsToggle ||
      !wakeToggle ||
      !wakeMarkersToggle ||
      !wakeCountOutput ||
      !pauseButton ||
      !resetButton ||
      !probePanel ||
      !probeXOutput ||
      !probeYOutput ||
      !probeUOutput ||
      !probeVOutput ||
      !probeSpeedOutput
    ) {
      continue;
    }

    const ctx = canvas.getContext("2d");
    const cpCtx = cpCanvas.getContext("2d");

    if (!ctx || !cpCtx) {
      continue;
    }

    const trailCanvas = document.createElement("canvas");
    const trailCtx = trailCanvas.getContext("2d");

    if (!trailCtx) {
      continue;
    }

    // ==================================================
    // DISPLAY DOMAIN
    // ==================================================

    const xmin = -0.8;
    const xmax = 0.8;
    const ymin = -0.48;
    const ymax = 0.48;

    const maxParticleCount = 3000;
    let activeParticleCount = 1400;

    /*
      Reserve a small part of the tracer population for
      particles injected into separated shear layers.
      Freestream tracers are therefore never progressively
      overwritten by one-sided wake injection.
    */
    const wakeTracerFraction = 0.18;

    const particleX = new Float32Array(maxParticleCount);
    const particleY = new Float32Array(maxParticleCount);
    const previousParticleX = new Float32Array(maxParticleCount);
    const previousParticleY = new Float32Array(maxParticleCount);

    // ==================================================
    // MODEL STATE
    // ==================================================

    const b = 1.0;
    const targetChord = 1.0;

    let U = 1.5;
    let alpha = 4 * Math.PI / 180;
    let epsilon = 0.12;
    let eta = 0.06;
    let nu = 1.5e-5;

    let circleCentre: Complex = {
      re: -epsilon,
      im: eta
    };

    let circleRadius = 1;
    let trailingEdgeAngle = 0;

    let circulation = 0;
    let physicalCirculation = 0;
    let liftCoefficient = 0;

    let rawChord = 4;
    let rawMidX = 0;
    let rawMidY = 0;
    let rawGeometryMinX = -2;
    let rawGeometryMaxX = 2;
    let lengthScale = targetChord / rawChord;

    let geometryPoints: Point[] = [];
    let airfoilCentroid: Point = { x: 0, y: 0 };

    let upperSurface: SurfacePoint[] = [];
    let lowerSurface: SurfacePoint[] = [];

    let upperBoundaryLayer: BoundaryLayerResult = {
      points: [],
      separation: null
    };

    let lowerBoundaryLayer: BoundaryLayerResult = {
      points: [],
      separation: null
    };

    let wakeVortices: WakeVortex[] = [];
    let upperShedClock = 0;
    let lowerShedClock = 0;
    let wakeTracerCursor = 0;
    let wakeSerial = 0;
    let wakeCirculationSum = 0;

    const maxWakeVortices = 120;
    const initialWakeCoreRadius = 0.008 * targetChord;
    const nominalWakeSpacing = 0.035 * targetChord;

    // ==================================================
    // VISUAL STATE
    // ==================================================

    let showParticles = true;
    let showTrails = true;
    let showStreamlines = true;
    let showVectors = false;
    let showBoundaryLayer = false;
    let showWake = true;
    let showWakeMarkers = true;

    let running = true;
    let previousTime = performance.now();

    let probeActive = false;
    let probeX = 0;
    let probeY = 0;

    let streamlinesDirty = true;
    let cachedStreamlines: Point[][] = [];

    // ==================================================
    // COMPLEX ARITHMETIC
    // ==================================================

    function cAdd(a: Complex, other: Complex): Complex {
      return {
        re: a.re + other.re,
        im: a.im + other.im
      };
    }

    function cSub(a: Complex, other: Complex): Complex {
      return {
        re: a.re - other.re,
        im: a.im - other.im
      };
    }

    function cMul(a: Complex, other: Complex): Complex {
      return {
        re: a.re * other.re - a.im * other.im,
        im: a.re * other.im + a.im * other.re
      };
    }

    function cScale(a: Complex, scale: number): Complex {
      return {
        re: a.re * scale,
        im: a.im * scale
      };
    }

    function cDiv(a: Complex, other: Complex): Complex {
      const denominator = other.re * other.re + other.im * other.im;

      if (denominator < 1e-16) {
        return { re: 0, im: 0 };
      }

      return {
        re: (a.re * other.re + a.im * other.im) / denominator,
        im: (a.im * other.re - a.re * other.im) / denominator
      };
    }

    function cAbs2(a: Complex): number {
      return a.re * a.re + a.im * a.im;
    }

    function cSqrt(z: Complex): Complex {
      const magnitude = Math.hypot(z.re, z.im);

      const realPart = Math.sqrt(
        Math.max(0, (magnitude + z.re) / 2)
      );

      let imaginaryPart = Math.sqrt(
        Math.max(0, (magnitude - z.re) / 2)
      );

      if (z.im < 0) {
        imaginaryPart *= -1;
      }

      return {
        re: realPart,
        im: imaginaryPart
      };
    }

    // ==================================================
    // BODY / LAB TRANSFORMS
    // ==================================================

    function bodyToLabPoint(point: Point): Point {
      const cosAlpha = Math.cos(alpha);
      const sinAlpha = Math.sin(alpha);

      return {
        x: cosAlpha * point.x + sinAlpha * point.y,
        y: -sinAlpha * point.x + cosAlpha * point.y
      };
    }

    function labToBodyPoint(point: Point): Point {
      const cosAlpha = Math.cos(alpha);
      const sinAlpha = Math.sin(alpha);

      return {
        x: cosAlpha * point.x - sinAlpha * point.y,
        y: sinAlpha * point.x + cosAlpha * point.y
      };
    }

    function bodyToLabVelocity(u: number, v: number) {
      const cosAlpha = Math.cos(alpha);
      const sinAlpha = Math.sin(alpha);

      return {
        u: cosAlpha * u + sinAlpha * v,
        v: -sinAlpha * u + cosAlpha * v
      };
    }

    // ==================================================
    // RAW JOUKOWSKI / NORMALISED BODY COORDINATES
    // ==================================================

    function rawMappedToBody(z: Complex): Point {
      return {
        x: (z.re - rawMidX) * lengthScale,
        y: (z.im - rawMidY) * lengthScale
      };
    }

    function bodyToRawMapped(point: Point): Complex {
      return {
        re: point.x / lengthScale + rawMidX,
        im: point.y / lengthScale + rawMidY
      };
    }

    // ==================================================
    // JOUKOWSKI TRANSFORMATION
    // ==================================================

    function joukowski(zeta: Complex): Complex {
      const inverse = cDiv(
        { re: b * b, im: 0 },
        zeta
      );

      return cAdd(zeta, inverse);
    }

    function joukowskiDerivative(zeta: Complex): Complex {
      const zetaSquared = cMul(zeta, zeta);

      const fraction = cDiv(
        { re: b * b, im: 0 },
        zetaSquared
      );

      return {
        re: 1 - fraction.re,
        im: -fraction.im
      };
    }

    function inverseJoukowski(z: Complex): Complex {
      const zSquared = cMul(z, z);

      const discriminant = cSub(
        zSquared,
        { re: 4 * b * b, im: 0 }
      );

      const root = cSqrt(discriminant);

      const root1 = cScale(cAdd(z, root), 0.5);
      const root2 = cScale(cSub(z, root), 0.5);

      const distance1 = cAbs2(cSub(root1, circleCentre));
      const distance2 = cAbs2(cSub(root2, circleCentre));

      return distance1 >= distance2 ? root1 : root2;
    }

    // ==================================================
    // CYLINDER-PLANE FLOW
    // ==================================================

    function circleVelocityComplex(zeta: Complex): Complex {
      const relative = cSub(zeta, circleCentre);
      const relativeSquared = cMul(relative, relative);

      const expMinusAlpha: Complex = {
        re: Math.cos(alpha),
        im: -Math.sin(alpha)
      };

      const expPlusAlpha: Complex = {
        re: Math.cos(alpha),
        im: Math.sin(alpha)
      };

      const uniform = cScale(expMinusAlpha, U);

      const cylinderTerm = cScale(
        cDiv(expPlusAlpha, relativeSquared),
        U * circleRadius * circleRadius
      );

      const inverseRelative = cDiv(
        { re: 1, im: 0 },
        relative
      );

      const vortexCoefficient: Complex = {
        re: 0,
        im: -circulation / (2 * Math.PI)
      };

      const vortexTerm = cMul(
        vortexCoefficient,
        inverseRelative
      );

      return cAdd(
        cSub(uniform, cylinderTerm),
        vortexTerm
      );
    }

    function bodyVelocityFromZeta(zeta: Complex) {
      const mappingDerivative = joukowskiDerivative(zeta);

      if (cAbs2(mappingDerivative) < 1e-12) {
        return null;
      }

      const circleVelocity = circleVelocityComplex(zeta);
      const mappedVelocity = cDiv(circleVelocity, mappingDerivative);

      return {
        u: mappedVelocity.re,
        v: -mappedVelocity.im
      };
    }

    // ==================================================
    // PHYSICAL OUTER FLOW
    // ==================================================

    function outerVelocityAt(x: number, y: number) {
      if (pointInsideAirfoil(x, y)) {
        return null;
      }

      const bodyPoint = labToBodyPoint({ x, y });
      const rawMappedPoint = bodyToRawMapped(bodyPoint);
      const zeta = inverseJoukowski(rawMappedPoint);

      const radiusFromCentre = Math.hypot(
        zeta.re - circleCentre.re,
        zeta.im - circleCentre.im
      );

      if (radiusFromCentre < circleRadius * 0.998) {
        return null;
      }

      const bodyVelocity = bodyVelocityFromZeta(zeta);

      if (!bodyVelocity) {
        return null;
      }

      return bodyToLabVelocity(
        bodyVelocity.u,
        bodyVelocity.v
      );
    }

    // ==================================================
    // AIRFOIL GEOMETRY
    // ==================================================

    function rebuildGeometry() {
      circleCentre = {
        re: -epsilon,
        im: eta
      };

      circleRadius = Math.hypot(
        b - circleCentre.re,
        -circleCentre.im
      );

      trailingEdgeAngle = Math.atan2(
        -circleCentre.im,
        b - circleCentre.re
      );

      circulation =
        4 *
        Math.PI *
        circleRadius *
        U *
        Math.sin(trailingEdgeAngle - alpha);

      const rawGeometry: Complex[] = [];

      rawGeometryMinX = Infinity;
      rawGeometryMaxX = -Infinity;

      let rawGeometryMinY = Infinity;
      let rawGeometryMaxY = -Infinity;

      const sampleCount = 520;

      for (let i = 0; i < sampleCount; i++) {
        const theta =
          trailingEdgeAngle +
          (i / (sampleCount - 1)) *
          2 *
          Math.PI;

        const zeta: Complex = {
          re: circleCentre.re + circleRadius * Math.cos(theta),
          im: circleCentre.im + circleRadius * Math.sin(theta)
        };

        const z = joukowski(zeta);

        rawGeometry.push(z);

        rawGeometryMinX = Math.min(rawGeometryMinX, z.re);
        rawGeometryMaxX = Math.max(rawGeometryMaxX, z.re);
        rawGeometryMinY = Math.min(rawGeometryMinY, z.im);
        rawGeometryMaxY = Math.max(rawGeometryMaxY, z.im);
      }

      rawChord = rawGeometryMaxX - rawGeometryMinX;
      rawMidX = 0.5 * (rawGeometryMinX + rawGeometryMaxX);
      rawMidY = 0.5 * (rawGeometryMinY + rawGeometryMaxY);
      lengthScale = targetChord / rawChord;

      geometryPoints = [];

      let centroidX = 0;
      let centroidY = 0;

      for (const rawPoint of rawGeometry) {
        const bodyPoint = rawMappedToBody(rawPoint);
        const labPoint = bodyToLabPoint(bodyPoint);

        geometryPoints.push(labPoint);

        centroidX += labPoint.x;
        centroidY += labPoint.y;
      }

      airfoilCentroid = {
        x: centroidX / geometryPoints.length,
        y: centroidY / geometryPoints.length
      };

      physicalCirculation = circulation * lengthScale;

      liftCoefficient =
        -2 *
        physicalCirculation /
        (U * targetChord);

      rebuildSurfacePressure();
      rebuildBoundaryLayers();

      streamlinesDirty = true;

      clearTrails();
      updateOutputs();
      drawCpPlot();
    }

    // ==================================================
    // POINT-IN-AIRFOIL
    // ==================================================

    function pointInsideAirfoil(x: number, y: number) {
      let inside = false;

      for (
        let i = 0, j = geometryPoints.length - 1;
        i < geometryPoints.length;
        j = i++
      ) {
        const pi = geometryPoints[i];
        const pj = geometryPoints[j];

        const intersects =
          ((pi.y > y) !== (pj.y > y)) &&
          (
            x <
            (pj.x - pi.x) *
            (y - pi.y) /
            (pj.y - pi.y) +
            pi.x
          );

        if (intersects) {
          inside = !inside;
        }
      }

      return inside;
    }

    // ==================================================
    // PRESSURE COEFFICIENT
    // ==================================================

    function samplePressureSurface(direction: number): SurfacePoint[] {
      const points: SurfacePoint[] = [];

      const count = 190;
      const edgeOffset = 0.012;

      for (let i = 0; i < count; i++) {
        const fraction = i / (count - 1);

        const arc =
          edgeOffset +
          fraction *
          (Math.PI - 2 * edgeOffset);

        const theta =
          trailingEdgeAngle +
          direction * arc;

        const zeta: Complex = {
          re: circleCentre.re + circleRadius * Math.cos(theta),
          im: circleCentre.im + circleRadius * Math.sin(theta)
        };

        const z = joukowski(zeta);
        const velocity = bodyVelocityFromZeta(zeta);

        if (!velocity) {
          continue;
        }

        const speed = Math.hypot(velocity.u, velocity.v);
        const cp = 1 - (speed * speed) / (U * U);

        points.push({
          x: (z.re - rawGeometryMinX) / rawChord,
          y: z.im,
          cp
        });
      }

      return points;
    }

    function rebuildSurfacePressure() {
      const branchA = samplePressureSurface(1);
      const branchB = samplePressureSurface(-1);

      const midA = branchA[Math.floor(branchA.length / 2)];
      const midB = branchB[Math.floor(branchB.length / 2)];

      if (midA && midB && midA.y >= midB.y) {
        upperSurface = branchA;
        lowerSurface = branchB;
      } else {
        upperSurface = branchB;
        lowerSurface = branchA;
      }
    }

    // ==================================================
    // FULL SURFACE SAMPLING FOR BOUNDARY LAYER
    // ==================================================

    function buildFullSurfaceSamples(): SurfaceSample[] {
      const samples: SurfaceSample[] = [];
      const count = 900;
      const edgeOffset = 0.004;

      for (let i = 0; i < count; i++) {
        const fraction = i / (count - 1);

        const theta =
          trailingEdgeAngle +
          edgeOffset +
          fraction *
          (2 * Math.PI - 2 * edgeOffset);

        const zeta: Complex = {
          re: circleCentre.re + circleRadius * Math.cos(theta),
          im: circleCentre.im + circleRadius * Math.sin(theta)
        };

        const rawMapped = joukowski(zeta);
        const body = rawMappedToBody(rawMapped);
        const lab = bodyToLabPoint(body);
        const velocity = bodyVelocityFromZeta(zeta);

        if (!velocity) {
          continue;
        }

        samples.push({
          body,
          lab,
          xOverC: (rawMapped.re - rawGeometryMinX) / rawChord,
          speed: Math.hypot(velocity.u, velocity.v)
        });
      }

      return samples;
    }

    function meanBodyY(path: SurfaceSample[]) {
      if (path.length === 0) {
        return 0;
      }

      const start = Math.min(4, path.length - 1);
      const end = Math.min(path.length, Math.max(start + 1, Math.floor(path.length * 0.55)));

      let sum = 0;
      let count = 0;

      for (let i = start; i < end; i++) {
        sum += path[i].body.y;
        count++;
      }

      return count > 0 ? sum / count : 0;
    }

    function splitSurfaceAtLeadingStagnation() {
      const samples = buildFullSurfaceSamples();

      if (samples.length < 20) {
        return {
          upper: [] as SurfaceSample[],
          lower: [] as SurfaceSample[]
        };
      }

      let stagnationIndex = -1;
      let minimumSpeed = Infinity;

      /*
        Exclude the trailing-edge region and search the
        forward part of the airfoil for the leading-side
        surface stagnation point.
      */
      for (let i = 4; i < samples.length - 4; i++) {
        const sample = samples[i];

        if (sample.xOverC > 0.42) {
          continue;
        }

        if (sample.speed < minimumSpeed) {
          minimumSpeed = sample.speed;
          stagnationIndex = i;
        }
      }

      if (stagnationIndex < 0) {
        stagnationIndex = Math.floor(samples.length / 2);
      }

      const pathA: SurfaceSample[] = [];

      for (let i = stagnationIndex; i >= 0; i--) {
        pathA.push(samples[i]);
      }

      const pathB = samples.slice(stagnationIndex);

      if (meanBodyY(pathA) >= meanBodyY(pathB)) {
        return {
          upper: pathA,
          lower: pathB
        };
      }

      return {
        upper: pathB,
        lower: pathA
      };
    }

    // ==================================================
    // THWAITES CORRELATIONS
    // ==================================================

    function thwaitesShapeFactor(lambda: number) {
      if (lambda >= 0) {
        return 2.61 - 3.75 * lambda + 5.24 * lambda * lambda;
      }

      const safeLambda = Math.max(lambda, -0.099);

      return 2.088 + 0.0731 / (safeLambda + 0.14);
    }

    function thwaitesShearFunction(lambda: number) {
      if (lambda >= 0) {
        return 0.22 + 1.57 * lambda - 1.8 * lambda * lambda;
      }

      const safeLambda = Math.max(lambda, -0.099);

      return (
        0.22 +
        1.402 * safeLambda +
        (0.018 * safeLambda) /
        (safeLambda + 0.107)
      );
    }

    function marchBoundaryLayer(path: SurfaceSample[]): BoundaryLayerResult {
      if (path.length < 8) {
        return {
          points: [],
          separation: null
        };
      }

      const s: number[] = new Array(path.length).fill(0);
      const ue: number[] = path.map(sample => Math.max(sample.speed, 1e-8));

      for (let i = 1; i < path.length; i++) {
        s[i] =
          s[i - 1] +
          Math.hypot(
            path[i].lab.x - path[i - 1].lab.x,
            path[i].lab.y - path[i - 1].lab.y
          );
      }

      const startThreshold = Math.max(0.02 * U, 1e-4);

      let startIndex = 1;

      while (
        startIndex < path.length - 3 &&
        ue[startIndex] < startThreshold
      ) {
        startIndex++;
      }

      const derivativeAt = (index: number) => {
        if (index <= 0) {
          const ds = Math.max(s[1] - s[0], 1e-9);
          return (ue[1] - ue[0]) / ds;
        }

        if (index >= path.length - 1) {
          const ds = Math.max(s[index] - s[index - 1], 1e-9);
          return (ue[index] - ue[index - 1]) / ds;
        }

        const ds = Math.max(s[index + 1] - s[index - 1], 1e-9);
        return (ue[index + 1] - ue[index - 1]) / ds;
      };

      const initialGradient = Math.max(
        derivativeAt(startIndex),
        1e-6
      );

      const initialThetaSquared =
        0.075 *
        nu /
        initialGradient;

      let thwaitesIntegralState =
        initialThetaSquared *
        Math.pow(ue[startIndex], 6);

      const points: BoundaryLayerPoint[] = [];
      let separation: BoundaryLayerPoint | null = null;

      for (let i = startIndex; i < path.length; i++) {
        if (i > startIndex) {
          const ds = Math.max(s[i] - s[i - 1], 0);

          thwaitesIntegralState +=
            0.45 *
            nu *
            0.5 *
            (
              Math.pow(ue[i - 1], 5) +
              Math.pow(ue[i], 5)
            ) *
            ds;
        }

        const localUe = Math.max(ue[i], 1e-6);

        const thetaSquared = Math.max(
          thwaitesIntegralState /
          Math.pow(localUe, 6),
          0
        );

        const theta = Math.sqrt(thetaSquared);
        const dueDs = derivativeAt(i);
        const lambda = thetaSquared / nu * dueDs;

        const separated = lambda <= -0.09;

        const shapeFactor = thwaitesShapeFactor(
          separated ? -0.09 : lambda
        );

        const shearFunction = separated
          ? 0
          : thwaitesShearFunction(lambda);

        const reTheta = localUe * theta / nu;

        const cf =
          reTheta > 1e-10
            ? 2 * shearFunction / reTheta
            : 0;

        const deltaStar = shapeFactor * theta;
        const delta99 = 8.5 * theta;

        const point: BoundaryLayerPoint = {
          x: path[i].lab.x,
          y: path[i].lab.y,
          xOverC: Math.max(0, Math.min(1, path[i].xOverC)),
          s: s[i],
          ue: localUe,
          theta,
          deltaStar,
          delta99,
          shapeFactor,
          lambda,
          cf
        };

        points.push(point);

        if (separated) {
          separation = point;
          break;
        }
      }

      return {
        points,
        separation
      };
    }

    function rebuildBoundaryLayers() {
      const split = splitSurfaceAtLeadingStagnation();

      upperBoundaryLayer = marchBoundaryLayer(split.upper);
      lowerBoundaryLayer = marchBoundaryLayer(split.lower);
    }

    // ==================================================
    // DISCRETE VORTEX WAKE
    // ==================================================

    function clearWake() {
      wakeVortices = [];
      upperShedClock = 0;
      lowerShedClock = 0;
      wakeTracerCursor = 0;
      wakeSerial = 0;
      wakeCirculationSum = 0;
      wakeCountOutput.textContent = "0";
    }

    function separationFrame(result: BoundaryLayerResult) {
      const separation = result.separation;

      if (!separation || result.points.length < 2) {
        return null;
      }

      const index = Math.max(
        0,
        result.points.indexOf(separation)
      );

      const previous = result.points[Math.max(0, index - 1)];
      const next = result.points[Math.min(result.points.length - 1, index + 1)];

      const tangentX = next.x - previous.x;
      const tangentY = next.y - previous.y;
      const tangentLength = Math.hypot(tangentX, tangentY);

      if (tangentLength < 1e-12) {
        return null;
      }

      const tx = tangentX / tangentLength;
      const ty = tangentY / tangentLength;
      const normal = outwardNormal(result.points, index);

      return {
        point: separation,
        tx,
        ty,
        nx: normal.x,
        ny: normal.y
      };
    }

    function wakeCoreRadius(vortex: WakeVortex) {
      /*
        The initial blob core prevents the Biot-Savart
        kernel from becoming singular. Core growth with
        4νt gives the wake an explicit viscous diffusion
        time scale while keeping the browser model cheap.
      */
      return Math.sqrt(
        initialWakeCoreRadius * initialWakeCoreRadius +
        4 * nu * vortex.age
      );
    }

    function recalculateWakeCirculation() {
      let total = 0;

      for (const vortex of wakeVortices) {
        total += vortex.gamma;
      }

      wakeCirculationSum = total;
    }

    function boundReactionVelocity(
      x: number,
      y: number
    ) {
      /*
        A fully coupled unsteady model would alter bound
        circulation as vorticity is shed. v0.2 keeps the
        surface solution one-way coupled, so this regularised
        equal-and-opposite reaction supplies only the velocity
        correction needed to prevent spurious net circulation
        from growing across the whole domain.
      */

      if (Math.abs(wakeCirculationSum) < 1e-12) {
        return { u: 0, v: 0 };
      }

      const dx = x - airfoilCentroid.x;
      const dy = y - airfoilCentroid.y;
      const r2 = dx * dx + dy * dy;
      const core = 0.12 * targetChord;
      const denominator = r2 + core * core;

      const compensatingGamma = -wakeCirculationSum;
      const factor =
        compensatingGamma /
        (2 * Math.PI * denominator);

      return {
        u: -factor * dy,
        v: factor * dx
      };
    }

    function wakeVelocityAt(
      x: number,
      y: number,
      ignoreIndex = -1
    ) {
      let u = 0;
      let v = 0;

      if (!showWake || wakeVortices.length === 0) {
        return { u, v };
      }

      for (let i = 0; i < wakeVortices.length; i++) {
        if (i === ignoreIndex) {
          continue;
        }

        const vortex = wakeVortices[i];
        const dx = x - vortex.x;
        const dy = y - vortex.y;
        const r2 = dx * dx + dy * dy;
        const core = wakeCoreRadius(vortex);
        const denominator = r2 + core * core;

        const factor =
          vortex.gamma /
          (2 * Math.PI * denominator);

        u -= factor * dy;
        v += factor * dx;
      }

      const reaction = boundReactionVelocity(x, y);

      u += reaction.u;
      v += reaction.v;

      return { u, v };
    }

    function instantaneousVelocityAt(x: number, y: number) {
      const outer = outerVelocityAt(x, y);

      if (!outer) {
        return null;
      }

      if (!showWake || wakeVortices.length === 0) {
        return outer;
      }

      const wake = wakeVelocityAt(x, y);

      return {
        u: outer.u + wake.u,
        v: outer.v + wake.v
      };
    }

    function wakeSheddingPeriod(separation: BoundaryLayerPoint) {
      /*
        Blob release spacing is set in convective units,
        so changing U∞ does not radically change the
        apparent spatial resolution of the shear layer.
      */
      const convectionSpeed = Math.max(
        0.35 * U,
        0.55 * separation.ue
      );

      return Math.max(
        0.018,
        Math.min(
          0.16,
          nominalWakeSpacing / Math.max(convectionSpeed, 1e-6)
        )
      );
    }

    function seedWakeTracers(
      frame: ReturnType<typeof separationFrame>,
      count: number
    ) {
      if (!frame) {
        return;
      }

      const baseOffset = Math.max(
        0.004 * targetChord,
        Math.min(
          0.03 * targetChord,
          1.15 * frame.point.delta99
        )
      );

      const wakeStart = Math.floor(
        activeParticleCount * (1 - wakeTracerFraction)
      );

      const wakeCapacity =
        activeParticleCount - wakeStart;

      if (wakeCapacity <= 0) {
        return;
      }

      for (let n = 0; n < count; n++) {
        const index =
          wakeStart +
          (wakeTracerCursor % wakeCapacity);

        wakeTracerCursor++;

        const tangentJitter =
          (n - 0.5 * (count - 1)) *
          0.0025 * targetChord;

        const normalJitter =
          (0.15 + 0.08 * Math.sin(wakeSerial + n)) *
          baseOffset;

        particleX[index] =
          frame.point.x +
          frame.tx * tangentJitter +
          frame.nx * (baseOffset + normalJitter);

        particleY[index] =
          frame.point.y +
          frame.ty * tangentJitter +
          frame.ny * (baseOffset + normalJitter);

        previousParticleX[index] = particleX[index];
        previousParticleY[index] = particleY[index];
      }
    }

    function shedWakeVortex(
      result: BoundaryLayerResult,
      source: WakeSource,
      shedPeriod: number
    ) {
      const frame = separationFrame(result);

      if (!frame) {
        return;
      }

      const separation = frame.point;
      const convectionSpeed = Math.max(
        0.35 * U,
        0.55 * separation.ue
      );

      /*
        A separated shear layer has an approximate
        vortex-sheet strength equal to its velocity jump.
        Taking the inner separated-flow speed as small,
        γsheet ≈ Ue. A blob represents a convected sheet
        segment Uc Δt, hence ΔΓ ≈ Ue Uc Δt.

        Upper-surface boundary-layer vorticity is negative
        for left-to-right flow; lower-surface vorticity is
        positive.
      */
      const sign = source === "upper" ? -1 : 1;

      const gammaMagnitude = Math.min(
        0.075 * U * targetChord,
        0.55 * separation.ue * convectionSpeed * shedPeriod
      );

      if (gammaMagnitude < 1e-7) {
        return;
      }

      const baseOffset = Math.max(
        0.006 * targetChord,
        Math.min(
          0.035 * targetChord,
          1.35 * separation.delta99
        )
      );

      /*
        A tiny deterministic perturbation seeds the
        convective shear-layer instability without
        changing vortex sign or adding random forcing.
      */
      const perturbation =
        1 +
        0.08 * Math.sin(2.3999632297 * wakeSerial);

      const normalOffset = baseOffset * perturbation;
      const tangentOffset = 0.006 * targetChord;

      wakeVortices.push({
        x:
          separation.x +
          frame.nx * normalOffset +
          frame.tx * tangentOffset,

        y:
          separation.y +
          frame.ny * normalOffset +
          frame.ty * tangentOffset,

        gamma: sign * gammaMagnitude,
        age: 0,
        source
      });

      wakeSerial++;
      seedWakeTracers(frame, 4);

      if (wakeVortices.length > maxWakeVortices) {
        wakeVortices.splice(
          0,
          wakeVortices.length - maxWakeVortices
        );
      }

      recalculateWakeCirculation();
    }

    function updateWakeShedding(dt: number) {
      if (!showWake) {
        return;
      }

      const upperSeparation = upperBoundaryLayer.separation;
      const lowerSeparation = lowerBoundaryLayer.separation;

      if (upperSeparation) {
        upperShedClock += dt;
        const period = wakeSheddingPeriod(upperSeparation);

        while (upperShedClock >= period) {
          upperShedClock -= period;
          shedWakeVortex(upperBoundaryLayer, "upper", period);
        }
      } else {
        upperShedClock = 0;
      }

      if (lowerSeparation) {
        lowerShedClock += dt;
        const period = wakeSheddingPeriod(lowerSeparation);

        while (lowerShedClock >= period) {
          lowerShedClock -= period;
          shedWakeVortex(lowerBoundaryLayer, "lower", period);
        }
      } else {
        lowerShedClock = 0;
      }
    }

    function updateWakeVortices(dt: number) {
      if (!showWake || wakeVortices.length === 0) {
        wakeCountOutput.textContent = "0";
        return;
      }

      const substeps = 2;
      const subDt = dt / substeps;

      for (let step = 0; step < substeps; step++) {
        const nextX = new Float64Array(wakeVortices.length);
        const nextY = new Float64Array(wakeVortices.length);

        for (let i = 0; i < wakeVortices.length; i++) {
          const vortex = wakeVortices[i];
          const outer = outerVelocityAt(vortex.x, vortex.y);

          const baseVelocity = outer ?? {
            u: U,
            v: 0
          };

          const induced = wakeVelocityAt(
            vortex.x,
            vortex.y,
            i
          );

          let u = baseVelocity.u + induced.u;
          let v = baseVelocity.v + induced.v;

          /*
            A generous speed limiter protects against a
            rare pathological blob overlap without
            changing ordinary wake dynamics.
          */
          const speed = Math.hypot(u, v);
          const speedLimit = Math.max(8, 7 * U);

          if (speed > speedLimit) {
            const scale = speedLimit / speed;
            u *= scale;
            v *= scale;
          }

          nextX[i] = vortex.x + u * subDt;
          nextY[i] = vortex.y + v * subDt;
        }

        for (let i = 0; i < wakeVortices.length; i++) {
          wakeVortices[i].x = nextX[i];
          wakeVortices[i].y = nextY[i];
          wakeVortices[i].age += subDt;
        }
      }

      const downstreamMargin = 0.25 * targetChord;
      const verticalMargin = 0.20 * targetChord;
      const maximumAge = Math.max(1.5, 4.0 * targetChord / Math.max(U, 0.2));

      wakeVortices = wakeVortices.filter(vortex => {
        if (vortex.age > maximumAge) {
          return false;
        }

        if (
          vortex.x > xmax + downstreamMargin ||
          vortex.x < xmin - downstreamMargin ||
          vortex.y > ymax + verticalMargin ||
          vortex.y < ymin - verticalMargin
        ) {
          return false;
        }

        return !pointInsideAirfoil(vortex.x, vortex.y);
      });

      recalculateWakeCirculation();
      wakeCountOutput.textContent = String(wakeVortices.length);
    }

    function updateWake(dt: number) {
      if (!showWake) {
        return;
      }

      updateWakeShedding(dt);
      updateWakeVortices(dt);
    }

    // ==================================================
    // SCREEN COORDINATES
    // ==================================================

    function physicalToScreenX(x: number) {
      return (
        (x - xmin) /
        (xmax - xmin) *
        canvas.clientWidth
      );
    }

    function physicalToScreenY(y: number) {
      return (
        canvas.clientHeight -
        (y - ymin) /
        (ymax - ymin) *
        canvas.clientHeight
      );
    }

    function screenToPhysicalX(x: number) {
      return xmin + x / canvas.clientWidth * (xmax - xmin);
    }

    function screenToPhysicalY(y: number) {
      return ymax - y / canvas.clientHeight * (ymax - ymin);
    }

    // ==================================================
    // PARTICLES
    // ==================================================

    function seedParticle(index: number, anywhere = true) {
      let attempts = 0;

      do {
        if (anywhere) {
          particleX[index] = xmin + Math.random() * (xmax - xmin);
          particleY[index] = ymin + Math.random() * (ymax - ymin);
        } else {
          /*
            New inlet tracers are distributed over a short x-band.
            At high U∞, respawning every tracer at one exact x
            coordinate synchronises them with animation frames and
            creates artificial vertical particle stripes.
          */
          const inletPhaseWidth = Math.min(
            0.12 * targetChord,
            Math.max(
              0.015 * targetChord,
              0.022 * U
            )
          );

          particleX[index] =
            xmin +
            Math.random() * inletPhaseWidth;

          particleY[index] =
            ymin +
            Math.random() * (ymax - ymin);
        }

        attempts++;
      } while (
        pointInsideAirfoil(particleX[index], particleY[index]) &&
        attempts < 30
      );

      previousParticleX[index] = particleX[index];
      previousParticleY[index] = particleY[index];
    }

    function seedAllParticles() {
      wakeTracerCursor = 0;

      for (let i = 0; i < activeParticleCount; i++) {
        seedParticle(i, true);
      }

      clearTrails();
    }

    function updateParticles(dt: number) {
      /*
        Use more integration substeps as freestream speed rises.
        This prevents large visual jumps through the near-airfoil
        velocity gradients at the 5 m/s setting.
      */
      const targetConvectiveStep =
        0.015 * targetChord;

      const substeps = Math.max(
        2,
        Math.min(
          8,
          Math.ceil(
            Math.max(U, 1) * dt /
            targetConvectiveStep
          )
        )
      );

      const subDt = dt / substeps;

      for (let i = 0; i < activeParticleCount; i++) {
        previousParticleX[i] = particleX[i];
        previousParticleY[i] = particleY[i];

        for (let step = 0; step < substeps; step++) {
          const x = particleX[i];
          const y = particleY[i];

          const velocity1 = instantaneousVelocityAt(x, y);

          if (!velocity1) {
            seedParticle(i, false);
            break;
          }

          const speed1 = Math.hypot(velocity1.u, velocity1.v);

          if (speed1 > Math.max(20, 12 * U)) {
            seedParticle(i, false);
            break;
          }

          const midX = x + 0.5 * velocity1.u * subDt;
          const midY = y + 0.5 * velocity1.v * subDt;

          const velocity2 = instantaneousVelocityAt(midX, midY);

          if (!velocity2) {
            seedParticle(i, false);
            break;
          }

          particleX[i] = x + velocity2.u * subDt;
          particleY[i] = y + velocity2.v * subDt;

          const outside =
            particleX[i] < xmin ||
            particleX[i] > xmax ||
            particleY[i] < ymin ||
            particleY[i] > ymax;

          if (
            outside ||
            pointInsideAirfoil(particleX[i], particleY[i])
          ) {
            seedParticle(i, false);
            break;
          }
        }
      }
    }

    // ==================================================
    // TRAILS
    // ==================================================

    const speedColours = [
      "rgba(72,121,170,0.28)",
      "rgba(70,151,204,0.34)",
      "rgba(76,181,226,0.42)",
      "rgba(94,207,242,0.52)",
      "rgba(137,226,251,0.66)",
      "rgba(215,246,255,0.82)"
    ];

    function speedBin(speed: number) {
      const reference = Math.max(2, 2.5 * U);
      const normalized = Math.min(speed / reference, 1);

      return Math.min(
        speedColours.length - 1,
        Math.floor(normalized * speedColours.length)
      );
    }

    function clearTrails() {
      trailCtx.save();
      trailCtx.setTransform(1, 0, 0, 1, 0, 0);
      trailCtx.clearRect(0, 0, trailCanvas.width, trailCanvas.height);
      trailCtx.restore();
    }

    function fadeTrails() {
      trailCtx.save();
      trailCtx.setTransform(1, 0, 0, 1, 0, 0);
      trailCtx.globalCompositeOperation = "destination-out";
      trailCtx.fillStyle = "rgba(0,0,0,0.055)";
      trailCtx.fillRect(0, 0, trailCanvas.width, trailCanvas.height);
      trailCtx.restore();
      trailCtx.globalCompositeOperation = "source-over";
    }

    function drawNewTrailSegments() {
      if (!showTrails) {
        return;
      }

      for (let bin = 0; bin < speedColours.length; bin++) {
        trailCtx.beginPath();
        let hasSegments = false;

        for (let i = 0; i < activeParticleCount; i++) {
          const x0 = previousParticleX[i];
          const y0 = previousParticleY[i];
          const x1 = particleX[i];
          const y1 = particleY[i];

          if (
            Math.abs(x1 - x0) > 0.18 ||
            Math.abs(y1 - y0) > 0.18
          ) {
            continue;
          }

          const mx = 0.5 * (x0 + x1);
          const my = 0.5 * (y0 + y1);

          const velocity = instantaneousVelocityAt(mx, my);

          if (!velocity) {
            continue;
          }

          const speed = Math.hypot(velocity.u, velocity.v);

          if (speedBin(speed) !== bin) {
            continue;
          }

          trailCtx.moveTo(
            physicalToScreenX(x0),
            physicalToScreenY(y0)
          );

          trailCtx.lineTo(
            physicalToScreenX(x1),
            physicalToScreenY(y1)
          );

          hasSegments = true;
        }

        if (hasSegments) {
          trailCtx.strokeStyle = speedColours[bin];
          trailCtx.lineWidth = 1;
          trailCtx.stroke();
        }
      }
    }

    // ==================================================
    // STREAMLINES
    // ==================================================

    function normalizedDirection(x: number, y: number) {
      const velocity = outerVelocityAt(x, y);

      if (!velocity) {
        return null;
      }

      const magnitude = Math.hypot(velocity.u, velocity.v);

      if (magnitude < 1e-9) {
        return null;
      }

      return {
        x: velocity.u / magnitude,
        y: velocity.v / magnitude
      };
    }

    function traceStreamline(seedX: number, seedY: number) {
      const points: Point[] = [];

      let x = seedX;
      let y = seedY;

      const stepSize = 0.0065;
      const maxSteps = 700;

      for (let i = 0; i < maxSteps; i++) {
        if (
          x < xmin ||
          x > xmax ||
          y < ymin ||
          y > ymax
        ) {
          break;
        }

        if (pointInsideAirfoil(x, y)) {
          break;
        }

        points.push({ x, y });

        const d1 = normalizedDirection(x, y);

        if (!d1) {
          break;
        }

        const midX = x + 0.5 * stepSize * d1.x;
        const midY = y + 0.5 * stepSize * d1.y;

        const d2 = normalizedDirection(midX, midY);

        if (!d2) {
          break;
        }

        x += stepSize * d2.x;
        y += stepSize * d2.y;
      }

      return points;
    }

    function rebuildStreamlines() {
      cachedStreamlines = [];

      const count = 25;

      for (let i = 0; i < count; i++) {
        const y =
          ymin +
          (i + 0.5) /
          count *
          (ymax - ymin);

        const streamline = traceStreamline(
          xmin + 0.005,
          y
        );

        if (streamline.length > 2) {
          cachedStreamlines.push(streamline);
        }
      }

      streamlinesDirty = false;
    }

    function drawStreamlines() {
      if (!showStreamlines) {
        return;
      }

      if (streamlinesDirty) {
        rebuildStreamlines();
      }

      ctx.save();
      ctx.strokeStyle = "rgba(190,222,240,0.21)";
      ctx.lineWidth = 0.8;

      for (const streamline of cachedStreamlines) {
        if (streamline.length < 2) {
          continue;
        }

        ctx.beginPath();

        ctx.moveTo(
          physicalToScreenX(streamline[0].x),
          physicalToScreenY(streamline[0].y)
        );

        for (let i = 1; i < streamline.length; i++) {
          ctx.lineTo(
            physicalToScreenX(streamline[i].x),
            physicalToScreenY(streamline[i].y)
          );
        }

        ctx.stroke();
      }

      ctx.restore();
    }

    // ==================================================
    // VECTOR FIELD
    // ==================================================

    function drawArrow(
      x: number,
      y: number,
      dx: number,
      dy: number,
      opacity: number
    ) {
      const endX = x + dx;
      const endY = y + dy;
      const angle = Math.atan2(dy, dx);
      const head = 4.5;

      ctx.strokeStyle = `rgba(210,235,248,${opacity})`;
      ctx.fillStyle = `rgba(210,235,248,${opacity})`;
      ctx.lineWidth = 0.8;

      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(endX, endY);
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(endX, endY);

      ctx.lineTo(
        endX - head * Math.cos(angle - Math.PI / 6),
        endY - head * Math.sin(angle - Math.PI / 6)
      );

      ctx.lineTo(
        endX - head * Math.cos(angle + Math.PI / 6),
        endY - head * Math.sin(angle + Math.PI / 6)
      );

      ctx.closePath();
      ctx.fill();
    }

    function drawVectorField() {
      if (!showVectors) {
        return;
      }

      const nx = Math.max(10, Math.floor(canvas.clientWidth / 70));
      const ny = Math.max(6, Math.floor(canvas.clientHeight / 70));

      for (let iy = 0; iy < ny; iy++) {
        for (let ix = 0; ix < nx; ix++) {
          const x =
            xmin +
            (ix + 0.5) /
            nx *
            (xmax - xmin);

          const y =
            ymin +
            (iy + 0.5) /
            ny *
            (ymax - ymin);

          const velocity = instantaneousVelocityAt(x, y);

          if (!velocity) {
            continue;
          }

          const magnitude = Math.hypot(velocity.u, velocity.v);

          if (magnitude < 1e-8) {
            continue;
          }

          const relative = Math.min(
            magnitude / Math.max(2, 2.4 * U),
            1
          );

          const length = 7 + 15 * relative;

          drawArrow(
            physicalToScreenX(x),
            physicalToScreenY(y),
            velocity.u / magnitude * length,
            -velocity.v / magnitude * length,
            0.14 + 0.3 * relative
          );
        }
      }
    }

    // ==================================================
    // BACKGROUND
    // ==================================================

    function drawBackground() {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;

      const gradient = ctx.createLinearGradient(0, 0, 0, height);
      gradient.addColorStop(0, "#091018");
      gradient.addColorStop(1, "#06090d");

      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, width, height);

      ctx.strokeStyle = "rgba(255,255,255,0.035)";
      ctx.lineWidth = 1;

      const spacing = 50;

      for (let x = 0; x <= width; x += spacing) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }

      for (let y = 0; y <= height; y += spacing) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }
    }

    // ==================================================
    // AIRFOIL
    // ==================================================

    function drawAirfoil() {
      if (geometryPoints.length < 3) {
        return;
      }

      ctx.beginPath();

      ctx.moveTo(
        physicalToScreenX(geometryPoints[0].x),
        physicalToScreenY(geometryPoints[0].y)
      );

      for (let i = 1; i < geometryPoints.length; i++) {
        ctx.lineTo(
          physicalToScreenX(geometryPoints[i].x),
          physicalToScreenY(geometryPoints[i].y)
        );
      }

      ctx.closePath();

      const bodyGradient = ctx.createLinearGradient(
        0,
        physicalToScreenY(0.2),
        0,
        physicalToScreenY(-0.2)
      );

      bodyGradient.addColorStop(0, "#1a2732");
      bodyGradient.addColorStop(1, "#0b1117");

      ctx.fillStyle = bodyGradient;
      ctx.fill();

      ctx.strokeStyle = "rgba(220,237,246,0.62)";
      ctx.lineWidth = 1.4;
      ctx.stroke();
    }

    // ==================================================
    // BOUNDARY-LAYER VISUALISATION
    // ==================================================

    function outwardNormal(
      points: BoundaryLayerPoint[],
      index: number
    ) {
      const previous = points[Math.max(0, index - 1)];
      const next = points[Math.min(points.length - 1, index + 1)];
      const current = points[index];

      const tx = next.x - previous.x;
      const ty = next.y - previous.y;
      const length = Math.hypot(tx, ty);

      if (length < 1e-12) {
        return { x: 0, y: 0 };
      }

      let nx = -ty / length;
      let ny = tx / length;

      const radialX = current.x - airfoilCentroid.x;
      const radialY = current.y - airfoilCentroid.y;

      if (nx * radialX + ny * radialY < 0) {
        nx *= -1;
        ny *= -1;
      }

      return { x: nx, y: ny };
    }

    function drawBoundaryLayerBand(
      result: BoundaryLayerResult,
      fillColour: string,
      lineColour: string
    ) {
      const points = result.points;

      if (points.length < 3) {
        return;
      }

      const envelope: Point[] = [];

      for (let i = 0; i < points.length; i++) {
        const point = points[i];
        const normal = outwardNormal(points, i);

        /*
          Physical δ99 is used directly. The visual
          thickness is only clipped to prevent a failed
          correlation near separation from filling the
          whole canvas.
        */
        const displayedThickness = Math.min(
          point.delta99,
          0.08 * targetChord
        );

        envelope.push({
          x: point.x + normal.x * displayedThickness,
          y: point.y + normal.y * displayedThickness
        });
      }

      ctx.save();

      ctx.beginPath();

      ctx.moveTo(
        physicalToScreenX(points[0].x),
        physicalToScreenY(points[0].y)
      );

      for (let i = 1; i < points.length; i++) {
        ctx.lineTo(
          physicalToScreenX(points[i].x),
          physicalToScreenY(points[i].y)
        );
      }

      for (let i = envelope.length - 1; i >= 0; i--) {
        ctx.lineTo(
          physicalToScreenX(envelope[i].x),
          physicalToScreenY(envelope[i].y)
        );
      }

      ctx.closePath();
      ctx.fillStyle = fillColour;
      ctx.fill();

      ctx.beginPath();

      ctx.moveTo(
        physicalToScreenX(envelope[0].x),
        physicalToScreenY(envelope[0].y)
      );

      for (let i = 1; i < envelope.length; i++) {
        ctx.lineTo(
          physicalToScreenX(envelope[i].x),
          physicalToScreenY(envelope[i].y)
        );
      }

      ctx.strokeStyle = lineColour;
      ctx.lineWidth = 1.1;
      ctx.stroke();

      ctx.restore();
    }

    function drawSeparationMarker(
      separation: BoundaryLayerPoint | null,
      label: string,
      colour: string
    ) {
      if (!separation) {
        return;
      }

      const px = physicalToScreenX(separation.x);
      const py = physicalToScreenY(separation.y);

      ctx.save();

      ctx.beginPath();
      ctx.arc(px, py, 5, 0, 2 * Math.PI);
      ctx.fillStyle = colour;
      ctx.fill();

      ctx.beginPath();
      ctx.arc(px, py, 9, 0, 2 * Math.PI);
      ctx.strokeStyle = colour;
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.font = "600 10px system-ui, sans-serif";
      ctx.fillStyle = colour;
      ctx.fillText(
        `${label} sep  x/c=${separation.xOverC.toFixed(2)}`,
        px + 11,
        py - 8
      );

      ctx.restore();
    }

    function drawBoundaryLayers() {
      if (!showBoundaryLayer) {
        return;
      }

      drawBoundaryLayerBand(
        upperBoundaryLayer,
        "rgba(103,207,255,0.095)",
        "rgba(103,207,255,0.72)"
      );

      drawBoundaryLayerBand(
        lowerBoundaryLayer,
        "rgba(241,184,106,0.075)",
        "rgba(241,184,106,0.64)"
      );
    }

    function drawSeparationMarkers() {
      drawSeparationMarker(
        upperBoundaryLayer.separation,
        "U",
        "#67cfff"
      );

      drawSeparationMarker(
        lowerBoundaryLayer.separation,
        "L",
        "#f1b86a"
      );
    }


    // ==================================================
    // WAKE VISUALISATION
    // ==================================================

    function drawWakeVortices() {
      if (!showWake || !showWakeMarkers || wakeVortices.length === 0) {
        return;
      }

      ctx.save();

      for (const vortex of wakeVortices) {
        const px = physicalToScreenX(vortex.x);
        const py = physicalToScreenY(vortex.y);
        const core = wakeCoreRadius(vortex);

        const radiusPixels = Math.max(
          3,
          core /
          (xmax - xmin) *
          canvas.clientWidth
        );

        const colour = vortex.source === "upper"
          ? "103,207,255"
          : "241,184,106";

        const ageFade = Math.max(
          0.18,
          Math.min(0.75, 0.75 - 0.08 * vortex.age)
        );

        const halo = ctx.createRadialGradient(
          px,
          py,
          0,
          px,
          py,
          radiusPixels * 3.2
        );

        halo.addColorStop(
          0,
          `rgba(${colour},${0.24 * ageFade})`
        );

        halo.addColorStop(
          1,
          `rgba(${colour},0)`
        );

        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(
          px,
          py,
          radiusPixels * 3.2,
          0,
          2 * Math.PI
        );
        ctx.fill();

        ctx.beginPath();
        ctx.arc(
          px,
          py,
          Math.max(1.4, radiusPixels * 0.55),
          0,
          2 * Math.PI
        );

        ctx.fillStyle = `rgba(${colour},${ageFade})`;
        ctx.fill();
      }

      ctx.restore();
    }

    // ==================================================
    // PARTICLE / TRAIL DRAWING
    // ==================================================

    function drawTrailCanvas() {
      if (!showTrails) {
        return;
      }

      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.drawImage(trailCanvas, 0, 0);
      ctx.restore();
    }

    function drawParticles() {
      if (!showParticles) {
        return;
      }

      ctx.fillStyle = "rgba(220,243,255,0.68)";

      for (let i = 0; i < activeParticleCount; i++) {
        if (pointInsideAirfoil(particleX[i], particleY[i])) {
          continue;
        }

        ctx.fillRect(
          physicalToScreenX(particleX[i]),
          physicalToScreenY(particleY[i]),
          1.5,
          1.5
        );
      }
