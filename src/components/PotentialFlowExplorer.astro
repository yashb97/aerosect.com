<section class="potential-flow-explorer" data-potential-flow-explorer>

  <!-- ==================================================
       VISUALISATION
       ================================================== -->

  <div class="canvas-wrap">

    <canvas
      aria-label="Interactive potential flow visualisation"
    ></canvas>

    <div class="canvas-label">
      Drag flow elements · Hover to probe
    </div>

    <div
      class="probe-panel"
      data-probe-panel
      hidden
    >
      <div class="probe-title">
        Local flow
      </div>

      <div class="probe-grid">

        <span>x</span>
        <strong data-probe-x>—</strong>

        <span>y</span>
        <strong data-probe-y>—</strong>

        <span>u</span>
        <strong data-probe-u>—</strong>

        <span>v</span>
        <strong data-probe-v>—</strong>

        <span>|V|</span>
        <strong data-probe-speed>—</strong>

      </div>
    </div>

  </div>


  <!-- ==================================================
       CONTROLS
       ================================================== -->

  <div class="controls">

    <!-- ADD OBJECTS -->

    <div class="tool-section">

      <div class="section-title">
        Flow elements
      </div>

      <div class="toolbar">

        <button
          data-add-source
          type="button"
        >
          + Source
        </button>

        <button
          data-add-sink
          type="button"
        >
          + Sink
        </button>

        <button
          data-add-vortex
          type="button"
        >
          + Vortex
        </button>

        <button
          data-clear
          type="button"
          class="secondary-button"
        >
          Clear objects
        </button>

      </div>

    </div>


    <!-- UNIFORM FLOW -->

    <label class="control-row">

      <span>
        Freestream U∞
      </span>

      <output data-freestream-output>
        1.5 m/s
      </output>

      <input
        data-freestream
        type="range"
        min="0"
        max="5"
        step="0.1"
        value="1.5"
      />

    </label>


    <!-- OBJECT LIST -->

    <div class="object-section">

      <div class="section-title">
        Objects
      </div>

      <div
        class="object-list"
        data-object-list
      ></div>

    </div>


    <!-- SELECTED OBJECT -->

    <div
      class="selected-panel"
      data-selected-panel
    >

      <div class="selected-header">

        <div>
          <span class="selected-caption">
            Selected
          </span>

          <strong data-selected-name>
            None
          </strong>
        </div>

        <button
          data-delete
          type="button"
          class="danger-button"
          disabled
        >
          Delete
        </button>

      </div>


      <label class="control-row selected-control">

        <span data-strength-label>
          Strength
        </span>

        <output data-strength-output>
          —
        </output>

        <input
          data-strength
          type="range"
          min="-15"
          max="15"
          step="0.5"
          value="0"
          disabled
        />

      </label>


      <div class="selected-position">

        <div>
          <span>x</span>
          <strong data-selected-x>—</strong>
        </div>

        <div>
          <span>y</span>
          <strong data-selected-y>—</strong>
        </div>

      </div>

    </div>


    <!-- VISUAL LAYERS -->

    <div class="visual-controls">

      <div class="section-title">
        Visual layers
      </div>

      <div class="toggle-grid">

        <label class="toggle">

          <input
            data-particles-toggle
            type="checkbox"
            checked
          />

          <span>
            Particles
          </span>

        </label>


        <label class="toggle">

          <input
            data-trails-toggle
            type="checkbox"
          />

          <span>
            Trails
          </span>

        </label>


        <label class="toggle">

          <input
            data-streamlines-toggle
            type="checkbox"
            checked
          />

          <span>
            Streamlines
          </span>

        </label>


        <label class="toggle">

          <input
            data-vectors-toggle
            type="checkbox"
          />

          <span>
            Velocity vectors
          </span>

        </label>

      </div>

    </div>


    <!-- MODEL EXPLANATION -->

    <details class="model-details">

      <summary>
        Model assumptions
      </summary>

      <div class="model-content">

        <p>
          The velocity field is constructed by
          linear superposition of classical
          two-dimensional potential-flow solutions.
        </p>


        <div class="equation">
          Vtotal = V∞ + Σ Vsources + Σ Vvortices
        </div>


        <div class="equation">
          Source:
          ur = Q / (2πr)
        </div>


        <div class="equation">
          Vortex:
          uθ = Γ / (2πr)
        </div>


        <ul>

          <li>
            Two-dimensional flow
          </li>

          <li>
            Incompressible flow
          </li>

          <li>
            Inviscid model
          </li>

          <li>
            Linear superposition of elementary flows
          </li>

          <li>
            Ideal singularities are numerically
            regularised only inside a very small core
          </li>

          <li>
            No boundary layers, separation or viscous drag
          </li>

        </ul>


        <p class="model-note">
          This is a potential-flow teaching model,
          not a CFD solution. Outside the small
          numerical core surrounding each singularity,
          the classical analytical velocity equations
          are used directly.
        </p>

      </div>

    </details>


    <!-- BOTTOM -->

    <div class="bottom-row">

      <div class="model-info">
        <strong>Model:</strong>
        2-D potential-flow superposition
      </div>

      <div class="buttons">

        <button
          data-pause
          type="button"
        >
          Pause
        </button>

        <button
          data-reset
          type="button"
        >
          Reset
        </button>

      </div>

    </div>

  </div>

</section>


<script>

  // ====================================================
  // TYPES
  // ====================================================

  type ElementType =
    "source" |
    "vortex";


  type FlowElement = {

    id: number;

    type: ElementType;

    x: number;

    y: number;

    strength: number;

  };


  type Point = {

    x: number;

    y: number;

  };


  // ====================================================
  // COMPONENT INITIALISATION
  // ====================================================

  const explorers =
    document.querySelectorAll<HTMLElement>(
      "[data-potential-flow-explorer]"
    );


  for (const root of explorers) {


    // ==================================================
    // DOM
    // ==================================================

    const canvas =
      root.querySelector<HTMLCanvasElement>(
        "canvas"
      );


    const freestreamSlider =
      root.querySelector<HTMLInputElement>(
        "[data-freestream]"
      );


    const freestreamOutput =
      root.querySelector<HTMLOutputElement>(
        "[data-freestream-output]"
      );


    const addSourceButton =
      root.querySelector<HTMLButtonElement>(
        "[data-add-source]"
      );


    const addSinkButton =
      root.querySelector<HTMLButtonElement>(
        "[data-add-sink]"
      );


    const addVortexButton =
      root.querySelector<HTMLButtonElement>(
        "[data-add-vortex]"
      );


    const clearButton =
      root.querySelector<HTMLButtonElement>(
        "[data-clear]"
      );


    const deleteButton =
      root.querySelector<HTMLButtonElement>(
        "[data-delete]"
      );


    const strengthSlider =
      root.querySelector<HTMLInputElement>(
        "[data-strength]"
      );


    const strengthOutput =
      root.querySelector<HTMLOutputElement>(
        "[data-strength-output]"
      );


    const strengthLabel =
      root.querySelector<HTMLElement>(
        "[data-strength-label]"
      );


    const selectedName =
      root.querySelector<HTMLElement>(
        "[data-selected-name]"
      );


    const selectedXOutput =
      root.querySelector<HTMLElement>(
        "[data-selected-x]"
      );


    const selectedYOutput =
      root.querySelector<HTMLElement>(
        "[data-selected-y]"
      );


    const objectList =
      root.querySelector<HTMLElement>(
        "[data-object-list]"
      );


    const particlesToggle =
      root.querySelector<HTMLInputElement>(
        "[data-particles-toggle]"
      );


    const trailsToggle =
      root.querySelector<HTMLInputElement>(
        "[data-trails-toggle]"
      );


    const streamlinesToggle =
      root.querySelector<HTMLInputElement>(
        "[data-streamlines-toggle]"
      );


    const vectorsToggle =
      root.querySelector<HTMLInputElement>(
        "[data-vectors-toggle]"
      );


    const pauseButton =
      root.querySelector<HTMLButtonElement>(
        "[data-pause]"
      );


    const resetButton =
      root.querySelector<HTMLButtonElement>(
        "[data-reset]"
      );


    const probePanel =
      root.querySelector<HTMLElement>(
        "[data-probe-panel]"
      );


    const probeXOutput =
      root.querySelector<HTMLElement>(
        "[data-probe-x]"
      );


    const probeYOutput =
      root.querySelector<HTMLElement>(
        "[data-probe-y]"
      );


    const probeUOutput =
      root.querySelector<HTMLElement>(
        "[data-probe-u]"
      );


    const probeVOutput =
      root.querySelector<HTMLElement>(
        "[data-probe-v]"
      );


    const probeSpeedOutput =
      root.querySelector<HTMLElement>(
        "[data-probe-speed]"
      );


    if (
      !canvas ||
      !freestreamSlider ||
      !freestreamOutput ||
      !addSourceButton ||
      !addSinkButton ||
      !addVortexButton ||
      !clearButton ||
      !deleteButton ||
      !strengthSlider ||
      !strengthOutput ||
      !strengthLabel ||
      !selectedName ||
      !selectedXOutput ||
      !selectedYOutput ||
      !objectList ||
      !particlesToggle ||
      !trailsToggle ||
      !streamlinesToggle ||
      !vectorsToggle ||
      !pauseButton ||
      !resetButton ||
      !probePanel ||
      !probeXOutput ||
      !probeYOutput ||
      !probeUOutput ||
      !probeVOutput ||
      !probeSpeedOutput
    ) {
      continue;
    }


    const ctx =
      canvas.getContext(
        "2d"
      );


    if (!ctx) {
      continue;
    }


    // ==================================================
    // TRAIL CANVAS
    // ==================================================

    const trailCanvas =
      document.createElement(
        "canvas"
      );


    const trailCtx =
      trailCanvas.getContext(
        "2d"
      );


    if (!trailCtx) {
      continue;
    }


    // ==================================================
    // PHYSICAL DOMAIN
    // ==================================================

    const xmin = -6;
    const xmax = 6;

    const ymin = -3.5;
    const ymax = 3.5;


    /*
      Ideal source/vortex velocity tends to infinity
      at r = 0.

      We preserve the exact analytical solution
      outside this tiny core and cap only the
      singular region for numerical stability.
    */

    const numericalCoreRadius =
      0.07;


    const numericalCoreRadiusSquared =
      numericalCoreRadius *
      numericalCoreRadius;


    const particleCount =
      1800;


    const particleX =
      new Float32Array(
        particleCount
      );


    const particleY =
      new Float32Array(
        particleCount
      );


    const previousParticleX =
      new Float32Array(
        particleCount
      );


    const previousParticleY =
      new Float32Array(
        particleCount
      );


    // ==================================================
    // FLOW ELEMENTS
    // ==================================================

    let nextElementId =
      1;


    let elements:
      FlowElement[] =
      [];


    let selectedElementId:
      number | null =
      null;


    function makeElement(
      type: ElementType,
      x: number,
      y: number,
      strength: number
    ): FlowElement {

      return {

        id:
          nextElementId++,

        type,

        x,

        y,

        strength

      };
    }


    function setDefaultElements() {

      nextElementId =
        1;


      /*
        Equal source + sink in a uniform flow.

        This begins with a Rankine-oval-like
        flow topology and immediately demonstrates
        superposition.
      */

      elements = [

        makeElement(
          "source",
          -1.5,
          0,
          8
        ),

        makeElement(
          "source",
          1.5,
          0,
          -8
        )

      ];


      selectedElementId =
        elements[0].id;
    }


    setDefaultElements();


    // ==================================================
    // STATE
    // ==================================================

    let freestream =
      Number(
        freestreamSlider.value
      );


    let showParticles =
      particlesToggle.checked;


    let showTrails =
      trailsToggle.checked;


    let showStreamlines =
      streamlinesToggle.checked;


    let showVectors =
      vectorsToggle.checked;


    let running =
      true;


    let previousTime =
      performance.now();


    let draggingElementId:
      number | null =
      null;


    let probeActive =
      false;


    let probeX = 0;
    let probeY = 0;


    let streamlinesDirty =
      true;


    let cachedStreamlines:
      Point[][] =
      [];


    // ==================================================
    // COORDINATE CONVERSION
    // ==================================================

    function physicalToScreenX(
      x: number
    ) {

      return (
        (
          x - xmin
        ) /
        (
          xmax - xmin
        ) *
        canvas.clientWidth
      );
    }


    function physicalToScreenY(
      y: number
    ) {

      return (
        canvas.clientHeight -
        (
          y - ymin
        ) /
        (
          ymax - ymin
        ) *
        canvas.clientHeight
      );
    }


    function screenToPhysicalX(
      x: number
    ) {

      return (
        xmin +
        x /
        canvas.clientWidth *
        (
          xmax - xmin
        )
      );
    }


    function screenToPhysicalY(
      y: number
    ) {

      return (
        ymax -
        y /
        canvas.clientHeight *
        (
          ymax - ymin
        )
      );
    }


    // ==================================================
    // PHYSICS
    // ==================================================

    function velocityAt(
      x: number,
      y: number
    ) {

      let u =
        freestream;


      let v =
        0;


      for (
        const element
        of elements
      ) {

        const dx =
          x -
          element.x;


        const dy =
          y -
          element.y;


        const r2 =
          dx * dx +
          dy * dy;


        /*
          Exact classical potential-flow equations
          everywhere outside the numerical core.
        */

        const safeR2 =
          Math.max(
            r2,
            numericalCoreRadiusSquared
          );


        const coefficient =
          element.strength /
          (
            2 *
            Math.PI *
            safeR2
          );


        if (
          element.type ===
          "source"
        ) {

          /*
            2-D source/sink

            u = Q/(2πr²) * x
            v = Q/(2πr²) * y

            Q > 0 : source
            Q < 0 : sink
          */

          u +=
            coefficient *
            dx;


          v +=
            coefficient *
            dy;

        } else {

          /*
            Point vortex

            u = -Γ/(2πr²) * y
            v =  Γ/(2πr²) * x
          */

          u -=
            coefficient *
            dy;


          v +=
            coefficient *
            dx;
        }
      }


      return {
        u,
        v
      };
    }


    function speedAt(
      x: number,
      y: number
    ) {

      const velocity =
        velocityAt(
          x,
          y
        );


      return Math.hypot(
        velocity.u,
        velocity.v
      );
    }


    function tooCloseToElement(
      x: number,
      y: number
    ) {

      const radius =
        numericalCoreRadius *
        1.4;


      const radiusSquared =
        radius *
        radius;


      for (
        const element
        of elements
      ) {

        const dx =
          x -
          element.x;


        const dy =
          y -
          element.y;


        if (
          dx * dx +
          dy * dy <
          radiusSquared
        ) {

          return true;
        }
      }


      return false;
    }


    // ==================================================
    // PARTICLE SEEDING
    // ==================================================

    function positiveSources() {

      return elements.filter(
        element =>
          element.type ===
            "source" &&
          element.strength >
            0
      );
    }


    function seedNearSource(
      i: number
    ) {

      const sources =
        positiveSources();


      if (
        sources.length === 0
      ) {

        return false;
      }


      const source =
        sources[
          Math.floor(
            Math.random() *
            sources.length
          )
        ];


      const angle =
        Math.random() *
        Math.PI *
        2;


      const radius =
        0.12 +
        Math.random() *
        0.12;


      particleX[i] =
        source.x +
        Math.cos(
          angle
        ) *
        radius;


      particleY[i] =
        source.y +
        Math.sin(
          angle
        ) *
        radius;


      return true;
    }


    function seedParticle(
      i: number,
      anywhere = true
    ) {

      if (
        anywhere
      ) {

        particleX[i] =
          xmin +
          Math.random() *
          (
            xmax -
            xmin
          );


        particleY[i] =
          ymin +
          Math.random() *
          (
            ymax -
            ymin
          );

      } else {

        const choice =
          Math.random();


        /*
          Some particles re-enter upstream.

          Some appear throughout the domain.

          Some emerge close to positive sources,
          making source behaviour visually legible.
        */

        if (
          choice < 0.68
        ) {

          particleX[i] =
            xmin;


          particleY[i] =
            ymin +
            Math.random() *
            (
              ymax -
              ymin
            );

        } else if (
          choice < 0.88
        ) {

          particleX[i] =
            xmin +
            Math.random() *
            (
              xmax -
              xmin
            );


          particleY[i] =
            ymin +
            Math.random() *
            (
              ymax -
              ymin
            );

        } else {

          const seeded =
            seedNearSource(
              i
            );


          if (
            !seeded
          ) {

            particleX[i] =
              xmin;


            particleY[i] =
              ymin +
              Math.random() *
              (
                ymax -
                ymin
              );
          }
        }
      }


      previousParticleX[i] =
        particleX[i];


      previousParticleY[i] =
        particleY[i];
    }


    function seedAllParticles() {

      for (
        let i = 0;
        i < particleCount;
        i++
      ) {

        seedParticle(
          i,
          true
        );
      }


      clearTrails();
    }


    // ==================================================
    // PARTICLE INTEGRATION
    // ==================================================

    function updateParticles(
      dt: number
    ) {

      const substeps =
        2;


      const subDt =
        dt /
        substeps;


      for (
        let i = 0;
        i < particleCount;
        i++
      ) {

        previousParticleX[i] =
          particleX[i];


        previousParticleY[i] =
          particleY[i];


        for (
          let step = 0;
          step < substeps;
          step++
        ) {

          const x =
            particleX[i];


          const y =
            particleY[i];


          if (
            tooCloseToElement(
              x,
              y
            )
          ) {

            seedParticle(
              i,
              false
            );

            break;
          }


          /*
            RK2 midpoint integration.
          */

          const velocity1 =
            velocityAt(
              x,
              y
            );


          const midX =
            x +
            0.5 *
            velocity1.u *
            subDt;


          const midY =
            y +
            0.5 *
            velocity1.v *
            subDt;


          const velocity2 =
            velocityAt(
              midX,
              midY
            );


          particleX[i] =
            x +
            velocity2.u *
            subDt;


          particleY[i] =
            y +
            velocity2.v *
            subDt;


          const outside =
            particleX[i] <
              xmin ||
            particleX[i] >
              xmax ||
            particleY[i] <
              ymin ||
            particleY[i] >
              ymax;


          if (
            outside
          ) {

            seedParticle(
              i,
              false
            );

            break;
          }
        }
      }
    }


    // ==================================================
    // TRAILS
    // ==================================================

    const speedColours = [

      "rgba(72,121,170,0.28)",

      "rgba(70,147,202,0.34)",

      "rgba(72,172,222,0.40)",

      "rgba(83,195,236,0.48)",

      "rgba(110,213,247,0.58)",

      "rgba(155,227,252,0.70)",

      "rgba(213,244,255,0.82)"

    ];


    function speedBin(
      speed: number
    ) {

      const reference =
        Math.max(
          2,
          freestream *
          2.5
        );


      const normalized =
        Math.min(
          speed /
          reference,
          1
        );


      return Math.min(
        speedColours.length -
        1,
        Math.floor(
          normalized *
          speedColours.length
        )
      );
    }


    function clearTrails() {

      trailCtx.save();


      trailCtx.setTransform(
        1,
        0,
        0,
        1,
        0,
        0
      );


      trailCtx.clearRect(
        0,
        0,
        trailCanvas.width,
        trailCanvas.height
      );


      trailCtx.restore();
    }


    function fadeTrails() {

      trailCtx.save();


      trailCtx.setTransform(
        1,
        0,
        0,
        1,
        0,
        0
      );


      trailCtx.globalCompositeOperation =
        "destination-out";


      trailCtx.fillStyle =
        "rgba(0,0,0,0.055)";


      trailCtx.fillRect(
        0,
        0,
        trailCanvas.width,
        trailCanvas.height
      );


      trailCtx.restore();


      trailCtx.globalCompositeOperation =
        "source-over";
    }


    function drawNewTrailSegments() {

      if (
        !showTrails
      ) {
        return;
      }


      for (
        let bin = 0;
        bin <
          speedColours.length;
        bin++
      ) {

        trailCtx.beginPath();


        let hasSegments =
          false;


        for (
          let i = 0;
          i < particleCount;
          i++
        ) {

          const x0 =
            previousParticleX[i];


          const y0 =
            previousParticleY[i];


          const x1 =
            particleX[i];


          const y1 =
            particleY[i];


          /*
            Prevent re-seeded particles from drawing
            lines across the entire domain.
          */

          if (
            Math.abs(
              x1 - x0
            ) > 0.8 ||
            Math.abs(
              y1 - y0
            ) > 0.8
          ) {

            continue;
          }


          const mx =
            0.5 *
            (
              x0 + x1
            );


          const my =
            0.5 *
            (
              y0 + y1
            );


          const binForParticle =
            speedBin(
              speedAt(
                mx,
                my
              )
            );


          if (
            binForParticle !==
            bin
          ) {

            continue;
          }


          trailCtx.moveTo(
            physicalToScreenX(
              x0
            ),
            physicalToScreenY(
              y0
            )
          );


          trailCtx.lineTo(
            physicalToScreenX(
              x1
            ),
            physicalToScreenY(
              y1
            )
          );


          hasSegments =
            true;
        }


        if (
          hasSegments
        ) {

          trailCtx.strokeStyle =
            speedColours[bin];


          trailCtx.lineWidth =
            1;


          trailCtx.stroke();
        }
      }
    }


    // ==================================================
    // STREAMLINES
    // ==================================================

    function directionAt(
      x: number,
      y: number,
      sign = 1
    ) {

      const velocity =
        velocityAt(
          x,
          y
        );


      const magnitude =
        Math.hypot(
          velocity.u,
          velocity.v
        );


      if (
        magnitude <
        1e-8
      ) {

        return {
          x: 0,
          y: 0
        };
      }


      return {

        x:
          sign *
          velocity.u /
          magnitude,

        y:
          sign *
          velocity.v /
          magnitude

      };
    }


    function traceStreamline(
      seedX: number,
      seedY: number,
      directionSign = 1
    ) {

      const points:
        Point[] =
        [];


      let x =
        seedX;


      let y =
        seedY;


      const spatialStep =
        0.045;


      const maxSteps =
        520;


      for (
        let step = 0;
        step < maxSteps;
        step++
      ) {

        if (
          x < xmin ||
          x > xmax ||
          y < ymin ||
          y > ymax
        ) {
          break;
        }


        if (
          tooCloseToElement(
            x,
            y
          )
        ) {
          break;
        }


        points.push({
          x,
          y
        });


        const d1 =
          directionAt(
            x,
            y,
            directionSign
          );


        if (
          d1.x === 0 &&
          d1.y === 0
        ) {
          break;
        }


        const midX =
          x +
          0.5 *
          spatialStep *
          d1.x;


        const midY =
          y +
          0.5 *
          spatialStep *
          d1.y;


        const d2 =
          directionAt(
            midX,
            midY,
            directionSign
          );


        x +=
          spatialStep *
          d2.x;


        y +=
          spatialStep *
          d2.y;
      }


      return points;
    }


    function rebuildStreamlines() {

      cachedStreamlines =
        [];


      /*
        Freestream seeds.
      */

      const verticalSeedCount =
        21;


      for (
        let i = 0;
        i <
          verticalSeedCount;
        i++
      ) {

        const y =
          ymin +
          (
            i +
            0.5
          ) /
          verticalSeedCount *
          (
            ymax -
            ymin
          );


        const streamline =
          traceStreamline(
            xmin +
            0.02,
            y,
            1
          );


        if (
          streamline.length >
          2
        ) {

          cachedStreamlines.push(
            streamline
          );
        }
      }


      /*
        Additional streamlines around sources/sinks.

        Sources are integrated forwards.
        Sinks are integrated backwards.

        This allows isolated singularities to remain
        visually meaningful even when U∞ ≈ 0.
      */

      for (
        const element
        of elements
      ) {

        if (
          element.type !==
          "source"
        ) {
          continue;
        }


        const seedRadius =
          0.16;


        const radialSeedCount =
          12;


        const directionSign =
          element.strength >=
          0
            ? 1
            : -1;


        for (
          let i = 0;
          i <
            radialSeedCount;
          i++
        ) {

          const angle =
            i /
            radialSeedCount *
            Math.PI *
            2;


          const seedX =
            element.x +
            Math.cos(
              angle
            ) *
            seedRadius;


          const seedY =
            element.y +
            Math.sin(
              angle
            ) *
            seedRadius;


          const streamline =
            traceStreamline(
              seedX,
              seedY,
              directionSign
            );


          if (
            streamline.length >
            2
          ) {

            cachedStreamlines.push(
              streamline
            );
          }
        }
      }


      streamlinesDirty =
        false;
    }


    function drawStreamlines() {

      if (
        !showStreamlines
      ) {
        return;
      }


      if (
        streamlinesDirty
      ) {

        rebuildStreamlines();
      }


      ctx.save();


      ctx.strokeStyle =
        "rgba(195,225,242,0.19)";


      ctx.lineWidth =
        0.85;


      for (
        const streamline
        of cachedStreamlines
      ) {

        if (
          streamline.length <
          2
        ) {
          continue;
        }


        ctx.beginPath();


        ctx.moveTo(
          physicalToScreenX(
            streamline[0].x
          ),
          physicalToScreenY(
            streamline[0].y
          )
        );


        for (
          let i = 1;
          i <
            streamline.length;
          i++
        ) {

          ctx.lineTo(
            physicalToScreenX(
              streamline[i].x
            ),
            physicalToScreenY(
              streamline[i].y
            )
          );
        }


        ctx.stroke();
      }


      ctx.restore();
    }


    // ==================================================
    // VECTOR FIELD
    // ==================================================

    function drawArrow(
      x: number,
      y: number,
      dx: number,
      dy: number,
      opacity: number
    ) {

      const endX =
        x + dx;


      const endY =
        y + dy;


      const angle =
        Math.atan2(
          dy,
          dx
        );


      const headLength =
        4.5;


      ctx.strokeStyle =
        `rgba(210,235,248,${opacity})`;


      ctx.fillStyle =
        `rgba(210,235,248,${opacity})`;


      ctx.lineWidth =
        0.8;


      ctx.beginPath();


      ctx.moveTo(
        x,
        y
      );


      ctx.lineTo(
        endX,
        endY
      );


      ctx.stroke();


      ctx.beginPath();


      ctx.moveTo(
        endX,
        endY
      );


      ctx.lineTo(
        endX -
        headLength *
        Math.cos(
          angle -
          Math.PI /
          6
        ),
        endY -
        headLength *
        Math.sin(
          angle -
          Math.PI /
          6
        )
      );


      ctx.lineTo(
        endX -
        headLength *
        Math.cos(
          angle +
          Math.PI /
          6
        ),
        endY -
        headLength *
        Math.sin(
          angle +
          Math.PI /
          6
        )
      );


      ctx.closePath();


      ctx.fill();
    }


    function drawVectorField() {

      if (
        !showVectors
      ) {
        return;
      }


      const nx =
        Math.max(
          10,
          Math.floor(
            canvas.clientWidth /
            72
          )
        );


      const ny =
        Math.max(
          6,
          Math.floor(
            canvas.clientHeight /
            72
          )
        );


      const referenceSpeed =
        Math.max(
          2,
          freestream *
          2
        );


      for (
        let iy = 0;
        iy < ny;
        iy++
      ) {

        for (
          let ix = 0;
          ix < nx;
          ix++
        ) {

          const x =
            xmin +
            (
              ix +
              0.5
            ) /
            nx *
            (
              xmax -
              xmin
            );


          const y =
            ymin +
            (
              iy +
              0.5
            ) /
            ny *
            (
              ymax -
              ymin
            );


          if (
            tooCloseToElement(
              x,
              y
            )
          ) {
            continue;
          }


          const velocity =
            velocityAt(
              x,
              y
            );


          const magnitude =
            Math.hypot(
              velocity.u,
              velocity.v
            );


          if (
            magnitude <
            1e-8
          ) {
            continue;
          }


          const length =
            8 +
            15 *
            Math.min(
              magnitude /
              referenceSpeed,
              1
            );


          const opacity =
            0.15 +
            0.30 *
            Math.min(
              magnitude /
              referenceSpeed,
              1
            );


          drawArrow(
            physicalToScreenX(
              x
            ),
            physicalToScreenY(
              y
            ),
            velocity.u /
            magnitude *
            length,
            -velocity.v /
            magnitude *
            length,
            opacity
          );
        }
      }
    }


    // ==================================================
    // BACKGROUND
    // ==================================================

    function drawBackground() {

      const width =
        canvas.clientWidth;


      const height =
        canvas.clientHeight;


      const gradient =
        ctx.createLinearGradient(
          0,
          0,
          0,
          height
        );


      gradient.addColorStop(
        0,
        "#091018"
      );


      gradient.addColorStop(
        1,
        "#06090d"
      );


      ctx.fillStyle =
        gradient;


      ctx.fillRect(
        0,
        0,
        width,
        height
      );


      ctx.strokeStyle =
        "rgba(255,255,255,0.035)";


      ctx.lineWidth =
        1;


      const spacing =
        50;


      for (
        let x = 0;
        x <= width;
        x += spacing
      ) {

        ctx.beginPath();

        ctx.moveTo(
          x,
          0
        );

        ctx.lineTo(
          x,
          height
        );

        ctx.stroke();
      }


      for (
        let y = 0;
        y <= height;
        y += spacing
      ) {

        ctx.beginPath();

        ctx.moveTo(
          0,
          y
        );

        ctx.lineTo(
          width,
          y
        );

        ctx.stroke();
      }
    }


    // ==================================================
    // PARTICLE DRAWING
    // ==================================================

    function drawTrailCanvas() {

      if (
        !showTrails
      ) {
        return;
      }


      ctx.save();


      ctx.setTransform(
        1,
        0,
        0,
        1,
        0,
        0
      );


      ctx.drawImage(
        trailCanvas,
        0,
        0
      );


      ctx.restore();
    }


    function drawParticles() {

      if (
        !showParticles
      ) {
        return;
      }


      ctx.fillStyle =
        "rgba(220,243,255,0.66)";


      for (
        let i = 0;
        i <
          particleCount;
        i += 2
      ) {

        ctx.fillRect(
          physicalToScreenX(
            particleX[i]
          ),
          physicalToScreenY(
            particleY[i]
          ),
          1.5,
          1.5
        );
      }
    }


    // ==================================================
    // OBJECT MARKERS
    // ==================================================

    function elementDisplayName(
      element: FlowElement
    ) {

      if (
        element.type ===
        "vortex"
      ) {

        return "Vortex";
      }


      if (
        element.strength >
        0
      ) {

        return "Source";
      }


      if (
        element.strength <
        0
      ) {

        return "Sink";
      }


      return "Source / sink";
    }


    function markerColour(
      element: FlowElement
    ) {

      if (
        element.type ===
        "vortex"
      ) {

        return "#c896ff";
      }


      return element.strength >=
        0
        ? "#65d8b2"
        : "#ff8298";
    }


    function drawElementMarker(
      element: FlowElement
    ) {

      const x =
        physicalToScreenX(
          element.x
        );


      const y =
        physicalToScreenY(
          element.y
        );


      const selected =
        element.id ===
        selectedElementId;


      const colour =
        markerColour(
          element
        );


      // Halo

      const halo =
        ctx.createRadialGradient(
          x,
          y,
          0,
          x,
          y,
          selected
            ? 26
            : 21
        );


      halo.addColorStop(
        0,
        selected
          ? "rgba(255,255,255,0.16)"
          : "rgba(255,255,255,0.07)"
      );


      halo.addColorStop(
        1,
        "rgba(255,255,255,0)"
      );


      ctx.fillStyle =
        halo;


      ctx.beginPath();


      ctx.arc(
        x,
        y,
        selected
          ? 26
          : 21,
        0,
        Math.PI *
        2
      );


      ctx.fill();


      // Marker ring

      ctx.beginPath();


      ctx.arc(
        x,
        y,
        selected
          ? 14
          : 12,
        0,
        Math.PI *
        2
      );


      ctx.strokeStyle =
        colour;


      ctx.lineWidth =
        selected
          ? 2.4
          : 1.7;


      ctx.stroke();


      // Symbol

      ctx.fillStyle =
        colour;


      ctx.font =
        "600 16px system-ui, sans-serif";


      ctx.textAlign =
        "center";


      ctx.textBaseline =
        "middle";


      let symbol =
        "";


      if (
        element.type ===
        "vortex"
      ) {

        symbol =
          element.strength >=
          0
            ? "↺"
            : "↻";

      } else {

        symbol =
          element.strength >=
          0
            ? "+"
            : "−";
      }


      ctx.fillText(
        symbol,
        x,
        y + 0.5
      );


      ctx.textAlign =
        "start";


      ctx.textBaseline =
        "alphabetic";
    }


    function drawElements() {

      for (
        const element
        of elements
      ) {

        drawElementMarker(
          element
        );
      }
    }


    // ==================================================
    // FREESTREAM ARROW
    // ==================================================

    function drawFreestreamArrow() {

      if (
        freestream <=
        0.01
      ) {
        return;
      }


      const x = 25;
      const y = 32;


      const length =
        34 +
        freestream *
        9;


      ctx.strokeStyle =
        "rgba(255,255,255,0.58)";


      ctx.fillStyle =
        "rgba(255,255,255,0.68)";


      ctx.lineWidth =
        1.6;


      ctx.beginPath();


      ctx.moveTo(
        x,
        y
      );


      ctx.lineTo(
        x + length,
        y
      );


      ctx.stroke();


      ctx.beginPath();


      ctx.moveTo(
        x + length,
        y
      );


      ctx.lineTo(
        x + length - 7,
        y - 4
      );


      ctx.lineTo(
        x + length - 7,
        y + 4
      );


      ctx.closePath();


      ctx.fill();


      ctx.font =
        "12px system-ui, sans-serif";


      ctx.fillText(
        "U∞",
        x,
        y - 9
      );
    }


    // ==================================================
    // PROBE
    // ==================================================

    function updateProbe() {

      if (
        !probeActive ||
        draggingElementId !==
          null
      ) {

        probePanel.hidden =
          true;

        return;
      }


      probePanel.hidden =
        false;


      const velocity =
        velocityAt(
          probeX,
          probeY
        );


      probeXOutput.textContent =
        `${probeX.toFixed(2)} m`;


      probeYOutput.textContent =
        `${probeY.toFixed(2)} m`;


      probeUOutput.textContent =
        `${velocity.u.toFixed(2)} m/s`;


      probeVOutput.textContent =
        `${velocity.v.toFixed(2)} m/s`;


      probeSpeedOutput.textContent =
        `${Math.hypot(
          velocity.u,
          velocity.v
        ).toFixed(2)} m/s`;
    }


    function drawProbeMarker() {

      if (
        !probeActive ||
        draggingElementId !==
          null
      ) {
        return;
      }


      const x =
        physicalToScreenX(
          probeX
        );


      const y =
        physicalToScreenY(
          probeY
        );


      ctx.save();


      ctx.strokeStyle =
        "rgba(255,255,255,0.48)";


      ctx.lineWidth =
        1;


      ctx.beginPath();


      ctx.arc(
        x,
        y,
        4,
        0,
        Math.PI *
        2
      );


      ctx.stroke();


      ctx.beginPath();


      ctx.moveTo(
        x - 7,
        y
      );


      ctx.lineTo(
        x + 7,
        y
      );


      ctx.moveTo(
        x,
        y - 7
      );


      ctx.lineTo(
        x,
        y + 7
      );


      ctx.stroke();


      ctx.restore();
    }


    // ==================================================
    // FULL FRAME
    // ==================================================

    function draw() {

      drawBackground();

      drawStreamlines();

      drawVectorField();

      drawTrailCanvas();

      drawParticles();

      drawElements();

      drawFreestreamArrow();

      drawProbeMarker();
    }


    // ==================================================
    // ANIMATION
    // ==================================================

    function animate(
      now: number
    ) {

      const rawDt =
        (
          now -
          previousTime
        ) /
        1000;


      previousTime =
        now;


      const dt =
        Math.min(
          rawDt,
          0.03
        );


      if (
        running
      ) {

        updateParticles(
          dt
        );


        if (
          showTrails
        ) {

          fadeTrails();

          drawNewTrailSegments();

        } else {

          clearTrails();
        }
      }


      updateProbe();

      draw();


      requestAnimationFrame(
        animate
      );
    }


    // ==================================================
    // CANVAS SIZE
    // ==================================================

    function resizeCanvas() {

      const rect =
        canvas.getBoundingClientRect();


      const dpr =
        Math.min(
          window.devicePixelRatio ||
          1,
          2
        );


      const width =
        Math.max(
          1,
          Math.round(
            rect.width *
            dpr
          )
        );


      const height =
        Math.max(
          1,
          Math.round(
            rect.height *
            dpr
          )
        );


      if (
        canvas.width ===
          width &&
        canvas.height ===
          height
      ) {

        return;
      }


      canvas.width =
        width;


      canvas.height =
        height;


      trailCanvas.width =
        width;


      trailCanvas.height =
        height;


      ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
      );


      trailCtx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
      );


      clearTrails();

      streamlinesDirty =
        true;
    }


    // ==================================================
    // SELECTED OBJECT
    // ==================================================

    function selectedElement() {

      if (
        selectedElementId ===
        null
      ) {

        return null;
      }


      return (
        elements.find(
          element =>
            element.id ===
            selectedElementId
        ) ??
        null
      );
    }


    function updateSelectedPanel() {

      const element =
        selectedElement();


      if (
        !element
      ) {

        selectedName.textContent =
          "None";


        strengthOutput.value =
          "—";


        selectedXOutput.textContent =
          "—";


        selectedYOutput.textContent =
          "—";


        strengthSlider.disabled =
          true;


        deleteButton.disabled =
          true;


        return;
      }


      selectedName.textContent =
        `${elementDisplayName(
          element
        )} ${element.id}`;


      strengthSlider.disabled =
        false;


      deleteButton.disabled =
        false;


      strengthSlider.value =
        String(
          element.strength
        );


      if (
        element.type ===
        "vortex"
      ) {

        strengthLabel.textContent =
          "Circulation Γ";

      } else {

        strengthLabel.textContent =
          "Source strength Q";
      }


      strengthOutput.value =
        `${element.strength.toFixed(
          1
        )} m²/s`;


      selectedXOutput.textContent =
        `${element.x.toFixed(
          2
        )} m`;


      selectedYOutput.textContent =
        `${element.y.toFixed(
          2
        )} m`;
    }


    // ==================================================
    // OBJECT LIST
    // ==================================================

    function renderObjectList() {

      objectList.replaceChildren();


      if (
        elements.length ===
        0
      ) {

        const empty =
          document.createElement(
            "span"
          );


        empty.className =
          "empty-objects";


        empty.textContent =
          "No flow elements — add one above.";


        objectList.append(
          empty
        );


        return;
      }


      for (
        const element
        of elements
      ) {

        const button =
          document.createElement(
            "button"
          );


        button.type =
          "button";


        button.className =
          "object-chip";


        if (
          element.id ===
          selectedElementId
        ) {

          button.classList.add(
            "selected"
          );
        }


        const dot =
          document.createElement(
            "span"
          );


        dot.className =
          "object-dot";


        dot.style.background =
          markerColour(
            element
          );


        const text =
          document.createElement(
            "span"
          );


        text.textContent =
          `${elementDisplayName(
            element
          )} ${element.id}`;


        button.append(
          dot,
          text
        );


        button.addEventListener(
          "click",
          () => {

            selectedElementId =
              element.id;


            updateSelectedPanel();

            renderObjectList();
          }
        );


        objectList.append(
          button
        );
      }
    }


    function refreshObjectUI() {

      updateSelectedPanel();

      renderObjectList();
    }


    // ==================================================
    // MODEL CHANGED
    // ==================================================

    function fieldChanged(
      clearParticleTrails =
        true
    ) {

      streamlinesDirty =
        true;


      if (
        clearParticleTrails
      ) {

        clearTrails();
      }
    }


    // ==================================================
    // ADDING OBJECTS
    // ==================================================

    function addElement(
      element: FlowElement
    ) {

      /*
        Bound object count so performance remains
        predictable and the interface does not turn
        into an unreadable pile of singularities.
      */

      if (
        elements.length >=
        10
      ) {

        return;
      }


      elements.push(
        element
      );


      selectedElementId =
        element.id;


      fieldChanged();

      refreshObjectUI();
    }


    addSourceButton.addEventListener(
      "click",
      () => {

        addElement(
          makeElement(
            "source",
            0,
            0.5,
            6
          )
        );
      }
    );


    addSinkButton.addEventListener(
      "click",
      () => {

        addElement(
          makeElement(
            "source",
            0,
            -0.5,
            -6
          )
        );
      }
    );


    addVortexButton.addEventListener(
      "click",
      () => {

        addElement(
          makeElement(
            "vortex",
            0,
            0,
            7
          )
        );
      }
    );


    // ==================================================
    // DELETE / CLEAR
    // ==================================================

    deleteButton.addEventListener(
      "click",
      () => {

        if (
          selectedElementId ===
          null
        ) {
          return;
        }


        elements =
          elements.filter(
            element =>
              element.id !==
              selectedElementId
          );


        selectedElementId =
          elements.length >
          0
            ? elements[
                elements.length -
                1
              ].id
            : null;


        fieldChanged();

        seedAllParticles();

        refreshObjectUI();
      }
    );


    clearButton.addEventListener(
      "click",
      () => {

        elements =
          [];


        selectedElementId =
          null;


        fieldChanged();

        seedAllParticles();

        refreshObjectUI();
      }
    );


    // ==================================================
    // CONTROLS
    // ==================================================

    freestreamSlider.addEventListener(
      "input",
      () => {

        freestream =
          Number(
            freestreamSlider.value
          );


        freestreamOutput.value =
          `${freestream.toFixed(
            1
          )} m/s`;


        fieldChanged();
      }
    );


    strengthSlider.addEventListener(
      "input",
      () => {

        const element =
          selectedElement();


        if (
          !element
        ) {
          return;
        }


        element.strength =
          Number(
            strengthSlider.value
          );


        fieldChanged();

        refreshObjectUI();
      }
    );


    particlesToggle.addEventListener(
      "change",
      () => {

        showParticles =
          particlesToggle.checked;
      }
    );


    trailsToggle.addEventListener(
      "change",
      () => {

        showTrails =
          trailsToggle.checked;


        if (
          !showTrails
        ) {

          clearTrails();
        }
      }
    );


    streamlinesToggle.addEventListener(
      "change",
      () => {

        showStreamlines =
          streamlinesToggle.checked;
      }
    );


    vectorsToggle.addEventListener(
      "change",
      () => {

        showVectors =
          vectorsToggle.checked;
      }
    );


    // ==================================================
    // PAUSE / RESET
    // ==================================================

    pauseButton.addEventListener(
      "click",
      () => {

        running =
          !running;


        pauseButton.textContent =
          running
            ? "Pause"
            : "Play";
      }
    );


    resetButton.addEventListener(
      "click",
      () => {

        freestreamSlider.value =
          "1.5";


        freestream =
          1.5;


        freestreamOutput.value =
          "1.5 m/s";


        particlesToggle.checked =
          true;


        trailsToggle.checked =
          false;


        streamlinesToggle.checked =
          true;


        vectorsToggle.checked =
          false;


        showParticles =
          true;


        showTrails =
          false;


        showStreamlines =
          true;


        showVectors =
          false;


        setDefaultElements();


        running =
          true;


        pauseButton.textContent =
          "Pause";


        probeActive =
          false;


        streamlinesDirty =
          true;


        seedAllParticles();

        refreshObjectUI();
      }
    );


    // ==================================================
    // HIT TESTING
    // ==================================================

    function elementAtScreenPosition(
      px: number,
      py: number
    ) {

      let best:
        FlowElement | null =
        null;


      let bestDistance =
        Infinity;


      for (
        const element
        of elements
      ) {

        const ex =
          physicalToScreenX(
            element.x
          );


        const ey =
          physicalToScreenY(
            element.y
          );


        const distance =
          Math.hypot(
            px - ex,
            py - ey
          );


        if (
          distance <
            22 &&
          distance <
            bestDistance
        ) {

          best =
            element;


          bestDistance =
            distance;
        }
      }


      return best;
    }


    // ==================================================
    // POINTER
    // ==================================================

    function pointerScreenPosition(
      event: PointerEvent
    ) {

      const rect =
        canvas.getBoundingClientRect();


      return {

        x:
          Math.max(
            0,
            Math.min(
              rect.width,
              event.clientX -
              rect.left
            )
          ),

        y:
          Math.max(
            0,
            Math.min(
              rect.height,
              event.clientY -
              rect.top
            )
          )

      };
    }


    function updateProbeFromPointer(
      event: PointerEvent
    ) {

      const pointer =
        pointerScreenPosition(
          event
        );


      probeX =
        screenToPhysicalX(
          pointer.x
        );


      probeY =
        screenToPhysicalY(
          pointer.y
        );
    }


    canvas.addEventListener(
      "pointerenter",
      event => {

        probeActive =
          true;


        updateProbeFromPointer(
          event
        );
      }
    );


    canvas.addEventListener(
      "pointermove",
      event => {

        updateProbeFromPointer(
          event
        );


        probeActive =
          true;


        if (
          draggingElementId ===
          null
        ) {
          return;
        }


        const element =
          elements.find(
            candidate =>
              candidate.id ===
              draggingElementId
          );


        if (
          !element
        ) {
          return;
        }


        element.x =
          Math.max(
            xmin,
            Math.min(
              xmax,
              probeX
            )
          );


        element.y =
          Math.max(
            ymin,
            Math.min(
              ymax,
              probeY
            )
          );


        fieldChanged();

        updateSelectedPanel();
      }
    );


    canvas.addEventListener(
      "pointerleave",
      () => {

        if (
          draggingElementId ===
          null
        ) {

          probeActive =
            false;
        }
      }
    );


    canvas.addEventListener(
      "pointerdown",
      event => {

        const pointer =
          pointerScreenPosition(
            event
          );


        const element =
          elementAtScreenPosition(
            pointer.x,
            pointer.y
          );


        if (
          !element
        ) {

          probeActive =
            true;


          updateProbeFromPointer(
            event
          );


          return;
        }


        selectedElementId =
          element.id;


        draggingElementId =
          element.id;


        probeActive =
          false;


        canvas.setPointerCapture(
          event.pointerId
        );


        refreshObjectUI();
      }
    );


    canvas.addEventListener(
      "pointerup",
      event => {

        draggingElementId =
          null;


        probeActive =
          true;


        updateProbeFromPointer(
          event
        );


        if (
          canvas.hasPointerCapture(
            event.pointerId
          )
        ) {

          canvas.releasePointerCapture(
            event.pointerId
          );
        }
      }
    );


    canvas.addEventListener(
      "pointercancel",
      () => {

        draggingElementId =
          null;


        probeActive =
          false;
      }
    );


    // ==================================================
    // RESIZE OBSERVER
    // ==================================================

    if (
      "ResizeObserver" in
      window
    ) {

      const observer =
        new ResizeObserver(
          resizeCanvas
        );


      observer.observe(
        canvas
      );

    } else {

      window.addEventListener(
        "resize",
        resizeCanvas
      );
    }


    // ==================================================
    // START
    // ==================================================

    resizeCanvas();

    seedAllParticles();

    refreshObjectUI();


    requestAnimationFrame(
      animate
    );

  }

</script>


