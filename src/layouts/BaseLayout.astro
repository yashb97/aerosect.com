---
import "../styles/global.css";

const { title = "Aerosect" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <main class="page">
      <nav class="nav">
        <a class="logo" href="/" aria-label="Aerosect homepage">
  <img src="/images/aerosect-logo.png" alt="Aerosect" />
</a>
        <div class="links">
          <a href="/">Home</a>
          <a href="/articles">Articles</a>
          <a href="/about">About</a>
        </div>
      </nav>

      <slot />
    </main>
  </body>
</html>

<style is:global>
  .page {
    min-height: 100vh;
    padding: 32px;
    background:
      radial-gradient(circle at 20% 20%, rgba(57, 120, 255, 0.25), transparent 30%),
      radial-gradient(circle at 80% 10%, rgba(0, 255, 209, 0.12), transparent 30%),
      var(--bg);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .logo img {
    height: 34px;
    width: auto;
    display: block;
    filter: invert(1);
  }

  .links {
    display: flex;
    gap: 24px;
  }

  .links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--text);
  }
</style>