---
import "../styles/global.css";
import { Image, getImage } from "astro:assets";
import siteBackground from "../assets/backgrounds/homepage-dream.jpg";

const {
  title = "Aerosect",
  description = "Aerosect is a visual article archive for aerospace, technology, history, ideas, travel, and the stories that make engineering worth exploring.",
  image = siteBackground,
  imageAlt = "Aerosect visual article archive",
  ogType = "website",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImage = await getImage({
  src: image,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 90,
});
const socialImageUrl = new URL(socialImage.src, Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon2 - white.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Aerosect" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>

  <body>
    <main class="page">
      <div class="site-background" aria-hidden="true">
        <Image
          class="site-background-image"
          src={siteBackground}
          alt=""
          loading="eager"
          decoding="async"
          sizes="100vw"
          widths={[960, 1280, 1600, 1920, 2400]}
        />
      </div>

      <nav class="nav" aria-label="Main navigation">
        <button
          class="menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-controls="site-menu"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <a class="logo" href="/" aria-label="Aerosect homepage">
          <img src="/images/aerosect-logo-white.svg" alt="Aerosect" />
        </a>

        <div class="menu-panel" id="site-menu" aria-hidden="true">
          <a href="/">Home</a>
          <a href="/articles">Articles</a>
          <a href="/topics">Topics</a>
          <a href="/about">About</a>
        </div>
      </nav>

      <slot />

      <footer class="footer">
        <p>© {new Date().getFullYear()} Aerosect. All rights reserved.</p>

        <div class="footer-links">
          <a href="/articles">Articles</a>
          <a href="/topics">Topics</a>
          <a href="/about">About</a>
        </div>
      </footer>
    </main>

    <script>
      const nav = document.querySelector(".nav");
      const menuToggle = document.querySelector(".menu-toggle");
      const menuPanel = document.querySelector(".menu-panel");

      const updateHeader = () => {
        nav?.classList.toggle("is-scrolled", window.scrollY > 24);
      };

      const closeMenu = () => {
        menuPanel?.setAttribute("aria-hidden", "true");
        menuToggle?.setAttribute("aria-expanded", "false");
        nav?.classList.remove("menu-is-open");
      };

      const openMenu = () => {
        menuPanel?.setAttribute("aria-hidden", "false");
        menuToggle?.setAttribute("aria-expanded", "true");
        nav?.classList.add("menu-is-open", "is-scrolled");
      };

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          closeMenu();
          updateHeader();
        } else {
          openMenu();
        }
      });

      menuPanel?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
          updateHeader();
        }
      });

      window.addEventListener("scroll", updateHeader, { passive: true });
      updateHeader();
    </script>
  </body>
</html>

<style is:global>
  .page {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    padding: 32px;
    background: transparent;
  }

  .site-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: #000;
    pointer-events: none;
  }

  .site-background::before,
  .site-background::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .site-background::before {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(5, 7, 13, 0.68), rgba(5, 7, 13, 0.34) 44%, rgba(5, 7, 13, 0.46)),
      linear-gradient(180deg, rgba(5, 7, 13, 0.38), rgba(5, 7, 13, 0.12) 38%, rgba(5, 7, 13, 0.7));
  }

  .site-background::after {
    z-index: 2;
    background:
      radial-gradient(circle at 18% 24%, rgba(125, 211, 252, 0.14), transparent 28%),
      radial-gradient(circle at 72% 62%, rgba(245, 158, 11, 0.16), transparent 34%);
    mix-blend-mode: screen;
    opacity: 0.52;
  }

  .site-background-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92) brightness(0.92) contrast(1.02);
    transform: scale(1.03);
  }

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    isolation: isolate;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 58px;
    padding: 8px 32px;
    background: rgba(0, 0, 0, 0);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0);
    transition:
      background 0.32s ease,
      box-shadow 0.32s ease,
      backdrop-filter 0.32s ease;
  }

  .nav::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.32s ease;
  }

  .nav::after {
    content: "";
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: -76px;
    height: 76px;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.64) 34%,
      rgba(0, 0, 0, 0.28) 68%,
      rgba(0, 0, 0, 0)
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.32s ease;
  }

  .nav > * {
    position: relative;
    z-index: 1;
  }

  .nav.is-scrolled,
  .nav.menu-is-open {
    background: #000;
    box-shadow: none;
    backdrop-filter: blur(14px);
  }

  .nav.is-scrolled::after,
  .nav.menu-is-open::after {
    opacity: 1;
  }

  .nav.is-scrolled::before,
  .nav.menu-is-open::before {
    opacity: 1;
  }

  .menu-toggle {
    position: absolute;
    z-index: 5;
    left: 32px;
    top: 50%;
    width: 40px;
    height: 40px;
    padding: 9px 9px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0);
    color: var(--text);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .menu-toggle:hover,
  .menu-toggle:focus-visible {
    border-color: transparent;
  }

  .menu-toggle:focus-visible,
  .menu-panel a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .menu-toggle span {
    position: relative;
    z-index: 1;
    display: block;
    height: 2px;
    margin: 5px 0;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .menu-toggle::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid var(--card-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    opacity: 0;
    transform: translateY(2px);
    transition: opacity 0.2s ease;
  }

  .menu-toggle:hover::before,
  .menu-toggle:focus-visible::before {
    opacity: 1;
  }

  .logo {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transform: translateY(-3px);
  }

  .logo img {
    height: 28px;
    width: auto;
    display: block;
  }

  .menu-panel {
    position: fixed;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(340px, 82vw);
    height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 8px;
    padding: 104px 32px 32px;
    border: 0;
    border-right: 1px solid var(--card-border);
    border-radius: 0;
    background: #000;
    background-color: #000;
    box-shadow: 28px 0 90px rgba(0, 0, 0, 0.42);
    isolation: isolate;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-18px);
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;
  }

  .menu-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
    pointer-events: none;
  }

  .menu-panel[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .menu-panel a {
    position: relative;
    z-index: 1;
    padding: 16px 0;
    color: var(--text-muted);
    border-radius: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .menu-panel a:hover {
    color: var(--text);
  }

  .footer {
    width: 100%;
    max-width: none;
    margin: 120px 0 0;
    padding: 32px 0 0;
    border-top: 1px solid var(--card-border);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .footer p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a {
    color: var(--text-soft);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  @media (max-width: 700px) {
    .footer {
      flex-direction: column;
    }

    .footer-links {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 700px) {
    .page {
      padding: 24px;
    }

    .nav {
      min-height: 54px;
      padding: 8px 24px;
    }

    .menu-toggle {
      left: 20px;
      width: 38px;
      height: 38px;
    }

    .logo img {
      height: 22px;
    }

    .menu-panel {
      width: min(300px, 86vw);
      padding: 92px 24px 28px;
    }
  }
</style>
