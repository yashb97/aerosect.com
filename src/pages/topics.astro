---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles", ({ data }) => !data.draft);

const topics = Array.from(
  new Map(
    articles.map((article) => [
      article.data.topicSlug,
      {
        name: article.data.topic,
        slug: article.data.topicSlug,
        count: articles.filter((a) => a.data.topicSlug === article.data.topicSlug).length,
      },
    ])
  ).values()
);
---

<BaseLayout
  title="Topics | Aerosect"
  description="Explore Aerosect articles by topic, including aeroacoustics, airport noise, simulation, modelling workflows, and engineering systems."
>
  <section class="intro">
    <p class="eyebrow">Explore by Topic</p>
    <h1>Topics</h1>
    <p>
      Browse Aerosect articles by aerospace subject area, from aeroacoustics and airport noise
      to simulation, modelling workflows, and engineering systems.
    </p>
  </section>

  <section class="topic-grid">
    {topics.map((topic) => (
      <a class="topic-card" href={`/topics/${topic.slug}`}>
        <p class="label">{topic.count} article{topic.count === 1 ? "" : "s"}</p>
        <h2>{topic.name}</h2>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: var(--max-width);
    margin: 110px auto 0;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--card-border);
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(3.5rem, 9vw, 7rem);
    line-height: 0.95;
    margin: 16px 0 24px;
  }

  .intro p {
    max-width: 760px;
    color: var(--text-muted);
    font-size: 1.18rem;
    line-height: 1.7;
  }

  .topic-grid {
    max-width: var(--max-width);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
    margin: 56px auto 0;
  }

  .topic-card {
    display: block;
    padding: 32px;
    min-height: 180px;
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.035)),
      var(--card);
    border: 1px solid var(--card-border);
    text-decoration: none;
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .topic-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-soft);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
  }

  .label {
    color: var(--accent);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
  }

  .topic-card h2 {
    margin: 22px 0 0;
    color: var(--text);
    font-size: 1.7rem;
    line-height: 1.1;
  }
</style>