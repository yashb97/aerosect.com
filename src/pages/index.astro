---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Aerosect | Aerospace Knowledge Archive">
  <section class="hero">
    <p class="eyebrow">Aerospace · Aeroacoustics · Simulation · Engineering</p>
    <h1>Exploring the ideas shaping aerospace engineering.</h1>
    <p class="subtitle">
      Aerosect is a technical archive for articles, explainers, and visual essays
      on aerodynamics, aeroacoustics, aircraft noise, simulation, and engineering systems.
    </p>

    <div class="actions">
      <a class="button primary" href="/articles">View Articles</a>
      <a class="button secondary" href="/about">About Aerosect</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 900px;
    margin-top: 140px;
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.95;
    margin: 20px 0;
    max-width: 1000px;
  }

  .subtitle {
    max-width: 680px;
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 16px;
    margin-top: 36px;
  }

  .button {
    padding: 14px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }

  .primary {
    background: var(--text);
    color: var(--bg);
  }

  .secondary {
    border: 1px solid var(--card-border);
    color: var(--text);
  }
</style>