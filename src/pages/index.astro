---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import homepageDream from "../assets/backgrounds/homepage-dream.jpg";

const articles = await getCollection("articles", ({ data }) => !data.draft);

articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredArticles = articles.slice(0, 2);
---

<BaseLayout title="Aerosect | Aerospace Knowledge Archive">
  <div class="home-background" aria-hidden="true">
    <Image
      class="home-background-image"
      src={homepageDream}
      alt=""
      loading="eager"
      decoding="async"
      sizes="100vw"
      widths={[960, 1280, 1600, 1920, 2400]}
    />
  </div>

  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Aerospace · Ideas · Simulation · Stories</p>

      <h1>Exploring the ideas shaping aerospace engineering.</h1>

      <p class="subtitle">
        Aerosect is a visual knowledge archive for aerospace, aeroacoustics,
        aircraft noise, simulation, engineering systems, and the wider ideas that
        make technology worth thinking about.
      </p>

      <div class="actions">
        <a class="button primary" href="/articles">View Articles</a>
        <a class="button secondary" href="/topics">Explore Topics</a>
      </div>
    </div>
  </section>

  <section class="featured">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Featured Articles</p>
        <h2>Latest from the archive</h2>
      </div>

      <a class="section-link" href="/articles">View all articles →</a>
    </div>

    <div class="featured-grid">
      {featuredArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .home-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: #000;
    pointer-events: none;
  }

  .home-background::before,
  .home-background::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-background::before {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(5, 7, 13, 0.68), rgba(5, 7, 13, 0.34) 44%, rgba(5, 7, 13, 0.46)),
      linear-gradient(180deg, rgba(5, 7, 13, 0.38), rgba(5, 7, 13, 0.12) 38%, rgba(5, 7, 13, 0.7));
  }

  .home-background::after {
    z-index: 2;
    background:
      radial-gradient(circle at 18% 24%, rgba(125, 211, 252, 0.14), transparent 28%),
      radial-gradient(circle at 72% 62%, rgba(245, 158, 11, 0.16), transparent 34%);
    mix-blend-mode: screen;
    opacity: 0.52;
  }

  .home-background-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92) brightness(0.92) contrast(1.02);
    transform: scale(1.03);
  }

  .home-hero {
    display: block;
    position: relative;
    z-index: 2;
    width: min(860px, 100%);
    margin: 140px 0 0;
    color: var(--text);
  }

  .hero-copy {
    max-width: 820px;
    text-align: left;
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    line-height: 1;
    margin: 20px 0;
    max-width: 860px;
    text-align: left;
  }

  .subtitle {
    max-width: 680px;
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 16px;
    margin-top: 36px;
  }

  .button {
    padding: 14px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }

  .primary {
    background: var(--text);
    color: var(--bg);
  }

  .secondary {
    border: 1px solid var(--card-border);
    color: var(--text);
  }

  .featured {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: none;
    margin: 140px 0 0;
    padding-top: 56px;
    border-top: 1px solid var(--card-border);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 12px 0 0;
    line-height: 1;
  }

  .section-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  :global(.page) {
    position: relative;
    isolation: isolate;
    background: transparent;
  }

  @media (max-width: 700px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .section-heading {
    margin-bottom: 32px;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 12px 0 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) {
    .home-hero {
      margin-top: 100px;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
