---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles", ({ data }) => !data.draft);

articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredArticles = articles.slice(0, 2);
---

<BaseLayout
  title="Aerosect | Visual Article Archive"
  description="Aerosect is a visual article archive for aerospace, technology, history, ideas, travel, and curious stories connected to flight and engineering."
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Aerospace · Ideas · Simulation · Stories</p>

      <h1>Exploring flight, ideas, and the stories behind technology.</h1>

      <p class="subtitle">
        Aerosect is a visual article archive for aerospace, technology, history,
        culture, travel, and the wider ideas that make engineering worth thinking
        about.
      </p>

      <div class="actions">
        <a class="button primary" href="/articles">View Articles</a>
        <a class="button secondary" href="/topics">Explore Topics</a>
      </div>
    </div>
  </section>

  <section class="featured">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Featured Articles</p>
        <h2>Latest from the archive</h2>
      </div>

      <a class="section-link" href="/articles">View all articles →</a>
    </div>

    <div class="featured-grid">
      {featuredArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .home-hero {
    display: block;
    position: relative;
    z-index: 2;
    width: min(860px, 100%);
    margin: 140px 0 0;
    color: var(--text);
  }

  .hero-copy {
    max-width: 820px;
    text-align: left;
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    line-height: 1;
    margin: 20px 0;
    max-width: 860px;
    text-align: left;
  }

  .subtitle {
    max-width: 680px;
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 16px;
    margin-top: 36px;
  }

  .button {
    padding: 14px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }

  .primary {
    background: var(--text);
    color: var(--bg);
  }

  .secondary {
    border: 1px solid var(--card-border);
    color: var(--text);
  }

  .featured {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: none;
    margin: 140px 0 0;
    padding-top: 56px;
    border-top: 1px solid var(--card-border);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 12px 0 0;
    line-height: 1;
  }

  .section-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 700px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .section-heading {
    margin-bottom: 32px;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 12px 0 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) {
    .home-hero {
      margin-top: 100px;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
