---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles", ({ data }) => !data.draft);

articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredArticles = articles.slice(0, 2);
---

<BaseLayout title="Aerosect | Aerospace Knowledge Archive">
  <section class="hero">
    <p class="eyebrow">Aerospace · Aeroacoustics · Simulation · Engineering</p>
    <h1>Exploring the ideas shaping aerospace engineering.</h1>
    <p class="subtitle">
      Aerosect is a technical archive for articles, explainers, and visual essays
      on aerodynamics, aeroacoustics, aircraft noise, simulation, and engineering systems.
    </p>

    <div class="actions">
      <a class="button primary" href="/articles">View Articles</a>
      <a class="button secondary" href="/about">About Aerosect</a>
    </div>
  </section>

  <section class="featured">
  <div class="section-heading">
    <p class="eyebrow">Featured Articles</p>
    <h2>Latest from the archive</h2>
  </div>

  <div class="featured-grid">
    {featuredArticles.map((article) => (
      <ArticleCard article={article} />
    ))}
  </div>
</section>

</BaseLayout>

<style>
  .hero {
    max-width: 900px;
    margin-top: 140px;
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.95;
    margin: 20px 0;
    max-width: 1000px;
  }

  .subtitle {
    max-width: 680px;
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 16px;
    margin-top: 36px;
  }

  .button {
    padding: 14px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }

  .primary {
    background: var(--text);
    color: var(--bg);
  }

  .secondary {
    border: 1px solid var(--card-border);
    color: var(--text);
  }

  .featured {
    max-width: var(--max-width);
    margin: 120px auto 0;
  }

  .section-heading {
    margin-bottom: 32px;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 12px 0 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
</style>