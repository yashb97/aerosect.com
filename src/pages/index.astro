---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles", ({ data }) => !data.draft);

articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredArticles = articles.slice(0, 2);
---

<BaseLayout title="Aerosect | Aerospace Knowledge Archive">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Aerospace · Ideas · Simulation · Stories</p>

      <h1>Exploring the ideas shaping aerospace engineering.</h1>

      <p class="subtitle">
        Aerosect is a visual knowledge archive for aerospace, aeroacoustics,
        aircraft noise, simulation, engineering systems, and the wider ideas that
        make technology worth thinking about.
      </p>

      <div class="actions">
        <a class="button primary" href="/articles">View Articles</a>
        <a class="button secondary" href="/topics">Explore Topics</a>
      </div>
    </div>

    <div class="hero-panel" aria-hidden="true">
      <div class="panel-grid">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>

      <div class="panel-content">
        <p>Archive focus</p>
        <h2>Aerospace ideas, made visual.</h2>
      </div>
    </div>
  </section>

  <section class="featured">
  <div class="section-heading">
    <p class="eyebrow">Featured Articles</p>
    <h2>Latest from the archive</h2>
  </div>

  <div class="featured-grid">
    {featuredArticles.map((article) => (
      <ArticleCard article={article} />
    ))}
  </div>
</section>

</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 64px;
    align-items: center;
    max-width: var(--max-width);
    margin: 140px auto 0;
  }

  .hero-copy {
    max-width: 900px;
  }

  .hero-panel {
    position: relative;
    min-height: 420px;
    border-radius: 36px;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 20%, rgba(125, 211, 252, 0.28), transparent 28%),
      radial-gradient(circle at 80% 70%, rgba(56, 189, 248, 0.18), transparent 32%),
      rgba(255, 255, 255, 0.045);
    border: 1px solid var(--card-border);
  }

  .panel-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    opacity: 0.18;
  }

  .panel-grid span {
    border: 1px solid rgba(255, 255, 255, 0.16);
  }

  .orbit {
    position: absolute;
    border: 1px solid rgba(125, 211, 252, 0.35);
    border-radius: 50%;
  }

  .orbit-one {
    width: 280px;
    height: 280px;
    right: -60px;
    top: 48px;
  }

  .orbit-two {
    width: 420px;
    height: 160px;
    left: -120px;
    bottom: 68px;
    transform: rotate(-18deg);
  }

  .panel-content {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
  }

  .panel-content p {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    margin: 0 0 12px;
  }

  .panel-content h2 {
    margin: 0;
    max-width: 420px;
    color: var(--text);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1;
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.95;
    margin: 20px 0;
    max-width: 1000px;
  }

  .subtitle {
    max-width: 680px;
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 16px;
    margin-top: 36px;
  }

  .button {
    padding: 14px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }

  .primary {
    background: var(--text);
    color: var(--bg);
  }

  .secondary {
    border: 1px solid var(--card-border);
    color: var(--text);
  }

  .featured {
    max-width: var(--max-width);
    margin: 120px auto 0;
  }

  .section-heading {
    margin-bottom: 32px;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 12px 0 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      margin-top: 100px;
    }

    .hero-panel {
      min-height: 300px;
    }
  }
</style>