---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Aerosect"
  description="The page you are looking for could not be found on Aerosect."
>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found.</h1>
    <p>
      The page you are looking for does not exist, may have moved, or is still being developed.
    </p>

    <a class="button" href="/articles">Return to Articles</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 760px;
    margin-top: 120px;
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1;
    margin: 18px 0 28px;
  }

  p {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .button {
    display: inline-block;
    margin-top: 28px;
    padding: 14px 20px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    font-weight: 700;
  }
</style>