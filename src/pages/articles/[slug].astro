---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const showDrafts = import.meta.env.DEV;
  const articles = await getCollection("articles", ({ data }) => showDrafts || !data.draft);

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const topics = article.data.topics;
const isLocalDraft = import.meta.env.DEV && article.data.draft;
---

<BaseLayout
  title={`${article.data.title} | Aerosect`}
  description={article.data.description}
  image={article.data.socialImage ?? article.data.image}
  imageAlt={article.data.title}
  ogType="article"
  author={article.data.author}
  publishedTime={article.data.date.toISOString()}
>
  <article class="article">
    <div
      class="article-band"
      aria-hidden="true"
      style="backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.72) 5%, #000 24%, #000 76%, rgba(0, 0, 0, 0.72) 95%, transparent 100%); -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.72) 5%, #000 24%, #000 76%, rgba(0, 0, 0, 0.72) 95%, transparent 100%);"
    ></div>
    <a class="back" href="/articles">← Back to articles</a>

    <div class="topic-list" aria-label="Article topics">
      {topics.map((topic) => (
        <a class="topic" href={`/topics/${topic.slug}`}>
          {topic.name}
        </a>
      ))}
    </div>
    {isLocalDraft && <p class="draft-label">Draft preview</p>}
    <h1>{article.data.title}</h1>
    <p class="description">{article.data.description}</p>
    <p class="date">
      {article.data.date.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
      })}
    </p>

    <div class="hero-image-frame">
      <Image
        class="hero-image"
        src={article.data.image}
        alt=""
        loading="eager"
        decoding="async"
        widths={[720, 960, 1280, 1600, 1920]}
        sizes="(max-width: 900px) calc(100vw - 48px), 860px"
      />
    </div>

    {article.data.imageCredit && (
      <p class="image-credit">
        Image: {article.data.imageCredit.url ? (
          <a href={article.data.imageCredit.url} target="_blank" rel="noopener noreferrer">
            {article.data.imageCredit.text}
          </a>
        ) : (
          article.data.imageCredit.text
        )}
      </p>
    )}

    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    position: relative;
    max-width: 920px;
    margin: 110px auto 0;
  }

  .article-band {
    position: absolute;
    z-index: 0;
    top: calc(-110px - 32px);
    bottom: -260px;
    left: 50%;
    width: 1120px;
    max-width: calc(100vw - 32px);
    transform: translateX(-50%);
    background: linear-gradient(
      90deg,
      rgba(5, 7, 13, 0) 0%,
      rgba(5, 7, 13, 0.14) 5%,
      rgba(5, 7, 13, 0.2) 24%,
      rgba(5, 7, 14, 0.205) 76%,
      rgba(5, 7, 13, 0.14) 95%,
      rgba(5, 7, 13, 0) 100%
    );
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    pointer-events: none;
  }

  .article > :not(.article-band) {
    position: relative;
    z-index: 1;
  }

  .back {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
  }

  .back:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .topic-list {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
  }

  .topic {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    text-decoration: none;
  }

  .topic:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .draft-label {
    display: inline-block;
    margin: 18px 0 0;
    padding: 6px 10px;
    border: 1px solid rgba(125, 211, 252, 0.35);
    border-radius: 4px;
    color: var(--accent);
    background: rgba(125, 211, 252, 0.08);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    line-height: 0.95;
    margin: 18px 0 24px;
  }

  .description {
    color: var(--text-muted);
    font-size: 1.25rem;
    line-height: 1.7;
    max-width: 760px;
  }

  .date {
    color: var(--text-soft);
    margin-top: 22px;
    font-size: 0.95rem;
  }

  .hero-image-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    margin-top: 48px;
    border: 1px solid var(--card-border);
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .image-credit {
    margin: 12px 0 0;
    color: var(--text-soft);
    font-size: 0.82rem;
    line-height: 1.5;
    text-align: right;
  }

  .image-credit a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .content {
    margin-top: 64px;
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.85;
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
  }

  .content :global(h2) {
    margin-top: 3.4rem;
    margin-bottom: 1rem;
    color: var(--text);
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.12;
  }

  .content :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 0.8rem;
    color: var(--text);
    font-size: 1.45rem;
    line-height: 1.25;
  }

  .content :global(a) {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.4rem;
    margin: 1.4rem 0;
  }

  .content :global(li) {
    margin-bottom: 0.7rem;
    color: var(--text-muted);
  }

  .content :global(strong) {
    color: var(--text);
  }

  .content :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.4rem;
    border-left: 3px solid var(--accent);
    color: var(--text-muted);
    font-style: italic;
  }

  .content :global(code) {
    padding: 0.18rem 0.38rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--accent);
    font-size: 0.95em;
  }

  .content :global(pre) {
    overflow-x: auto;
    padding: 1.2rem;
    border-radius: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--card-border);
  }

  .content :global(pre code) {
    padding: 0;
    background: transparent;
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .article {
      margin-top: 90px;
    }

    .article-band {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      background: linear-gradient(
        90deg,
        rgba(5, 7, 13, 0) 0%,
        rgba(5, 7, 13, 0.14) 8%,
        rgba(5, 7, 13, 0.22) 24%,
        rgba(5, 7, 13, 0.22) 76%,
        rgba(5, 7, 13, 0.14) 92%,
        rgba(5, 7, 13, 0) 100%
      );
    }

    .hero-image-frame {
      border-radius: 8px;
    }
  }
</style>
