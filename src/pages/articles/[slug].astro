---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout title={`${article.data.title} | Aerosect`}>
  <article class="article">
    <a class="back" href="/articles">← Back to articles</a>

    <p class="topic">{article.data.topic}</p>
    <h1>{article.data.title}</h1>
    <p class="description">{article.data.description}</p>
    <p class="date">
      {article.data.date.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
      })}
    </p>

    <img class="hero-image" src={article.data.image} alt="" />

    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 820px;
    margin: 100px auto 0;
  }

  .back {
    color: #7dd3fc;
    text-decoration: none;
  }

  .topic {
    margin-top: 48px;
    color: #7dd3fc;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    line-height: 1;
    margin: 18px 0;
  }

  .description {
    color: #cbd5e1;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .date {
    color: #94a3b8;
    margin-top: 20px;
  }

  .content {
    margin-top: 56px;
    color: #dbe4f0;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .content :global(p) {
    margin-bottom: 1.4rem;
  }

  .hero-image {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 28px;
  margin-top: 44px;
}
</style>