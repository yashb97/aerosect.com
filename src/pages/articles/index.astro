---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const showDrafts = import.meta.env.DEV;
const articles = await getCollection("articles", ({ data }) => showDrafts || !data.draft);

articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Articles | Aerosect"
  description="Browse Aerosect articles on aerospace, technology, history, ideas, visual explainers, and stories connected to flight and engineering."
>
  <section class="intro">
    <p class="eyebrow">Knowledge Archive</p>
    <h1>Articles</h1>
    <p>
      A growing archive of visual essays, explainers, and stories on aerospace,
      technology, history, ideas, travel, and the culture around flight.
    </p>
  </section>

 <section class="grid">
  {articles.map((article) => (
    <ArticleCard article={article} />
  ))}
</section>
</BaseLayout>

<style>
  .intro {
    width: 100%;
    max-width: none;
    margin: 110px 0 0;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--card-border);
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    line-height: 0.95;
    margin: 16px 0 24px;
  }

  .intro p {
    max-width: 760px;
    color: var(--text-muted);
    font-size: 1.18rem;
    line-height: 1.7;
  }

  .grid {
    width: 100%;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
    margin: 56px 0 0;
  }
</style>
