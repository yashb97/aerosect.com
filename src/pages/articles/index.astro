---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles", ({ data }) => !data.draft);

articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Articles | Aerosect">
  <section class="intro">
    <p class="eyebrow">Knowledge Archive</p>
    <h1>Articles</h1>
    <p>
      A growing archive of technical essays, explainers, and visual notes on
      aerospace engineering, aeroacoustics, aircraft noise, simulation, and engineering systems.
    </p>
  </section>

 <section class="grid">
  {articles.map((article) => (
    <a class="card" href={`/articles/${article.id}`}>
      <p class="topic">{article.data.topic}</p>
      <h2>{article.data.title}</h2>
      <p>{article.data.description}</p>
    </a>
  ))}
</section>
</BaseLayout>

<style>
  .intro {
    max-width: 760px;
    margin-top: 100px;
  }

  .eyebrow {
    color: #7dd3fc;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    margin: 16px 0;
  }

  .intro p {
    color: #cbd5e1;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    margin-top: 56px;
  }

  .card {
  display: block;
  padding: 28px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.055);
  border: 1px solid rgba(255, 255, 255, 0.12);
  text-decoration: none;
  color: inherit;
  transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}

.card:hover {
  transform: translateY(-4px);
  border-color: rgba(125, 211, 252, 0.45);
  background: rgba(255, 255, 255, 0.08);
}

  .topic {
    color: #7dd3fc;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .card h2 {
    margin-top: 16px;
  }

  .card p {
    color: #cbd5e1;
    line-height: 1.6;
  }
</style>